import React, { useState, useEffect } from 'react';
import { 
  ArrowRight, User, ShoppingBag, Phone, Accessibility, X, Type, Contrast, 
  Link as LinkIcon, Menu, ChevronDown, CheckCircle2,
  MapPin, Sparkles, Globe, ChevronUp, Trash2, Plus, Minus, Info, FileText, FileSignature
} from 'lucide-react';

// --- MOCK CART DATA ---
const initialCartItems = [
  { id: 1, sku: 'PF-001', category: 'Perfume', title: 'Amber Royale EDP', size: '50ml', wsp: 1250, qty: 2 },
  { id: 5, sku: 'LG-101', category: 'Leather Goods', title: 'Classic Grained Belt', size: 'Multiple Sizes', wsp: 900, qty: 1 },
];

export default function App() {
  // --- STATE MANAGEMENT ---
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [activeMegaMenu, setActiveMegaMenu] = useState(null);
  const [langMenuOpen, setLangMenuOpen] = useState(false);
  const [userMenuOpen, setUserMenuOpen] = useState(false);
  const [currentLang, setCurrentLang] = useState('EN');
  
  // Cart State
  const [cartItems, setCartItems] = useState(initialCartItems);
  const [poNumber, setPoNumber] = useState('');
  const [orderNotes, setOrderNotes] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [isSuccess, setIsSuccess] = useState(false);

  // Constants
  const MOQ_TARGET = 5000; // Minimum Order Quantity in CZK
  const VAT_RATE = 0.21; // 21% VAT

  // Derived State
  const subtotal = cartItems.reduce((acc, item) => acc + (item.wsp * item.qty), 0);
  const vatAmount = subtotal * VAT_RATE;
  const total = subtotal + vatAmount;
  const isMoqReached = subtotal >= MOQ_TARGET;
  const progressPercent = Math.min((subtotal / MOQ_TARGET) * 100, 100);

  // Language Flag Mapping
  const langFlags = {
    'EN': '🇬🇧',
    'CS': '🇨🇿',
    'VI': '🇻🇳'
  };

  // Scroll to Top State
  const [showScroll, setShowScroll] = useState(false);

  useEffect(() => {
    const checkScrollTop = () => {
      setShowScroll(window.scrollY > 500);
    };
    window.addEventListener('scroll', checkScrollTop);
    return () => window.removeEventListener('scroll', checkScrollTop);
  }, []);

  // Accessibility State
  const [a11yOpen, setA11yOpen] = useState(false);
  const [textSize, setTextSize] = useState('standard'); // 'small', 'standard', 'large'
  const [highContrast, setHighContrast] = useState(false);
  const [highlightLinks, setHighlightLinks] = useState(false);

  // --- DYNAMIC ACCESSIBILITY CLASSES ---
  const getBodyTextSize = () => {
    switch(textSize) {
      case 'small': return 'text-sm';
      case 'large': return 'text-lg md:text-xl';
      default: return 'text-base';
    }
  };

  const getHeadingSize = (baseClass, largeClass) => {
    return textSize === 'large' ? largeClass : baseClass;
  };

  const appClasses = `min-h-screen font-sans transition-all duration-300 ease-in-out flex flex-col ${highContrast ? 'bg-white text-black' : 'bg-[#FAFAF9] text-stone-900'}`;
  const linkClasses = highlightLinks ? 'underline decoration-2 underline-offset-4 font-bold' : '';
  const btnClasses = highContrast 
    ? 'bg-black text-white hover:bg-stone-800 border-2 border-black disabled:opacity-50' 
    : 'bg-stone-900 text-white hover:bg-amber-700 shadow-md transition-colors duration-300 disabled:opacity-50 disabled:bg-stone-300 disabled:shadow-none';
  const inputClasses = `w-full px-5 py-4 rounded-xl border transition-all focus:outline-none focus:ring-2 ${
    highContrast 
      ? 'bg-white border-black border-[3px] focus:ring-black text-black' 
      : 'bg-stone-50 border-stone-200 focus:border-amber-600 focus:ring-amber-600/20 focus:bg-white text-stone-900'
  }`;

  // --- CART ACTIONS ---
  const updateQty = (id, delta) => {
    setCartItems(prev => prev.map(item => {
      if (item.id === id) {
        const newQty = Math.max(1, item.qty + delta);
        return { ...item, qty: newQty };
      }
      return item;
    }));
  };

  const removeItem = (id) => {
    setCartItems(prev => prev.filter(item => item.id !== id));
  };

  const handleSubmitOrder = () => {
    if (!isMoqReached) return;
    setIsSubmitting(true);
    // Simulate API request
    setTimeout(() => {
      setIsSubmitting(false);
      setIsSuccess(true);
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setCartItems([]);
    }, 1500);
  };

  return (
    <div className={appClasses}>
      
      {/* --- ACCESSIBILITY PANEL --- */}
      <div className={`fixed inset-y-0 right-0 w-80 md:w-96 bg-stone-900 text-white z-[100] transform transition-transform duration-300 shadow-2xl ${a11yOpen ? 'translate-x-0' : 'translate-x-full'}`}>
        <div className="p-6 flex items-center justify-between border-b border-stone-800">
          <h2 className="text-xl font-bold flex items-center gap-2"><Accessibility className="w-6 h-6 text-amber-500" /> Accessibility</h2>
          <button onClick={() => setA11yOpen(false)} className="p-2 hover:bg-stone-800 rounded-md transition-colors"><X className="w-6 h-6" /></button>
        </div>
        <div className="p-6 space-y-8">
          <div>
            <h3 className="font-bold text-sm uppercase tracking-widest text-stone-300 mb-4 flex items-center gap-3"><Type className="w-5 h-5"/> Text Size</h3>
            <div className="flex flex-col gap-2 bg-stone-800 rounded-xl p-2 font-bold">
              <button onClick={() => setTextSize('small')} className={`w-full py-3 rounded-lg transition-colors ${textSize === 'small' ? 'bg-amber-600 text-white' : 'text-stone-400 hover:text-white'}`}>Small</button>
              <button onClick={() => setTextSize('standard')} className={`w-full py-3 rounded-lg transition-colors ${textSize === 'standard' ? 'bg-amber-600 text-white' : 'text-stone-400 hover:text-white'}`}>Standard</button>
              <button onClick={() => setTextSize('large')} className={`w-full py-3 rounded-lg transition-colors ${textSize === 'large' ? 'bg-amber-600 text-white' : 'text-stone-400 hover:text-white'}`}>Large</button>
            </div>
          </div>
          <div>
            <h3 className="font-bold text-sm uppercase tracking-widest text-stone-300 mb-4 flex items-center gap-3"><Contrast className="w-5 h-5"/> Contrast</h3>
            <label className="flex items-center justify-between cursor-pointer bg-stone-800 p-5 rounded-xl font-bold hover:bg-stone-700 transition-colors">
              <span>High Contrast (B/W)</span>
              <div className={`w-14 h-8 rounded-full relative transition-colors ${highContrast ? 'bg-amber-500' : 'bg-stone-600'}`}>
                <div className={`absolute top-1 left-1 w-6 h-6 rounded-full bg-white transition-transform ${highContrast ? 'translate-x-6' : ''}`}></div>
              </div>
              <input type="checkbox" className="hidden" checked={highContrast} onChange={() => setHighContrast(!highContrast)}/>
            </label>
          </div>
          <div>
            <h3 className="font-bold text-sm uppercase tracking-widest text-stone-300 mb-4 flex items-center gap-3"><LinkIcon className="w-5 h-5"/> Navigation</h3>
            <label className="flex items-center justify-between cursor-pointer bg-stone-800 p-5 rounded-xl font-bold hover:bg-stone-700 transition-colors">
              <span>Highlight Links</span>
              <div className={`w-14 h-8 rounded-full relative transition-colors ${highlightLinks ? 'bg-amber-500' : 'bg-stone-600'}`}>
                <div className={`absolute top-1 left-1 w-6 h-6 rounded-full bg-white transition-transform ${highlightLinks ? 'translate-x-6' : ''}`}></div>
              </div>
              <input type="checkbox" className="hidden" checked={highlightLinks} onChange={() => setHighlightLinks(!highlightLinks)}/>
            </label>
          </div>
        </div>
      </div>
      {a11yOpen && <div className="fixed inset-0 bg-black/60 z-[90] backdrop-blur-sm transition-opacity" onClick={() => setA11yOpen(false)}></div>}

      {/* --- TOP B2B NOTIFICATION (LOGGED IN) --- */}
      <div className={`py-2.5 px-6 flex justify-between items-center text-xs font-bold uppercase tracking-widest ${highContrast ? 'bg-black text-white border-b-2 border-white' : 'bg-amber-900 text-amber-50'}`}>
        <span>Partner: Luxury Retail s.r.o.</span>
        <span className="hidden sm:inline">Discount Tier: Gold (15%)</span>
      </div>

      {/* --- HEADER --- */}
      <header className={`sticky top-0 z-50 transition-colors ${highContrast ? 'bg-white border-black border-b-4' : 'bg-white border-b border-stone-200 shadow-sm'}`}>
        <div className="max-w-7xl mx-auto px-4 sm:px-6 h-20 sm:h-24 flex items-center justify-between">
          <div className="flex items-center gap-4 lg:gap-12">
            <button className="lg:hidden p-2" onClick={() => setMobileMenuOpen(true)}><Menu className="w-8 h-8" /></button>
            <h1 className="font-serif text-2xl sm:text-3xl font-bold cursor-pointer">Leather Parfum</h1>
            
            <nav className="hidden lg:flex items-center gap-8 font-bold h-24 text-sm uppercase tracking-wider">
              <div className="relative h-full flex items-center cursor-pointer group" onMouseEnter={() => setActiveMegaMenu('catalog')} onMouseLeave={() => setActiveMegaMenu(null)}>
                <button className={`flex items-center gap-1 hover:text-amber-700 transition-colors ${linkClasses}`}>
                  Order Portal <ChevronDown className="w-5 h-5"/>
                </button>
                {activeMegaMenu === 'catalog' && (
                  <div className={`absolute top-24 left-0 w-[700px] rounded-b-2xl p-10 grid grid-cols-2 gap-12 shadow-2xl cursor-default ${highContrast ? 'bg-white border-4 border-t-0 border-black' : 'bg-white border border-t-0 border-stone-200'}`}>
                    <div>
                      <h3 className="font-bold text-sm uppercase tracking-widest mb-6 pb-3 border-b border-stone-200 text-stone-900">Perfumes</h3>
                      <ul className="space-y-4 text-base normal-case tracking-normal font-medium text-stone-600">
                        <li><a href="#" className={`hover:text-amber-700 ${linkClasses}`}>All Fragrances</a></li>
                        <li><a href="#" className={`hover:text-amber-700 ${linkClasses}`}>Women's Collection</a></li>
                        <li><a href="#" className={`hover:text-amber-700 ${linkClasses}`}>Men's Collection</a></li>
                      </ul>
                    </div>
                    <div>
                      <h3 className="font-bold text-sm uppercase tracking-widest mb-6 pb-3 border-b border-stone-200 text-stone-900">Leather Goods</h3>
                      <ul className="space-y-4 text-base normal-case tracking-normal font-medium text-stone-600">
                        <li><a href="#" className={`hover:text-amber-700 ${linkClasses}`}>All Leather Goods</a></li>
                        <li><a href="#" className={`hover:text-amber-700 ${linkClasses}`}>Premium Belts</a></li>
                      </ul>
                    </div>
                  </div>
                )}
              </div>
              <a href="#" className={`hover:text-amber-700 transition-colors ${linkClasses}`}>Quick Reorder</a>
              <a href="#" className={`hover:text-amber-700 transition-colors ${linkClasses}`}>Invoices</a>
            </nav>
          </div>

          <div className="flex items-center gap-4 sm:gap-6">
            <div className="relative hidden md:block" onMouseEnter={() => setLangMenuOpen(true)} onMouseLeave={() => setLangMenuOpen(false)}>
              <button className={`flex items-center gap-1.5 font-bold text-sm uppercase tracking-wider p-2 hover:text-amber-700 transition-colors ${linkClasses}`}>
                <span className="text-lg leading-none">{langFlags[currentLang]}</span> {currentLang} <ChevronDown className="w-4 h-4"/>
              </button>
            </div>
            <button onClick={() => setA11yOpen(true)} className={`p-2 sm:px-4 sm:py-2 rounded-xl flex items-center gap-2 font-bold ${highContrast ? 'border-2 border-black hover:bg-gray-100' : 'bg-stone-100 hover:bg-stone-200 transition-colors'}`}>
              <Accessibility className="w-6 h-6 sm:w-5 sm:h-5" />
            </button>
            <div className={`w-px h-8 hidden md:block ${highContrast ? 'bg-black' : 'bg-stone-300'}`}></div>
            <button className={`hidden sm:flex items-center gap-2 font-bold hover:text-amber-700 transition-colors text-sm uppercase tracking-wider ${linkClasses}`}>
              <User className="w-5 h-5" /> <span className="hidden xl:inline">My Account</span>
            </button>
            <button className={`relative p-2 font-bold text-amber-700 transition-colors border-b-2 ${highContrast ? 'border-black' : 'border-amber-700'} pb-1 ${linkClasses}`}>
              <ShoppingBag className="w-7 h-7 sm:w-6 sm:h-6" />
              {cartItems.length > 0 && (
                <span className={`absolute -top-1 -right-1 w-5 h-5 flex items-center justify-center text-xs font-bold rounded-full ${highContrast ? 'bg-black text-white' : 'bg-amber-600 text-white'}`}>
                  {cartItems.reduce((acc, item) => acc + item.qty, 0)}
                </span>
              )}
            </button>
          </div>
        </div>
      </header>

      {/* --- CART MAIN CONTENT --- */}
      <main className="flex-grow w-full">
        
        {isSuccess ? (
          /* SUCCESS STATE */
          <div className="max-w-7xl mx-auto py-16 md:py-32 px-4 sm:px-6 flex justify-center">
            <div className={`max-w-2xl w-full p-10 md:p-16 rounded-3xl text-center ${highContrast ? 'border-4 border-black bg-white' : 'bg-white border border-stone-200 shadow-xl'}`}>
              <div className={`w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-8 ${highContrast ? 'border-4 border-black' : 'bg-green-50 text-green-600'}`}>
                <CheckCircle2 className="w-12 h-12" />
              </div>
              <h1 className={`font-serif ${getHeadingSize('text-4xl', 'text-5xl')} font-bold mb-6`}>Order Submitted!</h1>
              <p className={`${getBodyTextSize()} mb-4 font-bold uppercase tracking-widest text-stone-500`}>Reference: PO-{poNumber || '102938'}</p>
              <p className={`${getBodyTextSize()} mb-10 ${highContrast ? 'font-medium' : 'text-stone-600'}`}>
                Thank you. Your wholesale order has been sent to our team. We will review availability and send a proforma invoice to your registered email shortly.
              </p>
              <button onClick={() => {setIsSuccess(false); setCartItems(initialCartItems);}} className={`px-10 py-5 text-lg font-bold rounded-xl ${btnClasses}`}>
                Return to Catalog
              </button>
            </div>
          </div>
        ) : (
          /* CART STATE */
          <div className="max-w-7xl mx-auto py-12 md:py-16 px-4 sm:px-6">
            
            <div className="mb-12 border-b border-stone-200 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
              <div>
                <h1 className={`font-serif ${getHeadingSize('text-4xl md:text-5xl', 'text-5xl md:text-6xl')} font-bold mb-4`}>
                  Your Order
                </h1>
                <p className={`${getBodyTextSize()} ${highContrast ? 'font-medium text-black' : 'text-stone-600'}`}>
                  Review your items and provide internal purchase details before submitting.
                </p>
              </div>
              <button className={`font-bold uppercase tracking-widest text-sm hover:text-amber-700 transition-colors ${linkClasses}`}>
                Continue Shopping
              </button>
            </div>

            {cartItems.length === 0 ? (
              <div className={`p-16 rounded-3xl text-center ${highContrast ? 'border-4 border-black bg-white' : 'bg-stone-50 border border-stone-200'}`}>
                <ShoppingBag className="w-16 h-16 mx-auto mb-6 text-stone-300" />
                <h2 className={`font-serif ${getHeadingSize('text-3xl', 'text-4xl')} font-bold mb-4`}>Your cart is empty</h2>
                <p className={`${getBodyTextSize()} text-stone-500 mb-8`}>Add items from the wholesale catalog to create an order.</p>
                <button className={`px-10 py-5 text-lg font-bold rounded-xl ${btnClasses}`}>
                  Go to Catalog
                </button>
              </div>
            ) : (
              <div className="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
                
                {/* LEFT COLUMN: Items & Details */}
                <div className="w-full lg:w-7/12 xl:w-2/3">
                  
                  {/* Cart Items List */}
                  <div className={`rounded-3xl mb-10 overflow-hidden ${highContrast ? 'border-4 border-black bg-white' : 'bg-white border border-stone-200 shadow-sm'}`}>
                    <div className="p-6 border-b border-stone-200 hidden sm:grid grid-cols-12 gap-4">
                      <div className="col-span-6 font-bold uppercase tracking-widest text-xs text-stone-500">Product</div>
                      <div className="col-span-3 font-bold uppercase tracking-widest text-xs text-stone-500 text-center">Quantity</div>
                      <div className="col-span-3 font-bold uppercase tracking-widest text-xs text-stone-500 text-right">Total (WSP)</div>
                    </div>
                    
                    <div className="divide-y divide-stone-200">
                      {cartItems.map((item) => (
                        <div key={item.id} className="p-6 sm:grid sm:grid-cols-12 sm:gap-4 items-center flex flex-col gap-6">
                          
                          {/* Product Info */}
                          <div className="sm:col-span-6 w-full flex items-center gap-4">
                            <div className={`w-20 h-20 rounded-xl shrink-0 flex items-center justify-center ${highContrast ? 'border-2 border-black' : 'bg-stone-50 border border-stone-200'}`}>
                               <span className="font-bold text-stone-300">IMG</span>
                            </div>
                            <div>
                              <p className={`text-xs font-bold uppercase tracking-widest mb-1 ${highContrast ? 'text-black' : 'text-stone-500'}`}>{item.sku}</p>
                              <h3 className={`font-serif ${getHeadingSize('text-lg', 'text-xl')} font-bold mb-1`}>{item.title}</h3>
                              <p className="text-sm font-medium text-stone-500">{item.size} • {item.wsp.toLocaleString()} CZK/ea</p>
                            </div>
                          </div>
                          
                          {/* Quantity Controls */}
                          <div className="sm:col-span-3 w-full flex sm:justify-center items-center gap-4">
                            <div className={`flex items-center p-1 rounded-xl ${highContrast ? 'border-2 border-black' : 'bg-stone-50 border border-stone-200'}`}>
                              <button onClick={() => updateQty(item.id, -1)} className="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-stone-200 transition-colors">
                                <Minus className="w-4 h-4" />
                              </button>
                              <span className="w-12 text-center font-bold text-lg">{item.qty}</span>
                              <button onClick={() => updateQty(item.id, 1)} className="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-stone-200 transition-colors">
                                <Plus className="w-4 h-4" />
                              </button>
                            </div>
                          </div>
                          
                          {/* Price & Delete */}
                          <div className="sm:col-span-3 w-full flex justify-between sm:justify-end items-center gap-4">
                            <div className="sm:hidden font-bold uppercase tracking-widest text-xs text-stone-500">Subtotal:</div>
                            <div className={`font-bold ${getHeadingSize('text-xl', 'text-2xl')}`}>
                              {(item.wsp * item.qty).toLocaleString()} CZK
                            </div>
                            <button onClick={() => removeItem(item.id)} className={`p-2 rounded-lg transition-colors ${highContrast ? 'text-black hover:bg-stone-200 border-2 border-black' : 'text-stone-400 hover:text-red-600 hover:bg-red-50'}`} aria-label="Remove item">
                              <Trash2 className="w-5 h-5" />
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Order Details (B2B specific) */}
                  <div className={`p-8 md:p-10 rounded-3xl ${highContrast ? 'border-4 border-black bg-white' : 'bg-stone-50 border border-stone-200'}`}>
                    <h3 className={`font-serif ${getHeadingSize('text-2xl', 'text-3xl')} font-bold mb-8 border-b border-stone-200 pb-4`}>
                      Order Details
                    </h3>
                    
                    <div className="space-y-6">
                      <div>
                        <label className={`block font-bold mb-3 ${getBodyTextSize()} ${highContrast ? 'text-black' : 'text-stone-700'}`}>
                          PO Number (Optional)
                        </label>
                        <div className="relative">
                          <div className="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <FileText className="h-5 w-5 text-stone-400" />
                          </div>
                          <input 
                            type="text" 
                            value={poNumber}
                            onChange={(e) => setPoNumber(e.target.value)}
                            placeholder="Enter your internal Purchase Order number" 
                            className={`${inputClasses} pl-14 ${getBodyTextSize()}`}
                          />
                        </div>
                        <p className="text-sm font-medium mt-2 text-stone-500">This reference will appear on your invoice.</p>
                      </div>

                      <div>
                        <label className={`block font-bold mb-3 ${getBodyTextSize()} ${highContrast ? 'text-black' : 'text-stone-700'}`}>
                          Order Notes / Special Instructions
                        </label>
                        <div className="relative">
                          <div className="absolute top-5 left-5 pointer-events-none">
                            <FileSignature className="h-5 w-5 text-stone-400" />
                          </div>
                          <textarea 
                            value={orderNotes}
                            onChange={(e) => setOrderNotes(e.target.value)}
                            rows="3"
                            placeholder="Delivery instructions, requests, etc." 
                            className={`${inputClasses} pl-14 pt-4 resize-none ${getBodyTextSize()}`}
                          />
                        </div>
                      </div>
                    </div>
                  </div>

                </div>

                {/* RIGHT COLUMN: Summary & Action */}
                <div className="w-full lg:w-5/12 xl:w-1/3 lg:sticky lg:top-36">
                  
                  <div className={`p-8 md:p-10 rounded-3xl flex flex-col ${highContrast ? 'border-4 border-black bg-white' : 'bg-white border border-stone-200 shadow-xl'}`}>
                    <h3 className={`font-serif ${getHeadingSize('text-2xl', 'text-3xl')} font-bold mb-6`}>Summary</h3>
                    
                    {/* MOQ Tracker Widget */}
                    <div className={`mb-8 p-6 rounded-2xl ${highContrast ? 'border-4 border-black' : 'bg-stone-50 border border-stone-200'}`}>
                      <div className="flex justify-between text-xs font-bold uppercase tracking-widest mb-4">
                        <span className={isMoqReached ? (highContrast ? '' : 'text-green-600') : ''}>
                          {isMoqReached ? "MOQ Reached" : "MOQ Target"}
                        </span>
                        <span>{MOQ_TARGET.toLocaleString()} CZK</span>
                      </div>
                      <div className={`h-3 w-full rounded-full overflow-hidden ${highContrast ? 'border-2 border-black bg-white' : 'bg-stone-200'}`}>
                        <div 
                          className={`h-full transition-all duration-500 ${highContrast ? 'bg-black' : (isMoqReached ? 'bg-green-500' : 'bg-amber-500')}`} 
                          style={{ width: `${progressPercent}%` }}
                        ></div>
                      </div>
                      {!isMoqReached && (
                        <p className="text-sm font-bold mt-4 flex items-start gap-2 text-amber-700">
                          <Info className="w-5 h-5 shrink-0" />
                          <span>Add {(MOQ_TARGET - subtotal).toLocaleString()} CZK more to proceed with this order.</span>
                        </p>
                      )}
                    </div>

                    {/* Cost Breakdown */}
                    <div className={`space-y-4 mb-8 pb-8 border-b ${getBodyTextSize()} ${highContrast ? 'border-black font-bold' : 'border-stone-200 text-stone-600 font-medium'}`}>
                      <div className="flex justify-between items-center">
                        <span>Subtotal (WSP)</span>
                        <span className={highContrast ? 'text-black' : 'text-stone-900'}>{subtotal.toLocaleString()} CZK</span>
                      </div>
                      <div className="flex justify-between items-center">
                        <span>Estimated VAT (21%)</span>
                        <span className={highContrast ? 'text-black' : 'text-stone-900'}>{vatAmount.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} CZK</span>
                      </div>
                      <div className="flex justify-between items-center">
                        <span>Shipping</span>
                        <span className="uppercase tracking-widest text-xs font-bold">Calculated Later</span>
                      </div>
                    </div>

                    <div className="flex justify-between items-end mb-8">
                      <span className={`font-bold ${getHeadingSize('text-lg', 'text-xl')}`}>Total</span>
                      <span className={`font-serif ${getHeadingSize('text-3xl', 'text-4xl')} font-bold`}>
                        {total.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} CZK
                      </span>
                    </div>

                    <button 
                      onClick={handleSubmitOrder}
                      disabled={!isMoqReached || isSubmitting}
                      className={`w-full py-5 rounded-xl font-bold flex items-center justify-center gap-3 transition-all ${getHeadingSize('text-lg', 'text-xl')} ${btnClasses}`}
                    >
                      {isSubmitting ? (
                        <div className="flex items-center gap-3">
                          <div className="w-5 h-5 border-2 border-current border-t-transparent rounded-full animate-spin"></div>
                          Processing...
                        </div>
                      ) : (
                        <>Submit for Invoicing <ArrowRight className="w-6 h-6" /></>
                      )}
                    </button>
                    
                    <p className="text-center text-sm font-medium mt-4 text-stone-500">
                      No payment required now. You will receive an invoice after order confirmation.
                    </p>

                  </div>
                </div>

              </div>
            )}
          </div>
        )}
      </main>

      {/* --- SCROLL TO TOP BUTTON --- */}
      {showScroll && (
        <button 
          onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}
          className={`fixed bottom-8 right-8 z-[80] p-4 rounded-full shadow-2xl transition-all hover:-translate-y-1 focus:outline-none ${highContrast ? 'bg-black text-white border-2 border-white' : 'bg-stone-900 text-white hover:bg-amber-700'}`}
          aria-label="Scroll to top"
        >
          <ChevronUp className="w-6 h-6" />
        </button>
      )}

      {/* --- FOOTER --- */}
      <footer className={`${highContrast ? 'bg-white border-t-4 border-black text-black' : 'bg-stone-900 text-stone-300'} py-16 md:py-24 mt-auto`}>
        <div className="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-16">
          <div className="lg:col-span-1">
            <h4 className="font-serif text-3xl font-bold mb-6 text-white">Leather Parfum</h4>
            <p className={`${getBodyTextSize()} font-medium opacity-80 mb-8`}>
              Your premium wholesale partner. Exclusive terms for retail businesses.
            </p>
          </div>
          <div>
            <h4 className="text-sm font-bold mb-8 uppercase tracking-widest text-stone-500">Navigation</h4>
            <ul className={`space-y-5 font-bold ${getBodyTextSize()}`}>
              <li><a href="#" className={`text-amber-500 transition-colors ${linkClasses}`}>Order Portal</a></li>
              <li><a href="#" className={`hover:text-amber-500 transition-colors ${linkClasses}`}>Quick Reorder</a></li>
              <li><a href="#" className={`hover:text-amber-500 transition-colors ${linkClasses}`}>Invoices & Documents</a></li>
            </ul>
          </div>
          <div>
            <h4 className="text-sm font-bold mb-8 uppercase tracking-widest text-stone-500">Contact Manager</h4>
            <ul className={`space-y-5 font-bold ${getBodyTextSize()}`}>
              <li className="flex items-center gap-3"><User className="w-5 h-5 opacity-50"/> Anna Dvořáková</li>
              <li className="flex items-center gap-3"><Phone className="w-5 h-5 opacity-50"/> +420 123 456 789</li>
              <li className="flex items-center gap-3">anna@leatherparfum.com</li>
            </ul>
          </div>
          <div>
            <h4 className="text-sm font-bold mb-8 uppercase tracking-widest text-stone-500">Legal</h4>
            <ul className={`space-y-5 font-bold ${getBodyTextSize()}`}>
              <li><a href="#" className={`hover:text-amber-500 transition-colors ${linkClasses}`}>B2B Terms of Service</a></li>
              <li><a href="#" className={`hover:text-amber-500 transition-colors ${linkClasses}`}>Returns & Claims</a></li>
            </ul>
          </div>
        </div>
        <div className={`max-w-7xl mx-auto px-6 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm font-bold uppercase tracking-wider ${highContrast ? 'border-t-2 border-black' : 'border-t border-stone-800'}`}>
          <p className="opacity-60">&copy; 2026 Leather Parfum Wholesale. All rights reserved.</p>
          <div className="flex gap-6 opacity-60">
            <span>Made in Europe</span>
          </div>
        </div>
      </footer>

    </div>
  );
}