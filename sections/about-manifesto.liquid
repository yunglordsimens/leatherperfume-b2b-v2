{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' manifesto--high-contrast'
  endif
  assign img_right = false
  if section.settings.image_side == 'right'
    assign img_right = true
  endif
-%}

<style>
  /* ================================================
     About Manifesto — inline section styles
     ================================================ */

  .manifesto {
    padding: 6rem 1rem;
  }

  @media screen and (min-width: 750px) {
    .manifesto { padding: 8rem 1.5rem; }
  }

  .manifesto__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
  }

  /* ── Two-column layout ──────────────────────────── */

  .manifesto__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .manifesto__layout {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
    }

    /* Image on the right: reverse column order */
    .manifesto__layout--img-right {
      grid-template-columns: 7fr 5fr;
    }
  }

  /* ── Image column ───────────────────────────────── */

  .manifesto__image-col {
    /* Always first on mobile */
    order: -1;
  }

  @media screen and (min-width: 990px) {
    /* Left (default): image in natural column 1 */
    .manifesto__image-col { order: 0; }
    /* Right: push image to column 2 */
    .manifesto__layout--img-right .manifesto__image-col { order: 1; }
  }

  .manifesto__image-frame {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d6d3d1;
  }

  .manifesto__image-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .manifesto__image-frame svg {
    width: 5rem;
    height: 5rem;
  }

  .manifesto--high-contrast .manifesto__image-frame,
  html.a11y-high-contrast .manifesto__image-frame {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
  }

  /* ── Text column ────────────────────────────────── */

  .manifesto__text-col { order: 0; }

  /* Badge */
  .manifesto__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: #fef3c7;
    color: #92400e;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-radius: 0.375rem;
    margin-bottom: 2rem;
  }

  .manifesto__badge svg { width: 1rem; height: 1rem; }

  .manifesto--high-contrast .manifesto__badge,
  html.a11y-high-contrast .manifesto__badge {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  /* Heading */
  .manifesto__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1.1;
    color: #1c1917;
    margin: 0 0 2rem;
  }

  @media screen and (min-width: 750px) {
    .manifesto__heading { font-size: clamp(3rem, 7vw, 4rem); }
  }

  html.a11y-high-contrast .manifesto__heading { color: #000000 !important; }

  /* Body paragraphs */
  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .manifesto__body p {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #57534e;
    margin: 0;
  }

  .manifesto--high-contrast .manifesto__body p,
  html.a11y-high-contrast .manifesto__body p {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  /* Stats */
  .manifesto__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    border-top: 1px solid #e7e5e4;
    padding-top: 2rem;
  }

  .manifesto--high-contrast .manifesto__stats,
  html.a11y-high-contrast .manifesto__stats {
    border-top: 2px solid #000000 !important;
  }

  .manifesto__stat-number {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.5rem, 5vw, 3rem);
    line-height: 1;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }

  html.a11y-high-contrast .manifesto__stat-number { color: #000000 !important; }

  .manifesto__stat-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #78716c;
    margin: 0;
  }

  .manifesto--high-contrast .manifesto__stat-label,
  html.a11y-high-contrast .manifesto__stat-label { color: #000000 !important; }
</style>

<section
  class="manifesto{{ section_mod }}"
  id="AboutManifesto-{{ section.id }}"
>
  <div class="manifesto__container">
    <div class="manifesto__layout{% if img_right %} manifesto__layout--img-right{% endif %}">

      {%- comment -%} ── Image column ── {%- endcomment -%}
      <div class="manifesto__image-col">
        <div class="manifesto__image-frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '500, 750, 1000, 1200',
                sizes: '(min-width: 990px) 40vw, 100vw',
                alt: section.settings.image.alt
            }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ── Text column ── {%- endcomment -%}
      <div class="manifesto__text-col">

        <div class="manifesto__badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          B2B Manifesto
        </div>

        {%- if section.settings.heading != blank -%}
          <h2 class="manifesto__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <div class="manifesto__body">
          {%- if section.settings.paragraph_1 != blank -%}
            <p>{{ section.settings.paragraph_1 | escape }}</p>
          {%- endif -%}
          {%- if section.settings.paragraph_2 != blank -%}
            <p>{{ section.settings.paragraph_2 | escape }}</p>
          {%- endif -%}
        </div>

        <div class="manifesto__stats">
          <div>
            <p class="manifesto__stat-number">{{ section.settings.stat_1_number | default: '150%' | escape }}</p>
            <p class="manifesto__stat-label">{{ section.settings.stat_1_label | default: 'Avg. Retail Markup' | escape }}</p>
          </div>
          <div>
            <p class="manifesto__stat-number">{{ section.settings.stat_2_number | default: '200+' | escape }}</p>
            <p class="manifesto__stat-label">{{ section.settings.stat_2_label | default: 'Active Partners' | escape }}</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Manifesto",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "default": false
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait image",
      "info": "Recommended aspect ratio: 3:4."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for your retail shelves."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "At Leather Parfum, we understand that our success is entirely dependent on yours. That is why we don't just sell products; we provide complete retail solutions."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "From highly attractive wholesale margins to meticulously designed packaging that practically sells itself, every aspect of our B2B offering is optimized to increase your store's average order value and customer retention."
    },
    {
      "type": "header",
      "content": "Statistic 1"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Number",
      "default": "150%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Label",
      "default": "Avg. Retail Markup"
    },
    {
      "type": "header",
      "content": "Statistic 2"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Number",
      "default": "200+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "Active Partners"
    }
  ],
  "presets": [
    {
      "name": "About Manifesto"
    }
  ]
}
{% endschema %}
