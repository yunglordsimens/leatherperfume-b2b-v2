{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' app-form--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Application Form — inline section styles
     ================================================ */

  .app-form {
    padding: 3rem 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .app-form { padding: 4rem 1.5rem; }
  }

  /* ── Card wrapper ───────────────────────────────── */

  .app-form__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  @media screen and (min-width: 600px) { .app-form__card { padding: 2.5rem; } }
  @media screen and (min-width: 990px) { .app-form__card { padding: 3rem; } }

  .app-form--high-contrast .app-form__card,
  html.a11y-high-contrast .app-form__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── Section headings ───────────────────────────── */

  .app-form__section-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    line-height: 1.2;
    color: #1c1917;
    margin: 0 0 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e7e5e4;
  }

  .app-form__section-heading + .app-form__field-row,
  .app-form__section-heading + .app-form__fields {
    margin-top: 0;
  }

  html.a11y-high-contrast .app-form__section-heading { color: #000000 !important; }

  .app-form__section-heading--company {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid #e7e5e4;
  }

  html.a11y-high-contrast .app-form__section-heading--company {
    border-top-color: #000000 !important;
  }

  /* ── Field grid ─────────────────────────────────── */

  .app-form__fields {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .app-form__field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @media screen and (min-width: 600px) {
    .app-form__field-row { grid-template-columns: 1fr 1fr; }
  }

  /* ── Single field ───────────────────────────────── */

  .app-form__field { display: flex; flex-direction: column; }

  .app-form__label {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #44403c;
    margin-bottom: 0.625rem;
  }

  .app-form--high-contrast .app-form__label,
  html.a11y-high-contrast .app-form__label { color: #000000 !important; }

  .app-form__required { color: #dc2626; margin-left: 0.25rem; }
  html.a11y-high-contrast .app-form__required { color: #000000 !important; }

  /* Input wrapper for icon inputs */
  .app-form__input-wrap { position: relative; }

  .app-form__input-icon {
    position: absolute;
    top: 0; bottom: 0; left: 1.125rem;
    display: flex;
    align-items: center;
    pointer-events: none;
    color: #a8a29e;
  }

  .app-form__input-icon svg { width: 1.125rem; height: 1.125rem; }

  /* Base input / select / textarea */
  .app-form__input,
  .app-form__select {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 500;
    color: #1c1917;
    background-color: #ffffff;
    border: 1.5px solid #d6d3d1;
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .app-form__input:focus,
  .app-form__select:focus {
    border-color: #b45309;
    box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.15);
  }

  .app-form__input--icon { padding-left: 3rem; }

  /* Error state */
  .app-form__input.is-error,
  .app-form__select.is-error {
    border-color: #dc2626 !important;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12) !important;
  }

  .app-form--high-contrast .app-form__input,
  .app-form--high-contrast .app-form__select,
  html.a11y-high-contrast .app-form__input,
  html.a11y-high-contrast .app-form__select {
    border: 2px solid #000000 !important;
  }

  /* Select chevron */
  .app-form__select-wrap { position: relative; }

  .app-form__select-chevron {
    position: absolute;
    top: 0; bottom: 0; right: 1.125rem;
    display: flex;
    align-items: center;
    pointer-events: none;
    color: #78716c;
  }

  .app-form__select-chevron svg { width: 1.125rem; height: 1.125rem; }

  .app-form__select { padding-right: 3rem; cursor: pointer; }

  /* Error message below field */
  .app-form__error-msg {
    display: none;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #dc2626;
    margin-top: 0.5rem;
  }

  .app-form__error-msg.is-visible { display: block; }

  html.a11y-high-contrast .app-form__error-msg { color: #000000 !important; }

  /* ── Submit row ─────────────────────────────────── */

  .app-form__submit-row {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid #e7e5e4;
  }

  html.a11y-high-contrast .app-form__submit-row { border-top-color: #000000 !important; }

  .app-form__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 1.125rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .app-form__submit:hover {
    background-color: #b45309;
    border-color: #b45309;
  }

  .app-form__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .app-form__submit svg { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }

  .app-form--high-contrast .app-form__submit,
  html.a11y-high-contrast .app-form__submit {
    background-color: #000000 !important;
    border-color: #000000 !important;
    color: #ffffff !important;
  }

  .app-form__submit-spinner {
    display: none;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: appFormSpin 0.7s linear infinite;
    flex-shrink: 0;
  }

  @keyframes appFormSpin { to { transform: rotate(360deg); } }

  .app-form__submit.is-loading .app-form__submit-spinner { display: block; }
  .app-form__submit.is-loading .app-form__submit-text,
  .app-form__submit.is-loading .app-form__submit-arrow { display: none; }

  .app-form__legal {
    text-align: center;
    margin-top: 1.5rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #78716c;
    opacity: 0.8;
  }

  .app-form__legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Success state ──────────────────────────────── */

  .app-form__success {
    display: none;
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .app-form__success.is-visible { display: block; }

  .app-form__success-icon-wrap {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    background-color: #f0fdf4;
    color: #16a34a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
  }

  .app-form__success-icon-wrap svg { width: 3rem; height: 3rem; }

  .app-form--high-contrast .app-form__success-icon-wrap,
  html.a11y-high-contrast .app-form__success-icon-wrap {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
  }

  .app-form__success-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.15;
    color: #1c1917;
    margin: 0 0 1.25rem;
  }

  html.a11y-high-contrast .app-form__success-heading { color: #000000 !important; }

  .app-form__success-text {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #57534e;
    max-width: 36rem;
    margin: 0 auto 2.5rem;
  }

  html.a11y-high-contrast .app-form__success-text { color: #000000 !important; }

  .app-form__success-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 2rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1c1917;
    background-color: #f5f5f4;
    border: 2px solid #e7e5e4;
    border-radius: 0.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .app-form__success-btn:hover { background-color: #e7e5e4; }

  html.a11y-high-contrast .app-form__success-btn {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }
</style>

<div
  class="app-form{{ section_mod }}"
  id="ApplicationForm-{{ section.id }}"
>

  {%- comment -%} ── Success state (shown by JS) ── {%- endcomment -%}
  <div class="app-form__success" id="AppFormSuccess-{{ section.id }}" role="status" aria-live="polite">
    <div class="app-form__success-icon-wrap" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    </div>
    <h1 class="app-form__success-heading">Application Submitted!</h1>
    <p class="app-form__success-text">
      Thank you for your interest in partnering with Leather Parfum. Our team is currently reviewing your details. You will receive an email within 1 business day with your portal access and wholesale terms.
    </p>
    <button type="button" class="app-form__success-btn" id="AppFormReset-{{ section.id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:1rem;height:1rem">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      Return to Home
    </button>
  </div>

  {%- comment -%} ── Form card ── {%- endcomment -%}
  <div class="app-form__card" id="AppFormCard-{{ section.id }}">

    <h2 class="app-form__section-heading">
      {{ section.settings.section_1_heading | default: 'Representative Details' | escape }}
    </h2>

    <form id="AppFormEl-{{ section.id }}" novalidate>

      {%- comment -%} First + Last Name {%- endcomment -%}
      <div class="app-form__field-row">
        <div class="app-form__field">
          <label class="app-form__label" for="AppFirstName-{{ section.id }}">
            First Name<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <input
            class="app-form__input"
            type="text"
            id="AppFirstName-{{ section.id }}"
            name="first_name"
            autocomplete="given-name"
            placeholder="John"
            required
          >
          <span class="app-form__error-msg" id="ErrFirstName-{{ section.id }}">Please enter your first name.</span>
        </div>
        <div class="app-form__field">
          <label class="app-form__label" for="AppLastName-{{ section.id }}">
            Last Name<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <input
            class="app-form__input"
            type="text"
            id="AppLastName-{{ section.id }}"
            name="last_name"
            autocomplete="family-name"
            placeholder="Doe"
            required
          >
          <span class="app-form__error-msg" id="ErrLastName-{{ section.id }}">Please enter your last name.</span>
        </div>
      </div>

      {%- comment -%} Email + Phone {%- endcomment -%}
      <div class="app-form__field-row">
        <div class="app-form__field">
          <label class="app-form__label" for="AppEmail-{{ section.id }}">
            Email Address<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <div class="app-form__input-wrap">
            <span class="app-form__input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </span>
            <input
              class="app-form__input app-form__input--icon"
              type="email"
              id="AppEmail-{{ section.id }}"
              name="email"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="john@company.com"
              required
            >
          </div>
          <span class="app-form__error-msg" id="ErrEmail-{{ section.id }}">Please enter a valid email address.</span>
        </div>
        <div class="app-form__field">
          <label class="app-form__label" for="AppPhone-{{ section.id }}">
            Phone Number<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <div class="app-form__input-wrap">
            <span class="app-form__input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.08 6.08l.97-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <input
              class="app-form__input app-form__input--icon"
              type="tel"
              id="AppPhone-{{ section.id }}"
              name="phone"
              autocomplete="tel"
              placeholder="+420 XXX XXX XXX"
              required
            >
          </div>
          <span class="app-form__error-msg" id="ErrPhone-{{ section.id }}">Please enter your phone number.</span>
        </div>
      </div>

      <h2 class="app-form__section-heading app-form__section-heading--company">
        {{ section.settings.section_2_heading | default: 'Company Details' | escape }}
      </h2>

      {%- comment -%} Company + VAT {%- endcomment -%}
      <div class="app-form__field-row">
        <div class="app-form__field">
          <label class="app-form__label" for="AppCompany-{{ section.id }}">
            Company Name<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <input
            class="app-form__input"
            type="text"
            id="AppCompany-{{ section.id }}"
            name="company_name"
            autocomplete="organization"
            placeholder="e.g., Luxury Retail s.r.o."
            required
          >
          <span class="app-form__error-msg" id="ErrCompany-{{ section.id }}">Please enter your company name.</span>
        </div>
        <div class="app-form__field">
          <label class="app-form__label" for="AppVat-{{ section.id }}">
            VAT / IČO Number<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <input
            class="app-form__input"
            type="text"
            id="AppVat-{{ section.id }}"
            name="vat_number"
            placeholder="Identification Number"
            required
          >
          <span class="app-form__error-msg" id="ErrVat-{{ section.id }}">Please enter your VAT or IČO number.</span>
        </div>
      </div>

      {%- comment -%} ZIP + Store Type {%- endcomment -%}
      <div class="app-form__field-row">
        <div class="app-form__field">
          <label class="app-form__label" for="AppZip-{{ section.id }}">ZIP / Postal Code</label>
          <input
            class="app-form__input"
            type="text"
            id="AppZip-{{ section.id }}"
            name="postal_code"
            autocomplete="postal-code"
            placeholder="110 00"
          >
        </div>
        <div class="app-form__field">
          <label class="app-form__label" for="AppStoreType-{{ section.id }}">
            Store Type<span class="app-form__required" aria-hidden="true">*</span>
          </label>
          <div class="app-form__select-wrap">
            <select
              class="app-form__select"
              id="AppStoreType-{{ section.id }}"
              name="store_type"
              required
            >
              <option value="" disabled selected>Select category…</option>
              <option value="boutique">Clothing / Shoe Boutique</option>
              <option value="perfumery">Specialized Perfumery</option>
              <option value="concept_store">Concept Store</option>
              <option value="online">Online Retailer</option>
              <option value="other">Other</option>
            </select>
            <span class="app-form__select-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </span>
          </div>
          <span class="app-form__error-msg" id="ErrStoreType-{{ section.id }}">Please select a store type.</span>
        </div>
      </div>

      {%- comment -%} Submit {%- endcomment -%}
      <div class="app-form__submit-row">
        <button type="submit" class="app-form__submit" id="AppSubmitBtn-{{ section.id }}">
          <span class="app-form__submit-spinner" aria-hidden="true"></span>
          <span class="app-form__submit-text">{{ section.settings.button_label | default: 'Submit Application' | escape }}</span>
          <svg class="app-form__submit-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>
        <p class="app-form__legal">
          By submitting this form, you agree to our
          <a href="/policies/terms-of-service">Wholesale Terms</a>
          and <a href="/policies/privacy-policy">Privacy Policy</a>.
        </p>
      </div>

    </form>

  </div>
</div>

<script>
(function () {
  if (window.lpAppFormReady) return;
  window.lpAppFormReady = true;

  var sid = '{{ section.id }}';
  var form     = document.getElementById('AppFormEl-' + sid);
  var card     = document.getElementById('AppFormCard-' + sid);
  var success  = document.getElementById('AppFormSuccess-' + sid);
  var resetBtn = document.getElementById('AppFormReset-' + sid);
  var submitBtn = document.getElementById('AppSubmitBtn-' + sid);

  if (!form) return;

  /* ── Field validation rules ── */
  var fields = [
    { id: 'AppFirstName-' + sid,  errId: 'ErrFirstName-' + sid,  validate: function(v) { return v.trim() !== ''; } },
    { id: 'AppLastName-' + sid,   errId: 'ErrLastName-' + sid,   validate: function(v) { return v.trim() !== ''; } },
    { id: 'AppEmail-' + sid,      errId: 'ErrEmail-' + sid,      validate: function(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); } },
    { id: 'AppPhone-' + sid,      errId: 'ErrPhone-' + sid,      validate: function(v) { return v.trim() !== ''; } },
    { id: 'AppCompany-' + sid,    errId: 'ErrCompany-' + sid,    validate: function(v) { return v.trim() !== ''; } },
    { id: 'AppVat-' + sid,        errId: 'ErrVat-' + sid,        validate: function(v) { return v.trim() !== ''; } },
    { id: 'AppStoreType-' + sid,  errId: 'ErrStoreType-' + sid,  validate: function(v) { return v !== ''; } }
  ];

  function setError(field, hasError) {
    var el  = document.getElementById(field.id);
    var err = document.getElementById(field.errId);
    if (!el || !err) return;
    if (hasError) {
      el.classList.add('is-error');
      err.classList.add('is-visible');
    } else {
      el.classList.remove('is-error');
      err.classList.remove('is-visible');
    }
  }

  /* Clear error on input change */
  fields.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    el.addEventListener('input', function () { setError(f, false); });
    el.addEventListener('change', function () { setError(f, false); });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    var valid = true;
    fields.forEach(function (f) {
      var el = document.getElementById(f.id);
      if (!el) return;
      var ok = f.validate(el.value);
      setError(f, !ok);
      if (!ok) valid = false;
    });

    if (!valid) {
      /* Scroll to first error */
      var firstErr = form.querySelector('.is-error');
      if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    /* Show loading state */
    submitBtn.disabled = true;
    submitBtn.classList.add('is-loading');

    /* Simulate async submission — replace with real fetch() if needed */
    setTimeout(function () {
      submitBtn.classList.remove('is-loading');
      submitBtn.disabled = false;
      card.style.display = 'none';
      success.classList.add('is-visible');
      success.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 1200);
  });

  /* Reset button */
  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      form.reset();
      fields.forEach(function (f) { setError(f, false); });
      success.classList.remove('is-visible');
      card.style.display = '';
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Application Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "default": false
    },
    {
      "type": "header",
      "content": "Section headings"
    },
    {
