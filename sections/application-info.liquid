{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' app-info--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Application Info — inline section styles
     ================================================ */

  .app-info {
    padding: 3rem 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .app-info {
      padding: 4rem 1.5rem;
      position: sticky;
      top: 9rem;
    }
  }

  /* ── Heading ───────────────────────────────────── */

  .app-info__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.1;
    color: #1c1917;
    margin: 0 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .app-info__heading { font-size: clamp(3rem, 7vw, 4rem); }
  }

  html.a11y-high-contrast .app-info__heading { color: #000000 !important; }

  /* ── Description ───────────────────────────────── */

  .app-info__desc {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #57534e;
    margin: 0 0 3rem;
  }

  .app-info--high-contrast .app-info__desc,
  html.a11y-high-contrast .app-info__desc {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  .app-info__desc p { margin: 0; }

  /* ── Steps ──────────────────────────────────────── */

  .app-info__steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .app-info__step {
    display: flex;
    gap: 1.25rem;
  }

  .app-info__step-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: #fffbeb;
    color: #b45309;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .app-info__step-icon svg { width: 1.5rem; height: 1.5rem; }

  .app-info--high-contrast .app-info__step-icon,
  html.a11y-high-contrast .app-info__step-icon {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  .app-info__step-title {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #1c1917;
    margin: 0 0 0.375rem;
  }

  html.a11y-high-contrast .app-info__step-title { color: #000000 !important; }

  .app-info__step-desc {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.6;
    color: #57534e;
    margin: 0;
  }

  .app-info--high-contrast .app-info__step-desc,
  html.a11y-high-contrast .app-info__step-desc {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  /* ── Security block ─────────────────────────────── */

  .app-info__security {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 0.5rem;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
  }

  .app-info--high-contrast .app-info__security,
  html.a11y-high-contrast .app-info__security {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
  }

  .app-info__security-icon {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    color: #16a34a;
    margin-top: 0.125rem;
  }

  html.a11y-high-contrast .app-info__security-icon { color: #000000 !important; }

  .app-info__security-text {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #57534e;
    margin: 0;
  }

  .app-info__security-text p { margin: 0; }

  .app-info--high-contrast .app-info__security-text,
  html.a11y-high-contrast .app-info__security-text {
    color: #000000 !important;
    font-weight: 700 !important;
  }
</style>

<div
  class="app-info{{ section_mod }}"
  id="ApplicationInfo-{{ section.id }}"
>

  {%- if section.settings.heading != blank -%}
    <h1 class="app-info__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- if section.settings.description != blank -%}
    <div class="app-info__desc">{{ section.settings.description }}</div>
  {%- endif -%}

  <div class="app-info__steps">

    {%- comment -%} Step 1 — Submit {%- endcomment -%}
    {%- if section.settings.step_1_title != blank -%}
      <div class="app-info__step">
        <div class="app-info__step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/>
            <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
            <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/>
            <path d="M10 6h4"/>
            <path d="M10 10h4"/>
            <path d="M10 14h4"/>
            <path d="M10 18h4"/>
          </svg>
        </div>
        <div>
          <p class="app-info__step-title">{{ section.settings.step_1_title | escape }}</p>
          {%- if section.settings.step_1_desc != blank -%}
            <p class="app-info__step-desc">{{ section.settings.step_1_desc | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Step 2 — Verification {%- endcomment -%}
    {%- if section.settings.step_2_title != blank -%}
      <div class="app-info__step">
        <div class="app-info__step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div>
          <p class="app-info__step-title">{{ section.settings.step_2_title | escape }}</p>
          {%- if section.settings.step_2_desc != blank -%}
            <p class="app-info__step-desc">{{ section.settings.step_2_desc | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Step 3 — Access {%- endcomment -%}
    {%- if section.settings.step_3_title != blank -%}
      <div class="app-info__step">
        <div class="app-info__step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <div>
          <p class="app-info__step-title">{{ section.settings.step_3_title | escape }}</p>
          {%- if section.settings.step_3_desc != blank -%}
            <p class="app-info__step-desc">{{ section.settings.step_3_desc | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>

  {%- if section.settings.security_text != blank -%}
    <div class="app-info__security">
      <svg class="app-info__security-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
      <div class="app-info__security-text">{{ section.settings.security_text }}</div>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Application Info",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "default": false
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesale Application"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Become an official distributor of Leather Parfum. Please provide your business details below, and we will get back to you with a personalized offer.</p>"
    },
    {
      "type": "header",
      "content": "Step 1"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "1. Submit Application"
    },
    {
      "type": "text",
      "id": "step_1_desc",
      "label": "Step 1 description",
      "default": "Fill in your business and contact information."
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "2. Verification (1 day)"
    },
    {
      "type": "text",
      "id": "step_2_desc",
      "label": "Step 2 description",
      "default": "Our manager will verify your VAT/IČO and confirm your partner status."
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 title",
      "default": "3. Access Granted"
    },
    {
      "type": "text",
      "id": "step_3_desc",
      "label": "Step 3 description",
      "default": "Gain full access to the B2B catalog with up to 40% discount from RRP."
    },
    {
      "type": "header",
      "content": "Security note"
    },
    {
      "type": "richtext",
      "id": "security_text",
      "label": "Security text",
      "default": "<p>Your data is securely encrypted. We never share our partners' business information with third parties.</p>"
    }
  ],
  "presets": [
    {
      "name": "Application Info"
    }
  ]
}
{% endschema %}
