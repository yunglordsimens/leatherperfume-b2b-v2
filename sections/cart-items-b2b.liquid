<style>
  .cib {
    padding: 2rem 1.5rem;
    background-color: #f5f5f4;
  }

  @media screen and (min-width: 990px) {
    .shopify-section:has(.cib) {
      width: 62%;
      float: left;
      clear: left;
    }
    .cib { padding: 3rem 2rem 3rem 0; }
  }

  .cib__inner { max-width: 100%; }

  /* ── Items card ───────────────────────────────────── */
  .cib__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.05);
  }

  html.a11y-high-contrast .cib__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  .cib__thead {
    display: none;
  }

  @media screen and (min-width: 600px) {
    .cib__thead {
      display: grid;
      grid-template-columns: 6fr 3fr 3fr;
      gap: 1rem;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #e7e5e4;
      background-color: #fafaf9;
    }
  }

  html.a11y-high-contrast .cib__thead {
    border-bottom: 2px solid #000000 !important;
  }

  .cib__th {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #78716c;
  }

  .cib__th--center { text-align: center; }
  .cib__th--right  { text-align: right; }

  html.a11y-high-contrast .cib__th { color: #000000 !important; }

  /* ── Row ─────────────────────────────────────────── */
  .cib__row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #f5f5f4;
  }

  .cib__row:last-child { border-bottom: none; }

  @media screen and (min-width: 600px) {
    .cib__row {
      display: grid;
      grid-template-columns: 6fr 3fr 3fr;
      align-items: center;
      gap: 1rem;
    }
  }

  .cib__mobile-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #78716c;
  }

  @media screen and (min-width: 600px) { .cib__mobile-label { display: none; } }

  html.a11y-high-contrast .cib__mobile-label { color: #000000 !important; }

  html.a11y-high-contrast .cib__row {
    border-bottom-color: #cccccc !important;
  }

  /* Product info */
  .cib__product { display: flex; align-items: center; gap: 1rem; }

  .cib__thumb {
    width: 5rem;
    height: 5rem;
    flex-shrink: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  html.a11y-high-contrast .cib__thumb { border: 2px solid #000000 !important; }

  .cib__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cib__thumb-placeholder {
    color: #d6d3d1;
  }

  .cib__thumb-placeholder svg { width: 1.5rem; height: 1.5rem; }

  .cib__sku {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #78716c;
    margin: 0 0 0.25rem;
  }

  html.a11y-high-contrast .cib__sku { color: #000000 !important; }

  .cib__name {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1rem;
    color: #1c1917;
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  html.a11y-high-contrast .cib__name { color: #000000 !important; }

  .cib__variant {
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    color: #78716c;
    margin: 0;
  }

  html.a11y-high-contrast .cib__variant { color: #000000 !important; }

  /* Qty */
  .cib__qty-wrap {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  @media screen and (min-width: 600px) {
    .cib__qty-wrap { justify-content: center; }
  }

  .cib__qty-row {
    display: inline-flex;
    align-items: center;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    padding: 0.25rem;
  }

  html.a11y-high-contrast .cib__qty-row {
    border: 2px solid #000000 !important;
    background-color: #ffffff !important;
  }

  .cib__qty-btn {
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #57534e;
    transition: background-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .cib__qty-btn:hover { background-color: #e7e5e4; color: #1c1917; }
  .cib__qty-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  html.a11y-high-contrast .cib__qty-btn { color: #000000 !important; }

  .cib__qty-btn svg { width: 0.875rem; height: 0.875rem; }

  .cib__qty-input {
    width: 3rem;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1c1917;
    background: none;
    border: none;
    outline: none;
    -moz-appearance: textfield;
  }

  .cib__qty-input::-webkit-inner-spin-button,
  .cib__qty-input::-webkit-outer-spin-button { -webkit-appearance: none; }

  html.a11y-high-contrast .cib__qty-input { color: #000000 !important; }

  /* Price + remove */
  .cib__price-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media screen and (min-width: 600px) {
    .cib__price-wrap { justify-content: flex-end; gap: 1rem; }
  }

  .cib__line-price {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.125rem;
    color: #1c1917;
  }

  html.a11y-high-contrast .cib__line-price { color: #000000 !important; }

  .cib__remove-btn {
    padding: 0.5rem;
    border: none;
    background: none;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #a8a29e;
    transition: color 0.15s ease, background-color 0.15s ease;
    flex-shrink: 0;
  }

  .cib__remove-btn:hover {
    color: #dc2626;
    background-color: #fee2e2;
  }

  html.a11y-high-contrast .cib__remove-btn {
    color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  html.a11y-high-contrast .cib__remove-btn:hover {
    background-color: #f0f0f0 !important;
  }

  .cib__remove-btn svg { width: 1.125rem; height: 1.125rem; display: block; }

  /* ── Order details ────────────────────────────────── */
  .cib__details {
    background-color: #fafaf9;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
  }

  @media screen and (min-width: 600px) {
    .cib__details { padding: 2.5rem; }
  }

  html.a11y-high-contrast .cib__details {
    border: 4px solid #000000 !important;
    background-color: #ffffff !important;
  }

  .cib__details-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: #1c1917;
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e7e5e4;
  }

  html.a11y-high-contrast .cib__details-heading {
    color: #000000 !important;
    border-bottom-color: #000000 !important;
  }

  .cib__field { margin-bottom: 1.25rem; }
  .cib__field:last-child { margin-bottom: 0; }

  .cib__label {
    display: block;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #44403c;
    margin-bottom: 0.625rem;
  }

  html.a11y-high-contrast .cib__label { color: #000000 !important; }

  .cib__input-wrap { position: relative; }

  .cib__input-icon {
    position: absolute;
    top: 50%;
    left: 1rem;
    transform: translateY(-50%);
    width: 1.125rem;
    height: 1.125rem;
    color: #a8a29e;
    pointer-events: none;
    flex-shrink: 0;
  }

  .cib__textarea-icon {
    position: absolute;
    top: 1.125rem;
    left: 1rem;
    width: 1.125rem;
    height: 1.125rem;
    color: #a8a29e;
    pointer-events: none;
    flex-shrink: 0;
  }

  .cib__input,
  .cib__textarea {
    width: 100%;
    padding: 0.875rem 1rem 0.875rem 3rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: #1c1917;
    background-color: #ffffff;
    border: 1.5px solid #d6d3d1;
    border-radius: 0.75rem;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .cib__textarea {
    resize: none;
    padding-top: 1rem;
    min-height: 5rem;
  }

  .cib__input:focus,
  .cib__textarea:focus {
    border-color: #b45309;
    box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.12);
  }

  html.a11y-high-contrast .cib__input,
  html.a11y-high-contrast .cib__textarea {
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .cib__hint {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    color: #78716c;
    margin: 0.375rem 0 0;
  }

  html.a11y-high-contrast .cib__hint { color: #000000 !important; }

  /* ── Saved indicator ──────────────────────────────── */
  .cib__saved {
    display: inline-block;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #15803d;
    opacity: 0;
    transition: opacity 0.3s ease;
    margin-left: 0.5rem;
  }

  .cib__saved.is-visible { opacity: 1; }

  /* ── Empty state ──────────────────────────────────── */
  .cib__empty {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  html.a11y-high-contrast .cib__empty { border: 4px solid #000000 !important; }

  .cib__empty-icon {
    width: 3.5rem;
    height: 3.5rem;
    color: #d6d3d1;
    margin: 0 auto 1.25rem;
  }

  .cib__empty-icon svg { width: 100%; height: 100%; }

  .cib__empty-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.375rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }

  html.a11y-high-contrast .cib__empty-heading { color: #000000 !important; }

  .cib__empty-text {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #78716c;
    margin: 0 0 1.5rem;
  }

  html.a11y-high-contrast .cib__empty-text { color: #000000 !important; }

  .cib__empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9375rem 2rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.75rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .cib__empty-btn:hover { background-color: #b45309; border-color: #b45309; color: #ffffff; }

  html.a11y-high-contrast .cib__empty-btn {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }
</style>

<div
  class="cib"
  id="CartItemsB2B-{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
>

  {%- if cart.item_count > 0 -%}

    <!-- Items card -->
    <div class="cib__card" id="CibItemsList">
      <div class="cib__thead">
        <span class="cib__th">Product</span>
        <span class="cib__th cib__th--center">Quantity</span>
        <span class="cib__th cib__th--right">Total (WSP)</span>
      </div>

      {%- for item in cart.items -%}
        <div
          class="cib__row"
          id="CibRow-{{ item.key }}"
          data-key="{{ item.key }}"
          data-line="{{ forloop.index }}"
          data-unit-price="{{ item.price }}"
        >
          <!-- Product -->
          <div class="cib__product">
            <div class="cib__thumb">
              {%- if item.image -%}
                {{ item.image | image_url: width: 160 | image_tag:
                  alt: item.product.title | escape,
                  loading: 'lazy',
                  width: 80,
                  height: 80
                }}
              {%- else -%}
                <div class="cib__thumb-placeholder" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {%- endif -%}
            </div>
            <div>
              {%- if item.sku != blank -%}
                <p class="cib__sku">{{ item.sku }}</p>
              {%- endif -%}
              <p class="cib__name">{{ item.product.title }}</p>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="cib__variant">{{ item.variant.title }} &bull; {{ item.price | money }}/ea</p>
              {%- else -%}
                <p class="cib__variant">{{ item.price | money }}/ea</p>
              {%- endunless -%}
            </div>
          </div>

          <!-- Quantity -->
          <div class="cib__qty-wrap">
            <div class="cib__qty-row">
              <button type="button" class="cib__qty-btn" data-cib-dec aria-label="Decrease quantity">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <input
                type="number"
                class="cib__qty-input"
                value="{{ item.quantity }}"
                min="1"
                aria-label="Quantity for {{ item.product.title | escape }}"
                data-cib-qty
              >
              <button type="button" class="cib__qty-btn" data-cib-inc aria-label="Increase quantity">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
          </div>

          <!-- Line total + remove -->
          <div class="cib__price-wrap">
            <span class="cib__mobile-label">Subtotal:</span>
            <span class="cib__line-price" id="CibLineTotal-{{ item.key }}" data-cib-line-total>
              {{ item.line_price | money }}
            </span>
            <button
              type="button"
              class="cib__remove-btn"
              data-cib-remove
              aria-label="Remove {{ item.product.title | escape }} from cart"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
              </svg>
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div><!-- /.cib__card -->

    <!-- Order Details -->
    <div class="cib__details">
      <h2 class="cib__details-heading">{{ section.settings.details_heading | default: 'Order Details' }}</h2>

      <!-- PO Number -->
      <div class="cib__field">
        <label class="cib__label" for="CibPoNumber">
          {{ section.settings.po_label | default: 'PO Number (Optional)' }}
        </label>
        <div class="cib__input-wrap">
          <svg class="cib__input-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/>
          </svg>
          <input
            type="text"
            id="CibPoNumber"
            class="cib__input"
            placeholder="{{ section.settings.po_placeholder | default: 'Enter your internal Purchase Order number' }}"
            value="{{ cart.attributes.po_number | escape }}"
            data-cib-po
          >
          <span class="cib__saved" id="CibPoSaved" aria-live="polite">Saved</span>
        </div>
        <p class="cib__hint">{{ section.settings.po_hint | default: 'This reference will appear on your invoice.' }}</p>
      </div>

      <!-- Order Notes -->
      <div class="cib__field">
        <label class="cib__label" for="CibOrderNotes">
          {{ section.settings.notes_label | default: 'Order Notes / Special Instructions' }}
        </label>
        <div class="cib__input-wrap">
          <svg class="cib__textarea-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/>
          </svg>
          <textarea
            id="CibOrderNotes"
            class="cib__textarea"
            rows="3"
            placeholder="{{ section.settings.notes_placeholder | default: 'Delivery instructions, requests, etc.' }}"
            data-cib-notes
          >{{ cart.attributes.order_notes | escape }}</textarea>
          <span class="cib__saved" id="CibNotesSaved" aria-live="polite">Saved</span>
        </div>
      </div>
    </div>

  {%- else -%}

    <!-- Empty state -->
    <div class="cib__empty">
      <div class="cib__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
      </div>
      <h2 class="cib__empty-heading">{{ section.settings.empty_heading | default: 'Your cart is empty' }}</h2>
      <p class="cib__empty-text">{{ section.settings.empty_text | default: 'Add products from the catalog to build your wholesale order.' }}</p>
      <a href="{{ section.settings.catalog_link | default: '/collections/all' }}" class="cib__empty-btn">
        {{ section.settings.catalog_btn | default: 'Go to Catalog' }}
      </a>
    </div>

  {%- endif -%}
</div>

<script>
(function () {
  if (window.lpCartItemsReady) return;
  window.lpCartItemsReady = true;

  var moneyFmt = document.querySelector('#CartItemsB2B-{{ section.id }}').getAttribute('data-money-format') || '{{ shop.money_format | escape }}';

  function fmtMoney(cents) {
    var val = (cents / 100).toFixed(2);
    return moneyFmt
      .replace(/\{\{\s*amount\s*\}\}/g, val)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.floor(cents / 100))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, val.replace('.', ','))
      .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, Math.floor(cents / 100));
  }

  /* ── Qty + remove wiring ──────────────────────────── */
  function initRow(row) {
    var line     = parseInt(row.getAttribute('data-line'));
    var unitP    = parseInt(row.getAttribute('data-unit-price'));
    var key      = row.getAttribute('data-key');
    var qtyInput = row.querySelector('[data-cib-qty]');
    var decBtn   = row.querySelector('[data-cib-dec]');
    var incBtn   = row.querySelector('[data-cib-inc]');
    var rmBtn    = row.querySelector('[data-cib-remove]');
    var totalEl  = row.querySelector('[data-cib-line-total]');

    function setQty(newQty) {
      if (newQty < 1) newQty = 1;
      qtyInput.value = newQty;
      if (totalEl) totalEl.textContent = fmtMoney(unitP * newQty);
      [decBtn, incBtn, rmBtn].forEach(function (b) { if (b) b.disabled = true; });

      fetch('/cart/change.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        body: JSON.stringify({line: line, quantity: newQty})
      })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        window.dispatchEvent(new CustomEvent('cart:updated', {detail: cart}));
        [decBtn, incBtn, rmBtn].forEach(function (b) { if (b) b.disabled = false; });
      })
      .catch(function () {
        [decBtn, incBtn, rmBtn].forEach(function (b) { if (b) b.disabled = false; });
      });
    }

    function removeItem() {
      if (rmBtn) rmBtn.disabled = true;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        body: JSON.stringify({line: line, quantity: 0})
      })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        row.remove();
        window.dispatchEvent(new CustomEvent('cart:updated', {detail: cart}));
        /* If list is now empty, reload to show empty state */
        if (cart.item_count === 0) { location.reload(); }
      })
      .catch(function () { if (rmBtn) rmBtn.disabled = false; });
    }

    if (decBtn)   decBtn.addEventListener('click',  function () { setQty((parseInt(qtyInput.value) || 1) - 1); });
    if (incBtn)   incBtn.addEventListener('click',  function () { setQty((parseInt(qtyInput.value) || 1) + 1); });
    if (rmBtn)    rmBtn.addEventListener('click',   removeItem);
    if (qtyInput) qtyInput.addEventListener('change', function () { setQty(parseInt(qtyInput.value) || 1); });
  }

  document.querySelectorAll('#CartItemsB2B-{{ section.id }} .cib__row').forEach(initRow);

  /* ── PO Number save ───────────────────────────────── */
  function saveAttr(key, value, savedEl) {
    var body = {attributes: {}};
    body.attributes[key] = value;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
      body: JSON.stringify(body)
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      if (!savedEl) return;
      savedEl.classList.add('is-visible');
      setTimeout(function () { savedEl.classList.remove('is-visible'); }, 2000);
    });
  }

  function debounce(fn, ms) {
    var t;
    return function () { clearTimeout(t); t = setTimeout(fn, ms); };
  }

  var poInput    = document.querySelector('[data-cib-po]');
  var notesInput = document.querySelector('[data-cib-notes]');
  var poSaved    = document.getElementById('CibPoSaved');
  var notesSaved = document.getElementById('CibNotesSaved');

  if (poInput)    poInput.addEventListener('input',  debounce(function () { saveAttr('po_number',    poInput.value,    poSaved);    }, 600));
  if (notesInput) notesInput.addEventListener('input', debounce(function () { saveAttr('order_notes', notesInput.value, notesSaved); }, 600));
})();
</script>

