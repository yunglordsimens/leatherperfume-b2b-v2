{%- liquid
  assign po_number = cart.attributes.po_number
-%}

<style>
  .css-wrap {
    background-color: #f5f5f4;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }

  html.a11y-high-contrast .css-wrap {
    background-color: #ffffff !important;
  }

  .css-card {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.10);
    padding: 2.5rem 1.5rem;
    max-width: 40rem;
    width: 100%;
    text-align: center;
  }

  @media screen and (min-width: 600px) {
    .css-card { padding: 3.5rem 3rem; }
  }

  html.a11y-high-contrast .css-card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  .css-icon {
    width: 5rem;
    height: 5rem;
    background-color: #f0fdf4;
    color: #16a34a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    flex-shrink: 0;
  }

  html.a11y-high-contrast .css-icon {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
  }

  .css-icon svg {
    width: 2.5rem;
    height: 2.5rem;
  }

  .css-heading {
    font-family: 'Yeseva One', serif;
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3rem);
    color: #1c1917;
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }

  html.a11y-high-contrast .css-heading { color: #000000 !important; }

  .css-text {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.75;
    color: #57534e;
    margin: 0 0 2rem;
  }

  html.a11y-high-contrast .css-text {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  .css-ref {
    display: inline-block;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    padding: 0.625rem 1.25rem;
    margin-bottom: 2rem;
    font-family: ui-monospace, 'Courier New', monospace;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #1c1917;
  }

  html.a11y-high-contrast .css-ref {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .css-ref__label {
    color: #78716c;
    font-weight: 400;
    margin-right: 0.375rem;
  }

  html.a11y-high-contrast .css-ref__label { color: #000000 !important; }

  .css-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    height: 56px;
    padding: 0 1.5rem;
    font-family: var(--font-body-family);
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .css-cta:hover {
    background-color: #ea580c;
  }

  html.a11y-high-contrast .css-cta {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 2px solid #000000 !important;
  }

  .css-cta svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }
</style>

<div class="css-wrap" id="CartSuccessB2B-{{ section.id }}" data-cart-success>
  <div class="css-card">

    <div class="css-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
    </div>

    <h1 class="css-heading">Order Submitted!</h1>

    <p class="css-text">Thank you. Your wholesale order has been sent to our team. We will review availability and send a proforma invoice to your registered email shortly.</p>

    <div class="css-ref">
      <span class="css-ref__label">Reference:</span><span id="css-po-ref">PO-{%- if po_number != blank -%}{{ po_number }}{%- else -%}{{ 'now' | date: '%s' | modulo: 900000 | plus: 100000 }}{%- endif -%}</span>
    </div>

    <a href="/collections/all" class="css-cta">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      Return to Catalog
    </a>

  </div>
</div>

<script>
(function () {
  var refEl = document.getElementById('css-po-ref');
  if (!refEl) return;
  var params = new URLSearchParams(window.location.search);
  var po = params.get('po');
  if (po) refEl.textContent = 'PO-' + decodeURIComponent(po);
})();
</script>

{% schema %}
{
  "name": "Cart Success B2B",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Cart Success B2B"
    }
  ]
}
{% endschema %}
