{%- liquid
  assign heading      = section.settings.heading      | default: 'Order Submitted!'
  assign thank_text   = section.settings.thank_text   | default: 'Thank you for your wholesale order. Our team will review it and send a confirmation shortly.'
  assign cta_label    = section.settings.cta_label    | default: 'Return to Catalog'
  assign cta_link     = section.settings.cta_link     | default: '/collections/wholesale'
  assign po_number    = cart.attributes.po_number
-%}

<style>
  .css-wrap {
    background-color: #f5f5f4;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }

  html.a11y-high-contrast .css-wrap {
    background-color: #ffffff !important;
  }

  .css-card {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.25rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
    padding: 3rem 2.5rem;
    max-width: 36rem;
    width: 100%;
    text-align: center;
  }

  html.a11y-high-contrast .css-card {
    border: 2px solid #000000 !important;
    box-shadow: none !important;
  }

  .css-icon {
    width: 5rem;
    height: 5rem;
    background-color: #d1fae5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.75rem;
  }

  html.a11y-high-contrast .css-icon {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
  }

  .css-icon svg {
    width: 2.5rem;
    height: 2.5rem;
    color: #059669;
  }

  html.a11y-high-contrast .css-icon svg {
    color: #000000 !important;
  }

  .css-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #1c1917;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  html.a11y-high-contrast .css-heading { color: #000000 !important; }

  .css-text {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.7;
    color: #57534e;
    margin: 0 0 1.75rem;
  }

  html.a11y-high-contrast .css-text { color: #000000 !important; }

  .css-po {
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    padding: 0.875rem 1.25rem;
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    text-align: left;
  }

  html.a11y-high-contrast .css-po {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
  }

  .css-po__label {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #78716c;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  html.a11y-high-contrast .css-po__label { color: #000000 !important; }

  .css-po__value {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1c1917;
  }

  html.a11y-high-contrast .css-po__value { color: #000000 !important; }

  .css-divider {
    width: 2.5rem;
    height: 2px;
    background-color: #e7e5e4;
    margin: 0 auto 1.75rem;
  }

  html.a11y-high-contrast .css-divider { background-color: #000000 !important; }

  .css-steps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    text-align: left;
  }

  .css-step {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .css-step__num {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: #1c1917;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.125rem;
  }

  html.a11y-high-contrast .css-step__num {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 1px solid #000000 !important;
  }

  .css-step__text {
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #57534e;
  }

  html.a11y-high-contrast .css-step__text { color: #000000 !important; }

  .css-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease;
    width: 100%;
  }

  .css-cta:hover {
    background-color: #292524;
  }

  html.a11y-high-contrast .css-cta {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 2px solid #000000 !important;
  }

  .css-cta svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* PO read from URL param (JS) */
  .css-po[hidden] { display: none; }
</style>

<div class="css-wrap" id="CartSuccessB2B-{{ section.id }}">
  <div class="css-card">

    <!-- checkmark icon -->
    <div class="css-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>

    <h1 class="css-heading">{{ heading }}</h1>
    <p class="css-text">{{ thank_text }}</p>

    {%- if po_number != blank -%}
      <div class="css-po">
        <span class="css-po__label">{{ section.settings.po_label | default: 'PO Reference' }}</span>
        <span class="css-po__value">{{ po_number }}</span>
      </div>
    {%- else -%}
      <!-- shown by JS if ?po= param present -->
      <div class="css-po" id="css-po-block" hidden>
        <span class="css-po__label">{{ section.settings.po_label | default: 'PO Reference' }}</span>
        <span class="css-po__value" id="css-po-value"></span>
      </div>
    {%- endif -%}

    <div class="css-divider"></div>

    <div class="css-steps" aria-label="What happens next">
      <div class="css-step">
        <span class="css-step__num" aria-hidden="true">1</span>
        <p class="css-step__text">{{ section.settings.step1 | default: 'Our team reviews your order within 1 business day.' }}</p>
      </div>
      <div class="css-step">
        <span class="css-step__num" aria-hidden="true">2</span>
        <p class="css-step__text">{{ section.settings.step2 | default: 'You receive an order confirmation and proforma invoice by email.' }}</p>
      </div>
      <div class="css-step">
        <span class="css-step__num" aria-hidden="true">3</span>
        <p class="css-step__text">{{ section.settings.step3 | default: 'Once payment is confirmed, your order ships within 3–5 business days.' }}</p>
      </div>
    </div>

    <a href="{{ cta_link }}" class="css-cta">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      {{ cta_label }}
    </a>

  </div>
</div>

<script>
(function () {
  var poBlock = document.getElementById('css-po-block');
  var poValue = document.getElementById('css-po-value');
  if (!poBlock || !poValue) return;
  var params = new URLSearchParams(window.location.search);
  var po = params.get('po');
  if (po) {
    poValue.textContent = decodeURIComponent(po);
    poBlock.removeAttribute('hidden');
  }
})();
</script>

{% schema %}
{
  "name": "Cart Success B2B",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order Submitted!"
    },
    {
      "type": "textarea",
      "id": "thank_text",
      "label": "Thank-you text",
      "default": "Thank you for your wholesale order. Our team will review it and send a confirmation shortly."
    },
    {
      "type": "text",
      "id": "po_label",
      "label": "PO reference label",
      "default": "PO Reference"
    },
    {
      "type": "text",
      "id": "step1",
      "label": "Step 1 text",
      "default": "Our team reviews your order within 1 business day."
    },
    {
      "type": "text",
      "id": "step2",
      "label": "Step 2 text",
      "default": "You receive an order confirmation and proforma invoice by email."
    },
    {
      "type": "text",
      "id": "step3",
      "label": "Step 3 text",
      "default": "Once payment is confirmed, your order ships within 3–5 business days."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Return to Catalog"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Cart Success B2B"
    }
  ]
}
{% endschema %}
