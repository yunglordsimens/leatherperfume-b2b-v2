{%- liquid
  assign moq_display = section.settings.moq_amount | default: 5000
  assign moq_cents   = moq_display | times: 100
  assign vat_rate    = section.settings.vat_rate    | default: 21
  assign submit_btn  = section.settings.submit_btn  | default: 'Submit for Invoicing'
  assign submit_note = section.settings.submit_note | default: 'No payment required now. You will receive an invoice after order confirmation.'
  assign moq_label   = section.settings.moq_label   | default: 'MOQ Target'
  assign moq_reached_label = section.settings.moq_reached_label | default: 'MOQ Reached'

  assign discount_pct = 0
  assign has_discount = false
  if customer and customer.tags contains 'wholesale'
    assign discount_tier = 'standard'
    assign discount_pct = 0
    assign tier_rank = 0
    for t in customer.tags
      assign tl = t | downcase
      if tl contains 'platinum' and tier_rank < 5
        assign discount_tier = 'platinum'
        assign discount_pct = 15
        assign tier_rank = 5
      elsif tl contains 'gold' and tier_rank < 4
        assign discount_tier = 'gold'
        assign discount_pct = 10
        assign tier_rank = 4
      elsif tl contains 'silver' and tier_rank < 3
        assign discount_tier = 'silver'
        assign discount_pct = 5
        assign tier_rank = 3
      elsif tl contains 'bronze' and tier_rank < 2
        assign discount_tier = 'bronze'
        assign discount_pct = 2
        assign tier_rank = 2
      endif
    endfor
    if tier_rank == 0
      assign mf_tier = customer.metafields.custom.discount_tier.value
      assign mf_pct = customer.metafields.custom.discount_percent.value | default: customer.metafields.custom.discount_percentage.value
      if mf_pct
        assign discount_pct = mf_pct
      endif
      if mf_tier != blank
        assign discount_tier = mf_tier
      endif
    endif
    if discount_pct > 0 and discount_tier != 'standard'
      assign has_discount = true
    endif
  endif

  assign discounted_subtotal = cart.items_subtotal_price
  if has_discount
    assign discount_factor = 100 | minus: discount_pct
    assign discounted_subtotal = cart.items_subtotal_price | times: discount_factor | divided_by: 100
  endif

  assign moq_reached = false
  if discounted_subtotal >= moq_cents
    assign moq_reached = true
  endif

  assign remaining_cents = moq_cents | minus: discounted_subtotal
  if remaining_cents < 0
    assign remaining_cents = 0
  endif

  assign vat_cents = discounted_subtotal | times: vat_rate | divided_by: 100

  assign progress_pct = 0
  if moq_cents > 0
    assign progress_pct = discounted_subtotal | times: 100 | divided_by: moq_cents
  endif
  if progress_pct > 100
    assign progress_pct = 100
  endif
  if progress_pct > 0 and progress_pct < 3
    assign progress_pct = 3
  endif
-%}

<style>
  .csb {
    padding: 2rem 1.5rem;
    background-color: #f5f5f4;
  }

  /* ── Cart layout: items + summary centered at page-width ──
     #MainContent grid keeps both columns aligned with the rest
     of the content instead of floating across the full viewport. */

  /* Uniform page background so the shorter column doesn't leave
     a white hole beneath itself */
  #MainContent:has(.cib) { background-color: #f5f5f4; }

  @media screen and (min-width: 990px) {
    #MainContent:has(.cib):has(.csb) {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      column-gap: 2.5rem;
      max-width: var(--page-width, 90rem);
      margin-inline: auto;
      padding-inline: 1.5rem;
      box-sizing: border-box;
    }

    #MainContent:has(.cib):has(.csb) > .shopify-section {
      grid-column: 1 / -1;
    }

    #MainContent:has(.cib):has(.csb) > .shopify-section:has(.cib) {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    #MainContent:has(.cib):has(.csb) > .shopify-section:has(.csb) {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
    }

    .csb { padding: 3rem 0; }
  }

  .csb__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
    position: sticky;
    top: 9rem;
  }

  @media screen and (min-width: 600px) { .csb__card { padding: 2.5rem; } }

  html.a11y-high-contrast .csb__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  .csb__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.375rem;
    color: #1c1917;
    margin: 0 0 1.5rem;
  }

  html.a11y-high-contrast .csb__heading { color: #000000 !important; }

  /* ── MOQ tracker ──────────────────────────────────── */
  .csb__moq {
    background-color: #fafaf9;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  html.a11y-high-contrast .csb__moq {
    border: 4px solid #000000 !important;
    background-color: #ffffff !important;
  }

  .csb__moq-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  .csb__moq-title {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #78716c;
  }

  .csb__moq-title--reached { color: #15803d; }

  html.a11y-high-contrast .csb__moq-title { color: #000000 !important; }

  .csb__moq-target {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    color: #1c1917;
  }

  html.a11y-high-contrast .csb__moq-target { color: #000000 !important; }

  .csb__track {
    height: 0.75rem;
    background-color: #e7e5e4;
    border-radius: 9999px;
    overflow: hidden;
  }

  html.a11y-high-contrast .csb__track {
    border: 2px solid #000000 !important;
    background-color: #ffffff !important;
  }

  .csb__fill {
    height: 100%;
    border-radius: 9999px;
    background-color: #f59e0b;
    transition: width 0.4s ease;
  }

  .csb__fill--reached { background-color: #22c55e; }

  html.a11y-high-contrast .csb__fill { background-color: #000000 !important; }

  /* ── moq-tracker aliases (requested class API) ────── */
  .moq-tracker {
    background-color: #f5f5f4;
    border-radius: 1rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .moq-bar {
    height: 100%;
    border-radius: 9999px;
    background-color: #f59e0b;
    transition: width 0.5s ease;
  }

  html.a11y-high-contrast .moq-bar { background-color: #000000 !important; }

  .moq-text {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #b45309;
  }

  html.a11y-high-contrast .moq-text { color: #000000 !important; }

  .csb__moq-msg {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.875rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #b45309;
  }

  html.a11y-high-contrast .csb__moq-msg { color: #000000 !important; }

  .csb__moq-msg svg { width: 1.125rem; height: 1.125rem; flex-shrink: 0; margin-top: 0.1rem; }

  /* ── Breakdown ────────────────────────────────────── */
  .csb__breakdown {
    border-bottom: 1px solid #e7e5e4;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
  }

  html.a11y-high-contrast .csb__breakdown { border-bottom-color: #000000 !important; }

  .csb__line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
  }

  .csb__line:last-child { margin-bottom: 0; }

  .csb__line-label {
    color: #57534e;
    font-weight: 500;
  }

  html.a11y-high-contrast .csb__line-label { color: #000000 !important; font-weight: 700; }

  .csb__line-value {
    color: #1c1917;
    font-weight: 700;
  }

  html.a11y-high-contrast .csb__line-value { color: #000000 !important; }

  .csb__line-value--muted {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a8a29e;
    font-weight: 700;
  }

  html.a11y-high-contrast .csb__line-value--muted { color: #000000 !important; }

  /* ── Total ────────────────────────────────────────── */
  .csb__total {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .csb__total-label {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1c1917;
  }

  html.a11y-high-contrast .csb__total-label { color: #000000 !important; }

  .csb__total-value {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: #1c1917;
    line-height: 1;
  }

  html.a11y-high-contrast .csb__total-value { color: #000000 !important; }

  /* ── Submit button ────────────────────────────────── */
  .csb__submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    padding: 1.125rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.875rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .csb__submit-btn:hover:not([disabled]) { background-color: #b45309; border-color: #b45309; color: #ffffff; }

  .csb__submit-btn[disabled],
  .csb__submit-btn.is-disabled {
    background-color: #d6d3d1;
    border-color: #d6d3d1;
    color: #a8a29e;
    cursor: not-allowed;
  }

  html.a11y-high-contrast .csb__submit-btn {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }

  html.a11y-high-contrast .csb__submit-btn[disabled] {
    background-color: #999999 !important;
    border-color: #999999 !important;
    color: #ffffff !important;
  }

  .csb__submit-icon { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }

  .csb__submit-note {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    color: #78716c;
    text-align: center;
    margin: 0.875rem 0 0;
  }

  html.a11y-high-contrast .csb__submit-note { color: #000000 !important; }
</style>

<div
  class="csb"
  id="CartSummaryB2B-{{ section.id }}"
  data-moq="{{ moq_display }}"
  data-vat="{{ vat_rate }}"
  data-discount-pct="{{ discount_pct }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="csb__card">
    <h2 class="csb__heading">{{ section.settings.summary_heading | default: 'Summary' }}</h2>

    <!-- MOQ tracker -->
    <div class="csb__moq moq-tracker" id="CsbMoqTracker">
      <div class="csb__moq-header">
        <span class="csb__moq-title{% if moq_reached %} csb__moq-title--reached{% endif %}" id="CsbMoqTitle">
          {%- if moq_reached -%}{{ moq_reached_label }}{%- else -%}{{ moq_label }}{%- endif -%}
        </span>
        <span class="csb__moq-target">{{ moq_cents | money }}</span>
      </div>
      <div class="csb__track">
        <div
          class="csb__fill moq-bar{% if moq_reached %} csb__fill--reached{% endif %}"
          id="CsbMoqFill"
          style="width: {{ progress_pct }}%;"
          role="progressbar"
          aria-valuenow="{{ progress_pct }}"
          aria-valuemin="0"
          aria-valuemax="100"
        ></div>
      </div>
      <p class="csb__moq-msg moq-text" id="CsbMoqMsg"{% if moq_reached %} style="display:none;"{% endif %}>
        You are <span class="moq-remaining" id="CsbMoqRemaining">{{ remaining_cents | money }}</span> away from minimum order.
      </p>
    </div>

    <!-- Cost breakdown -->
    <div class="csb__breakdown">
      <div class="csb__line">
        <span class="csb__line-label">{{ section.settings.subtotal_label | default: 'Subtotal (WSP)' }}</span>
        <span class="csb__line-value" id="CsbSubtotal">{{ cart.items_subtotal_price | money }}</span>
      </div>
      {%- if has_discount -%}
        <div class="csb__line">
          <span class="csb__line-label">Tier Discount (−{{ discount_pct }}%)</span>
          <span class="csb__line-value" style="color:#15803d;" id="CsbDiscount">-{{ cart.items_subtotal_price | minus: discounted_subtotal | money }}</span>
        </div>
      {%- endif -%}
      <div class="csb__line">
        <span class="csb__line-label">{{ section.settings.vat_label | default: 'Estimated VAT' }} ({{ vat_rate }}%)</span>
        <span class="csb__line-value" id="CsbVat">{{ vat_cents | money }}</span>
      </div>
      <div class="csb__line">
        <span class="csb__line-label">{{ section.settings.shipping_label | default: 'Shipping' }}</span>
        <span class="csb__line-value csb__line-value--muted">{{ section.settings.shipping_value | default: 'Calculated Later' }}</span>
      </div>
    </div>

    <!-- Total -->
    <div class="csb__total">
      <span class="csb__total-label">{{ section.settings.total_label | default: 'Total' }}</span>
      <span class="csb__total-value" id="CsbTotal">{{ discounted_subtotal | plus: vat_cents | money }}</span>
    </div>

    <!-- Submit -->
    {%- if moq_reached -%}
      <a href="/checkout" class="csb__submit-btn" id="CsbSubmitBtn">
        {{ submit_btn }}
        <svg class="csb__submit-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    {%- else -%}
      <button type="button" class="csb__submit-btn is-disabled" disabled id="CsbSubmitBtn" aria-disabled="true">
        {{ submit_btn }}
        <svg class="csb__submit-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    {%- endif -%}

    <p class="csb__submit-note">{{ submit_note }}</p>
  </div>
</div>

<script>
(function () {
  var wrap = document.getElementById('CartSummaryB2B-{{ section.id }}');
  if (!wrap || wrap.dataset.csbInit === 'true') return;
  wrap.dataset.csbInit = 'true';

  var moqTarget   = parseFloat(wrap.getAttribute('data-moq')) || 5000; /* display units */
  var vatRate     = parseFloat(wrap.getAttribute('data-vat')) || 21;
  var discountPct = parseFloat(wrap.getAttribute('data-discount-pct')) || 0;
  var moneyFmt    = wrap.getAttribute('data-money-format') || '{{ shop.money_format | escape }}';

  var moqTitle     = document.getElementById('CsbMoqTitle');
  var moqFill      = document.getElementById('CsbMoqFill');
  var moqMsg       = document.getElementById('CsbMoqMsg');
  var moqRemaining = document.getElementById('CsbMoqRemaining');
  var subtotEl     = document.getElementById('CsbSubtotal');
  var vatEl        = document.getElementById('CsbVat');
  var totalEl      = document.getElementById('CsbTotal');

  function fmtMoney(cents) {
    var val = (cents / 100).toFixed(2);
    return moneyFmt
      .replace(/\{\{\s*amount\s*\}\}/g, val)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.floor(cents / 100))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, val.replace('.', ','))
      .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, Math.floor(cents / 100));
  }

  /* Update MOQ bar, text and submit button state. totalDisplay = display units (e.g. CZK) */
  function updateMoq(totalDisplay) {
    var pct         = Math.min(Math.round((totalDisplay / moqTarget) * 100), 100);
    if (pct > 0 && pct < 3) pct = 3; /* keep the bar visible on small carts */
    var remaining   = Math.max(moqTarget - totalDisplay, 0);
    var reached     = totalDisplay >= moqTarget;

    if (moqFill) {
      moqFill.style.width = pct + '%';
      moqFill.setAttribute('aria-valuenow', pct);
      moqFill.classList.toggle('csb__fill--reached', reached);
    }

    if (moqTitle) {
      moqTitle.classList.toggle('csb__moq-title--reached', reached);
      moqTitle.textContent = reached
        ? '{{ section.settings.moq_reached_label | default: "MOQ Reached" }}'
        : '{{ section.settings.moq_label | default: "MOQ Target" }}';
    }

    if (moqMsg)       moqMsg.style.display = reached ? 'none' : '';
    if (moqRemaining) moqRemaining.textContent = fmtMoney(remaining * 100);

    /* Enable / disable submit */
    var submitBtn = document.getElementById('CsbSubmitBtn');
    if (!submitBtn) return;
    if (reached) {
      if (submitBtn.tagName === 'BUTTON') {
        var link    = document.createElement('a');
        link.href      = '#';
        link.className = submitBtn.className.replace(/\bis-disabled\b/g, '').trim();
        link.id        = 'CsbSubmitBtn';
        link.innerHTML = submitBtn.innerHTML;
        submitBtn.parentNode.replaceChild(link, submitBtn);
      } else {
        submitBtn.classList.remove('is-disabled');
        submitBtn.removeAttribute('disabled');
        submitBtn.removeAttribute('aria-disabled');
      }
    } else {
      if (submitBtn.tagName === 'A') {
        var btn     = document.createElement('button');
        btn.type      = 'button';
        btn.className = submitBtn.className + ' is-disabled';
        btn.id        = 'CsbSubmitBtn';
        btn.disabled  = true;
        btn.setAttribute('aria-disabled', 'true');
        btn.innerHTML = submitBtn.innerHTML;
        submitBtn.parentNode.replaceChild(btn, submitBtn);
      } else {
        submitBtn.disabled = true;
        submitBtn.classList.add('is-disabled');
        submitBtn.setAttribute('aria-disabled', 'true');
      }
    }
  }

  /* Sync JS state with the server-rendered bar on load */
  (function init() {
    var initCents   = {{ cart.items_subtotal_price }};
    var initDisc    = Math.round(initCents * (100 - discountPct) / 100);
    var initDisplay = initDisc / 100;
    updateMoq(initDisplay);
  })();

  /* ── Submit → save PO/notes onto the cart, then go to checkout ──
     Shopify checkout collects the shipping address and, with a manual
     "Pay by invoice" method enabled, creates a real pending order. PO
     number and notes ride along as cart attributes / order note. */
  function goToCheckout() {
    window.location.href = '/checkout';
  }

  function handleSubmit() {
    var poInput    = document.querySelector('[data-cib-po]');
    var notesInput = document.querySelector('[data-cib-notes]');
    var poValue    = poInput ? poInput.value.trim() : '';
    var notesValue = notesInput ? notesInput.value.trim() : '';

    /* Structured attribute (dashboard reads order.attributes.po_number)
       + a human-readable order Note so PO and instructions are visible
       at a glance on the order in admin. */
    var noteParts = [];
    if (poValue)    noteParts.push('PO Number: ' + poValue);
    if (notesValue) noteParts.push('Notes: ' + notesValue);

    var payload = { attributes: { po_number: poValue } };
    if (noteParts.length) payload.note = noteParts.join('\n');

    fetch('/cart/update.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
      body: JSON.stringify(payload)
    })
    .then(function () { goToCheckout(); })
    .catch(function () { goToCheckout(); });
  }

  wrap.addEventListener('click', function (e) {
    var btn = e.target.closest('#CsbSubmitBtn');
    if (!btn) return;
    if (btn.disabled || btn.classList.contains('is-disabled')) return;
    e.preventDefault();
    handleSubmit();
  });

  /* ── React to cart changes ─────────────────────────── */
  function onCartChange(cart) {
    if (!cart) return;
    var subtotal   = cart.items_subtotal_price || 0;
    var discFactor = (100 - discountPct) / 100;
    var discounted = Math.round(subtotal * discFactor);
    var vat        = Math.round(discounted * vatRate / 100);
    var total      = discounted + vat;

    if (subtotEl) subtotEl.textContent = fmtMoney(subtotal);
    if (vatEl)    vatEl.textContent    = fmtMoney(vat);
    if (totalEl)  totalEl.textContent  = fmtMoney(total);

    var discountEl = document.getElementById('CsbDiscount');
    if (discountEl && discountPct > 0) {
      discountEl.textContent = '-' + fmtMoney(subtotal - discounted);
    }

    updateMoq(discounted / 100);
  }

  /* cart:updated — dispatched by cart-items-b2b AJAX handlers */
  window.addEventListener('cart:updated', function (e) { onCartChange(e.detail); });

  /* cart:changed — Shopify Dawn native event */
  document.addEventListener('cart:changed', function (e) { onCartChange(e.detail && e.detail.cart ? e.detail.cart : e.detail); });
})();
</script>

{% schema %}
{
  "name": "Cart Summary B2B",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text",   "id": "summary_heading",     "label": "Card heading",             "default": "Summary" },
    { "type": "header", "content": "MOQ Tracker" },
    { "type": "number", "id": "moq_amount",          "label": "MOQ threshold",            "default": 5000,
      "info": "In display currency units. 5000 = 5,000 CZK. Multiplied by 100 internally." },
    { "type": "text",   "id": "moq_label",           "label": "MOQ label",                "default": "MOQ Target" },
    { "type": "text",   "id": "moq_reached_label",   "label": "MOQ reached label",        "default": "MOQ Reached" },
    { "type": "text",   "id": "moq_msg_prefix",      "label": "Remaining msg prefix",     "default": "Add" },
    { "type": "text",   "id": "moq_msg_suffix",      "label": "Remaining msg suffix",     "default": "more to proceed with this order." },
    { "type": "header", "content": "Breakdown" },
    { "type": "text",   "id": "subtotal_label",      "label": "Subtotal label",           "default": "Subtotal (WSP)" },
