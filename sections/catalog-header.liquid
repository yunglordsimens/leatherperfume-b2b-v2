{%- liquid
  assign is_wholesale = false
  if customer.tags contains 'wholesale'
    assign is_wholesale = true
  endif

  if is_wholesale
    assign heading = section.settings.heading_wholesale | default: 'Create Order'
    assign sub_html = section.settings.description_wholesale
  else
    assign heading = section.settings.heading_default | default: collection.title | default: 'Wholesale Catalog'
    assign sub_text = section.settings.subheading_default | default: collection.description | default: 'Explore our complete range of niche perfumes, premium leather accessories, and B2B tester sets.'
  endif

  assign filter_btn = section.settings.filter_button_text | default: 'Filters'
-%}

<style>
  /* ── Breadcrumb (wholesale, per collectionb2b mockup) ── */
  .cat-crumbs {
    background-color: #ffffff;
    border-bottom: 1px solid #e7e5e4;
    padding: 1rem 1.5rem;
  }

  html.a11y-high-contrast .cat-crumbs {
    border-bottom: 2px solid #000000 !important;
  }

  .cat-crumbs__list {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #78716c;
  }

  .cat-crumbs__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cat-crumbs__list a:hover { color: #b45309; }

  .cat-crumbs__list svg { width: 0.875rem; height: 0.875rem; flex-shrink: 0; }
  .cat-crumbs__sep { color: #d6d3d1; }
  .cat-crumbs__current { color: #1c1917; }

  html.a11y-high-contrast .cat-crumbs__list,
  html.a11y-high-contrast .cat-crumbs__current { color: #000000 !important; }

  .cat-hdr {
    background-color: #f5f5f4;
    border-bottom: 1px solid #e7e5e4;
    padding: 3rem 1.5rem 2rem;
  }

  html.a11y-high-contrast .cat-hdr {
    background-color: #ffffff !important;
    border-bottom: 4px solid #000000 !important;
  }

  .cat-hdr__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .cat-hdr__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .cat-hdr__text {}

  .cat-hdr__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: #1c1917;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  html.a11y-high-contrast .cat-hdr__heading { color: #000000 !important; }

  .cat-hdr__sub {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.7;
    color: #78716c;
    margin: 0;
    max-width: 42rem;
  }

  .cat-hdr__sub p { margin: 0; }

  html.a11y-high-contrast .cat-hdr__sub {
    color: #000000 !important;
    font-weight: 500;
  }

  /* Mobile filter toggle — hidden on desktop */
  .cat-hdr__filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1c1917;
    background-color: #ffffff;
    border: 1px solid #d6d3d1;
    border-radius: 0.75rem;
    cursor: pointer;
    flex-shrink: 0;
    width: 100%;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  @media screen and (min-width: 600px) {
    .cat-hdr__filter-btn { width: auto; }
  }

  .cat-hdr__filter-btn:hover {
    background-color: #f5f5f4;
    border-color: #a8a29e;
  }

  html.a11y-high-contrast .cat-hdr__filter-btn {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
    box-shadow: none !important;
  }

  .cat-hdr__filter-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  @media screen and (min-width: 990px) {
    .cat-hdr__filter-btn { display: none; }
  }
</style>

{%- if is_wholesale -%}
<nav class="cat-crumbs" aria-label="Breadcrumb">
  <ol class="cat-crumbs__list">
    <li>
      <a href="{{ routes.root_url }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        {{ 'b2b.breadcrumb.home' | t }}
      </a>
    </li>
    <li class="cat-crumbs__sep" aria-hidden="true">›</li>
    <li><a href="/collections/all">{{ 'b2b.breadcrumb.order_portal' | t }}</a></li>
    {%- if collection.handle != 'all' and collection.title != blank -%}
      <li class="cat-crumbs__sep" aria-hidden="true">›</li>
      <li class="cat-crumbs__current" aria-current="page">{{ collection.title }}</li>
    {%- endif -%}
  </ol>
</nav>
{%- endif -%}

<section class="cat-hdr" id="CatalogHeader-{{ section.id }}">
  <div class="cat-hdr__inner">
    <div class="cat-hdr__text">
      <h1 class="cat-hdr__heading">{{ heading }}</h1>
      {%- if is_wholesale -%}
        {%- if sub_html != blank -%}
          <div class="cat-hdr__sub">{{ sub_html }}</div>
        {%- endif -%}
      {%- else -%}
        {%- if sub_text != blank -%}
          <p class="cat-hdr__sub">{{ sub_text }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>

    <button
      class="cat-hdr__filter-btn"
      data-catalog-filter-toggle
      aria-expanded="false"
      aria-controls="CatalogSidebar"
      type="button"
    >
      <svg class="cat-hdr__filter-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="21" y1="4" x2="14" y2="4"/><line x1="10" y1="4" x2="3" y2="4"/>
        <line x1="21" y1="12" x2="12" y2="12"/><line x1="8" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="20" x2="16" y2="20"/><line x1="12" y1="20" x2="3" y2="20"/>
        <circle cx="12" cy="4" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="14" cy="20" r="2"/>
      </svg>
      {{ filter_btn }}
    </button>
  </div>
</section>

<script>
(function () {
  var btn = document.querySelector('[data-catalog-filter-toggle]');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var sidebar = document.getElementById('CatalogSidebar');
    if (!sidebar) return;
    var isOpen = sidebar.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
})();
</script>

{% schema %}
{
  "name": "Catalog Header",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Wholesale customers"
    },
    {
      "type": "text",
      "id": "heading_wholesale",
      "label": "Heading (wholesale)",
      "default": "Create Order"
    },
    {
      "type": "richtext",
      "id": "description_wholesale",
      "label": "Description (wholesale)",
      "default": "<p>Add products to your wholesale cart. All prices below reflect your active partnership discount.</p>"
    },
    {
      "type": "header",
      "content": "Default (guest / retail)"
    },
    {
      "type": "text",
      "id": "heading_default",
      "label": "Heading override",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "textarea",
      "id": "subheading_default",
      "label": "Subheading override",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "header",
      "content": "Filter button"
    },
    {
      "type": "text",
      "id": "filter_button_text",
      "label": "Filter button label",
      "default": "Filters"
    }
  ],
  "presets": [
    {
      "name": "Catalog Header"
    }
  ]
}
{% endschema %}
