{%- liquid
  assign heading    = section.settings.heading    | default: collection.title
  assign subheading = section.settings.subheading | default: collection.description
-%}

<style>
  .cat-hdr {
    background-color: #f5f5f4;
    border-bottom: 1px solid #e7e5e4;
    padding: 3rem 1.5rem 2rem;
  }

  html.a11y-high-contrast .cat-hdr {
    background-color: #ffffff !important;
    border-bottom: 4px solid #000000 !important;
  }

  .cat-hdr__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .cat-hdr__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .cat-hdr__text {}

  .cat-hdr__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: #1c1917;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  html.a11y-high-contrast .cat-hdr__heading { color: #000000 !important; }

  .cat-hdr__sub {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.7;
    color: #78716c;
    margin: 0;
    max-width: 42rem;
  }

  html.a11y-high-contrast .cat-hdr__sub {
    color: #000000 !important;
    font-weight: 500;
  }

  /* Mobile filter toggle — hidden on desktop */
  .cat-hdr__filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1c1917;
    background-color: #ffffff;
    border: 1px solid #d6d3d1;
    border-radius: 0.75rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .cat-hdr__filter-btn:hover {
    background-color: #f5f5f4;
    border-color: #a8a29e;
  }

  html.a11y-high-contrast .cat-hdr__filter-btn {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .cat-hdr__filter-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  @media screen and (min-width: 990px) {
    .cat-hdr__filter-btn { display: none; }
  }
</style>

<section class="cat-hdr" id="CatalogHeader-{{ section.id }}">
  <div class="cat-hdr__inner">
    <div class="cat-hdr__text">
      <h1 class="cat-hdr__heading">{{ heading }}</h1>
      {%- if subheading != blank -%}
        <p class="cat-hdr__sub">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <button
      class="cat-hdr__filter-btn"
      data-catalog-filter-toggle
      aria-expanded="false"
      aria-controls="CatalogSidebar"
      type="button"
    >
      <svg class="cat-hdr__filter-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
      </svg>
      Filters
    </button>
  </div>
</section>

<script>
(function () {
  var btn = document.querySelector('[data-catalog-filter-toggle]');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var sidebar = document.getElementById('CatalogSidebar');
    if (!sidebar) return;
    var isOpen = sidebar.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
})();
</script>

{% schema %}
{
  "name": "Catalog Header",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading override",
      "info": "Leave blank to use the collection description."
    }
  ],
  "presets": [
    {
      "name": "Catalog Header"
    }
  ]
}
{% endschema %}
