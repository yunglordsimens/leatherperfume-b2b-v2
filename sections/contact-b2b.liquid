{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' cb2b--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Contact B2B — inline section styles
     ================================================ */

  .cb2b {
    padding: 3rem 1rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .cb2b { padding: 4rem 1.5rem 6rem; }
  }

  .cb2b__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
  }

  /* ── Page header ────────────────────────────────── */

  .cb2b__header {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .cb2b__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.1;
    color: #1c1917;
    margin: 0 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .cb2b__heading { font-size: clamp(3rem, 8vw, 4rem); }
  }

  html.a11y-high-contrast .cb2b__heading { color: #000000 !important; }

  .cb2b__subheading {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #57534e;
    margin: 0;
  }

  .cb2b--high-contrast .cb2b__subheading,
  html.a11y-high-contrast .cb2b__subheading {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  .cb2b__subheading p { margin: 0; }

  /* ── Two-column layout ──────────────────────────── */

  .cb2b__layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: flex-start;
  }

  @media screen and (min-width: 990px) {
    .cb2b__layout {
      flex-direction: row;
      gap: 5rem;
    }
  }

  /* ── Left column ────────────────────────────────── */

  .cb2b__left {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media screen and (min-width: 990px) {
    .cb2b__left { width: 41.667%; flex-shrink: 0; }
  }

  /* Section eyebrow */
  .cb2b__eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #a8a29e;
    margin: 0 0 1.5rem;
  }

  .cb2b--high-contrast .cb2b__eyebrow,
  html.a11y-high-contrast .cb2b__eyebrow { color: #000000 !important; }

  /* Contact link rows */
  .cb2b__contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cb2b__contact-item a {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    text-decoration: none;
  }

  .cb2b__contact-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #78716c;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .cb2b__contact-icon svg { width: 1.25rem; height: 1.25rem; }

  .cb2b__contact-item a:hover .cb2b__contact-icon {
    border-color: #fcd34d;
    background-color: #fffbeb;
    color: #b45309;
  }

  .cb2b__contact-item--whatsapp a:hover .cb2b__contact-icon {
    border-color: #86efac;
    background-color: #f0fdf4;
    color: #16a34a;
  }

  .cb2b--high-contrast .cb2b__contact-icon,
  html.a11y-high-contrast .cb2b__contact-icon {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .cb2b__contact-label-small {
    font-family: var(--font-body-family);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #a8a29e;
    margin: 0 0 0.25rem;
  }

  .cb2b--high-contrast .cb2b__contact-label-small,
  html.a11y-high-contrast .cb2b__contact-label-small { color: #000000 !important; }

  .cb2b__contact-value {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1c1917;
    transition: color 0.15s ease;
    margin: 0;
  }

  .cb2b__contact-item a:hover .cb2b__contact-value { color: #b45309; }
  .cb2b__contact-item--whatsapp a:hover .cb2b__contact-value { color: #16a34a; }

  .cb2b--high-contrast .cb2b__contact-value,
  html.a11y-high-contrast .cb2b__contact-value {
    color: #000000 !important;
    text-decoration: underline !important;
  }

  /* Divider */
  .cb2b__divider {
    border: none;
    border-top: 1px solid #e7e5e4;
    margin: 0;
  }

  .cb2b--high-contrast .cb2b__divider,
  html.a11y-high-contrast .cb2b__divider {
    border-top: 2px solid #000000 !important;
  }

  /* Office & hours grid */
  .cb2b__office-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media screen and (min-width: 600px) and (max-width: 989px) {
    .cb2b__office-grid { grid-template-columns: 1fr 1fr; }
  }

  .cb2b__office-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #a8a29e;
    margin: 0 0 1.25rem;
  }

  .cb2b--high-contrast .cb2b__office-eyebrow,
  html.a11y-high-contrast .cb2b__office-eyebrow { color: #000000 !important; }

  .cb2b__office-eyebrow svg { width: 1rem; height: 1rem; }

  .cb2b__address {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.7;
    color: #57534e;
    font-style: normal;
  }

  .cb2b__address strong {
    font-weight: 700;
    color: #1c1917;
    display: block;
    margin-bottom: 0.5rem;
  }

  .cb2b--high-contrast .cb2b__address,
  html.a11y-high-contrast .cb2b__address {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  .cb2b--high-contrast .cb2b__address strong,
  html.a11y-high-contrast .cb2b__address strong { color: #000000 !important; }

  .cb2b__address p { margin: 0; }

  /* Hours table */
  .cb2b__hours-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-body-family);
    font-size: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cb2b__hours-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #57534e;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e7e5e4;
  }

  .cb2b__hours-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cb2b__hours-val {
    font-weight: 700;
    color: #1c1917;
  }

  .cb2b--high-contrast .cb2b__hours-row,
  html.a11y-high-contrast .cb2b__hours-row {
    color: #000000 !important;
    border-bottom-color: #000000 !important;
    font-weight: 500 !important;
  }

  .cb2b--high-contrast .cb2b__hours-val,
  html.a11y-high-contrast .cb2b__hours-val { color: #000000 !important; }

  /* ── Right column ───────────────────────────────── */

  .cb2b__right {
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .cb2b__right { width: 58.333%; }
  }

  /* Form card */
  .cb2b__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 0.5rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  @media screen and (min-width: 600px) {
    .cb2b__card { padding: 2.5rem; }
  }

  @media screen and (min-width: 990px) {
    .cb2b__card { padding: 3rem; }
  }

  .cb2b--high-contrast .cb2b__card,
  html.a11y-high-contrast .cb2b__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  .cb2b__card-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
    color: #1c1917;
    margin: 0 0 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e7e5e4;
  }

  html.a11y-high-contrast .cb2b__card-heading { color: #000000 !important; }

  /* Success state */
  .cb2b__success {
    padding: 2rem;
    text-align: center;
    border-radius: 0.5rem;
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
  }

  .cb2b--high-contrast .cb2b__success,
  html.a11y-high-contrast .cb2b__success {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
  }

  .cb2b__success-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: #dcfce7;
    color: #16a34a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .cb2b__success-icon svg { width: 2rem; height: 2rem; }

  .cb2b--high-contrast .cb2b__success-icon,
  html.a11y-high-contrast .cb2b__success-icon {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
  }

  .cb2b__success-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.75rem;
    color: #1c1917;
    margin: 0 0 1rem;
  }

  .cb2b__success-text {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.65;
    color: #57534e;
    margin: 0;
  }

  html.a11y-high-contrast .cb2b__success-text { color: #000000 !important; }

  /* Form fields */
  .cb2b__form-fields {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cb2b__field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 600px) {
    .cb2b__field-row { grid-template-columns: 1fr 1fr; }
  }

  .cb2b__field { display: flex; flex-direction: column; }

  .cb2b__label {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #44403c;
    margin-bottom: 0.75rem;
  }

  .cb2b--high-contrast .cb2b__label,
  html.a11y-high-contrast .cb2b__label { color: #000000 !important; }

  .cb2b__required { color: #dc2626; margin-left: 0.25rem; }
  html.a11y-high-contrast .cb2b__required { color: #000000 !important; }

  .cb2b__input,
  .cb2b__textarea {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 500;
    color: #1c1917;
    background-color: #ffffff;
    border: 1.5px solid #d6d3d1;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    width: 100%;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
  }

  .cb2b__input:focus,
  .cb2b__textarea:focus {
    border-color: #b45309;
    box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.15);
  }

  .cb2b--high-contrast .cb2b__input,
  .cb2b--high-contrast .cb2b__textarea,
  html.a11y-high-contrast .cb2b__input,
  html.a11y-high-contrast .cb2b__textarea {
    border: 2px solid #000000 !important;
  }

  .cb2b__input.is-error,
  .cb2b__textarea.is-error {
    border-color: #dc2626 !important;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12) !important;
  }

  .cb2b__error-msg {
    display: none;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #dc2626;
    margin-top: 0.5rem;
  }

  .cb2b__error-msg.is-visible { display: block; }

  html.a11y-high-contrast .cb2b__error-msg { color: #000000 !important; }

  .cb2b__textarea { resize: none; }

  /* Submit button */
  .cb2b__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.125rem 2.5rem;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    margin-top: 1rem;
  }

  .cb2b__submit:hover {
    background-color: #b45309;
    border-color: #b45309;
  }

  .cb2b__submit svg { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }

  .cb2b--high-contrast .cb2b__submit,
  html.a11y-high-contrast .cb2b__submit {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }

  /* Error list */
  .cb2b__errors {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .cb2b__errors ul { margin: 0; padding: 0; list-style: none; }

  .cb2b__errors li {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #991b1b;
  }

  .cb2b--high-contrast .cb2b__errors,
  html.a11y-high-contrast .cb2b__errors {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
  }

  html.a11y-high-contrast .cb2b__errors li { color: #000000 !important; }

  /* ── Promo block ────────────────────────────────── */

  .cb2b__promo {
    margin-top: 2rem;
    padding: 2rem;
    border-radius: 0.5rem;
    background-color: #1c1917;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media screen and (min-width: 600px) {
    .cb2b__promo {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cb2b--high-contrast .cb2b__promo,
  html.a11y-high-contrast .cb2b__promo {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 4px solid #000000 !important;
  }

  .cb2b__promo-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.25rem;
    color: inherit;
    margin: 0 0 0.5rem;
  }

  .cb2b__promo-text {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #a8a29e;
    margin: 0;
  }

  .cb2b__promo-text p { margin: 0; }

  .cb2b--high-contrast .cb2b__promo-text,
  html.a11y-high-contrast .cb2b__promo-text { color: #333333 !important; }

  .cb2b__promo-btn {
    display: inline-block;
    flex-shrink: 0;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    background-color: #ffffff;
    color: #1c1917;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease;
    white-space: nowrap;
    border: 2px solid #ffffff;
  }

  .cb2b__promo-btn:hover { background-color: #e7e5e4; }

  .cb2b--high-contrast .cb2b__promo-btn,
  html.a11y-high-contrast .cb2b__promo-btn {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }
</style>

<section
  class="cb2b{{ section_mod }}"
  id="ContactB2B-{{ section.id }}"
>
  <div class="cb2b__container">

    {%- comment -%} ── Page header ── {%- endcomment -%}
    <div class="cb2b__header">
      <h1 class="cb2b__heading">{{ section.settings.heading | default: 'Contact Us' | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="cb2b__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="cb2b__layout">

      {%- comment -%} ── Left column: contact info ── {%- endcomment -%}
      <div class="cb2b__left">

        <div>
          <p class="cb2b__eyebrow">Get in touch</p>
          <ul class="cb2b__contact-list" role="list">

            {%- if section.settings.contact_email != blank -%}
              <li class="cb2b__contact-item">
                <a href="mailto:{{ section.settings.contact_email }}">
                  <div class="cb2b__contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"/>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                  </div>
                  <div>
                    <p class="cb2b__contact-label-small">Email</p>
                    <p class="cb2b__contact-value">{{ section.settings.contact_email | escape }}</p>
                  </div>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.phone != blank -%}
              <li class="cb2b__contact-item">
                <a href="tel:{{ section.settings.phone | remove: ' ' }}">
                  <div class="cb2b__contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.08 6.08l.97-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="cb2b__contact-label-small">Phone</p>
                    <p class="cb2b__contact-value">{{ section.settings.phone | escape }}</p>
                  </div>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.whatsapp != blank -%}
              <li class="cb2b__contact-item cb2b__contact-item--whatsapp">
                <a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener noreferrer">
                  <div class="cb2b__contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="cb2b__contact-label-small">WhatsApp Support</p>
                    <p class="cb2b__contact-value">{{ section.settings.whatsapp | escape }}</p>
                  </div>
                </a>
              </li>
            {%- endif -%}

          </ul>
        </div>

        <hr class="cb2b__divider">

        <div class="cb2b__office-grid">

          {%- if section.settings.address != blank -%}
            <div>
              <p class="cb2b__office-eyebrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:1rem;height:1rem">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Office &amp; Warehouse
              </p>
              <address class="cb2b__address">{{ section.settings.address }}</address>
            </div>
          {%- endif -%}

          <div>
            <p class="cb2b__office-eyebrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:1rem;height:1rem">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              Business Hours
            </p>
            <ul class="cb2b__hours-list" role="list">
              <li class="cb2b__hours-row">
                <span>Mon – Fri</span>
                <span class="cb2b__hours-val">{{ section.settings.hours_weekdays | default: '9:00 – 17:00 CET' | escape }}</span>
              </li>
              <li class="cb2b__hours-row">
                <span>Sat – Sun</span>
                <span>{{ section.settings.hours_weekend | default: 'Closed' | escape }}</span>
              </li>
            </ul>
          </div>

        </div>

      </div>

      {%- comment -%} ── Right column: contact form ── {%- endcomment -%}
      <div class="cb2b__right">

        <div class="cb2b__card">
          <h2 class="cb2b__card-heading">Send a Message</h2>

          {%- form 'contact', id: 'ContactFormB2B', data-contact-b2b: section.id -%}

            {%- if form.posted_successfully? -%}
              <div class="cb2b__success" role="status">
                <div class="cb2b__success-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                </div>
                <h3 class="cb2b__success-heading">Message Sent!</h3>
                <p class="cb2b__success-text">Thank you for reaching out. A member of our B2B team will respond to your inquiry shortly.</p>
              </div>

            {%- else -%}

              {%- if form.errors -%}
                <div class="cb2b__errors" role="alert">
                  <ul>
                    {%- for error in form.errors -%}
                      <li>{{ form.errors.messages[error] }}</li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              <div class="cb2b__form-fields">

                <div class="cb2b__field-row">
                  <div class="cb2b__field">
                    <label class="cb2b__label" for="ContactName-{{ section.id }}">
                      Your Name<span class="cb2b__required" aria-hidden="true">*</span>
                    </label>
                    <input
                      class="cb2b__input"
                      type="text"
                      name="contact[name]"
                      id="ContactName-{{ section.id }}"
                      autocomplete="name"
                      placeholder="John Doe"
                      value="{{ form.name }}"
                      required
                    >
                    <span class="cb2b__error-msg" id="CbErrName-{{ section.id }}">Please enter your name.</span>
                  </div>
                  <div class="cb2b__field">
                    <label class="cb2b__label" for="ContactEmail-{{ section.id }}">
                      Email Address<span class="cb2b__required" aria-hidden="true">*</span>
                    </label>
                    <input
                      class="cb2b__input"
                      type="email"
                      name="contact[email]"
                      id="ContactEmail-{{ section.id }}"
                      autocomplete="email"
                      autocorrect="off"
                      autocapitalize="off"
                      placeholder="john@company.com"
                      value="{{ form.email }}"
                      required
                    >
                    <span class="cb2b__error-msg" id="CbErrEmail-{{ section.id }}">Please enter a valid email address.</span>
                  </div>
                </div>

                <div class="cb2b__field">
                  <label class="cb2b__label" for="ContactBody-{{ section.id }}">
                    Message<span class="cb2b__required" aria-hidden="true">*</span>
                  </label>
                  <textarea
                    class="cb2b__textarea"
                    name="contact[body]"
                    id="ContactBody-{{ section.id }}"
                    rows="5"
                    placeholder="How can we help you?"
                    required
                  >{{ form.body }}</textarea>
                  <span class="cb2b__error-msg" id="CbErrBody-{{ section.id }}">Please enter your message.</span>
                </div>

                <div>
                  <button type="submit" class="cb2b__submit">
                    Send Message
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="22" y1="2" x2="11" y2="13"/>
                      <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                  </button>
                </div>

              </div>

            {%- endif -%}

          {%- endform -%}
        </div>

        {%- if section.settings.promo_heading != blank or section.settings.promo_text != blank -%}
          <div class="cb2b__promo">
            <div>
              {%- if section.settings.promo_heading != blank -%}
                <h3 class="cb2b__promo-heading">{{ section.settings.promo_heading | escape }}</h3>
              {%- endif -%}
              {%- if section.settings.promo_text != blank -%}
                <div class="cb2b__promo-text">{{ section.settings.promo_text }}</div>
              {%- endif -%}
            </div>
            {%- if section.settings.promo_btn_label != blank -%}
              <a
                href="{{ section.settings.promo_btn_link | default: '/pages/wholesale-application' }}"
                class="cb2b__promo-btn"
              >
                {{- section.settings.promo_btn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

<script>
(function () {
  if (window.lpContactB2BReady) return;
  window.lpContactB2BReady = true;

  document.querySelectorAll('form[data-contact-b2b]').forEach(function (form) {
    var sid = form.getAttribute('data-contact-b2b');

    var fields = [
      {
        id: 'ContactName-'  + sid,
        errId: 'CbErrName-'  + sid,
        validate: function (v) { return v.trim() !== ''; }
      },
      {
        id: 'ContactEmail-' + sid,
        errId: 'CbErrEmail-' + sid,
        validate: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }
      },
      {
        id: 'ContactBody-'  + sid,
        errId: 'CbErrBody-'  + sid,
        validate: function (v) { return v.trim() !== ''; }
      }
    ];

    function setError(f, hasError) {
      var el  = document.getElementById(f.id);
      var err = document.getElementById(f.errId);
      if (!el || !err) return;
      if (hasError) {
        el.classList.add('is-error');
        err.classList.add('is-visible');
      } else {
        el.classList.remove('is-error');
        err.classList.remove('is-visible');
      }
    }

    /* Clear error as user types / changes value */
    fields.forEach(function (f) {
      var el = document.getElementById(f.id);
      if (!el) return;
      el.addEventListener('input',  function () { setError(f, false); });
      el.addEventListener('change', function () { setError(f, false); });
    });

    form.addEventListener('submit', function (e) {
      var valid = true;
      fields.forEach(function (f) {
        var el = document.getElementById(f.id);
        if (!el) return;
        var ok = f.validate(el.value);
        setError(f, !ok);
        if (!ok) valid = false;
      });

      if (!valid) {
        e.preventDefault();
        var firstErr = form.querySelector('.is-error');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });
})();
</script>

