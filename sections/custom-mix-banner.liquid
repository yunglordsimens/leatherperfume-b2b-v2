{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' custom-mix-banner--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Custom Mix Banner — inline section styles
     ================================================ */

  .custom-mix-banner {
    padding: 1.5rem;
  }

  .custom-mix-banner__inner {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
  }

  .custom-mix-banner__card {
    padding: 2rem;
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
    background-color: #1c1917;
    color: #ffffff;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  @media screen and (min-width: 750px) {
    .custom-mix-banner__card {
      padding: 3rem;
    }
  }

  @media screen and (min-width: 990px) {
    .custom-mix-banner__card {
      padding: 4rem;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .custom-mix-banner--high-contrast .custom-mix-banner__card,
  html.a11y-high-contrast .custom-mix-banner__card {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── Left content ───────────────────────────────── */

  .custom-mix-banner__content {
    flex-grow: 1;
    max-width: 42rem;
  }

  .custom-mix-banner__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .custom-mix-banner__icon-wrap {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background-color: #292524;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.25rem;
    line-height: 1;
  }

  .custom-mix-banner--high-contrast .custom-mix-banner__icon-wrap,
  html.a11y-high-contrast .custom-mix-banner__icon-wrap {
    background-color: transparent !important;
    border: 2px solid #000000 !important;
  }

  .custom-mix-banner__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
    margin: 0;
    color: inherit;
  }

  .custom-mix-banner__desc {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.65;
    color: #a8a29e;
    margin: 0;
  }

  .custom-mix-banner--high-contrast .custom-mix-banner__desc,
  html.a11y-high-contrast .custom-mix-banner__desc {
    color: #333333 !important;
    font-weight: 500 !important;
  }

  /* ── CTA ────────────────────────────────────────── */

  .custom-mix-banner__cta {
    flex-shrink: 0;
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .custom-mix-banner__cta {
      width: auto;
    }
  }

  .custom-mix-banner__btn {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    padding: 1.125rem 2.5rem;
    border-radius: 0.75rem;
    background-color: #ffffff;
    color: #1c1917;
    text-decoration: none;
    border: 2px solid #ffffff;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .custom-mix-banner__btn:hover {
    background-color: #e7e5e4;
    border-color: #e7e5e4;
  }

  @media screen and (min-width: 990px) {
    .custom-mix-banner__btn {
      display: inline-block;
      width: auto;
    }
  }

  .custom-mix-banner--high-contrast .custom-mix-banner__btn,
  html.a11y-high-contrast .custom-mix-banner__btn {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }

  html.a11y-high-contrast .custom-mix-banner__btn:hover {
    background-color: #333333 !important;
    border-color: #333333 !important;
  }
</style>

<section
  class="custom-mix-banner{{ section_mod }}"
  id="CustomMixBanner-{{ section.id }}"
>
  <div class="custom-mix-banner__inner">
    <div class="custom-mix-banner__card">

      <div class="custom-mix-banner__content">
        <div class="custom-mix-banner__header">
          <div class="custom-mix-banner__icon-wrap" aria-hidden="true">⚙️</div>
          <h2 class="custom-mix-banner__heading">{{ section.settings.heading | default: 'Custom Mix' | escape }}</h2>
        </div>
        {%- if section.settings.description != blank -%}
          <p class="custom-mix-banner__desc">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="custom-mix-banner__cta">
          <a
            href="{{ section.settings.button_link | default: '/collections/all' }}"
            class="custom-mix-banner__btn"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Mix Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "info": "White background with black border.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Mix"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Build your own order directly from our full catalog. No minimum package required — just meet the standard MOQ (Minimum Order Quantity) of 5,000 CZK to qualify for wholesale pricing. Best for experienced retailers who know exactly what they need."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Go to Catalog"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom Mix Banner"
    }
  ]
}
{% endschema %}
