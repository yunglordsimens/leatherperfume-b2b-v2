        </div>
      </div><!-- /#DcPanel-settings -->

    </div><!-- /.dc__main -->
  </div><!-- /.dc__inner -->
</div><!-- /.dc -->

<script>
(function () {
  if (window.lpDashboardReady) return;
  window.lpDashboardReady = true;

  function initDashboard(sectionId) {
    var tabs = document.querySelectorAll('[data-dc-tab]');
    if (!tabs.length) return;

    function activateTab(tabKey) {
      tabs.forEach(function (btn) {
        var isActive = btn.getAttribute('data-dc-tab') === tabKey;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      var panels = document.querySelectorAll('.dc__panel');
      panels.forEach(function (panel) {
        var isActive = panel.id === ('DcPanel-' + tabKey + '-' + sectionId);
        panel.classList.toggle('is-active', isActive);
      });
    }

    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        activateTab(btn.getAttribute('data-dc-tab'));
      });
    });

    /* Back buttons inside placeholder panels */
    document.querySelectorAll('[data-dc-back-tab]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activateTab(btn.getAttribute('data-dc-back-tab'));
      });
    });
  }

  /* Init once DOM is ready */
  var sid = document.querySelector('[id^="DashboardContent-"]');
  if (sid) {
    var id = sid.id.replace('DashboardContent-', '');
    initDashboard(id);
  }
})();
</script>

