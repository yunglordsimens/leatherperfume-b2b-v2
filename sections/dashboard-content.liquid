{%- liquid
  assign mgr_name  = section.settings.manager_name  | default: 'Your Account Manager'
  assign mgr_email = section.settings.manager_email | default: 'wholesale@leatherparfum.com'
  assign mgr_phone = section.settings.manager_phone | default: ''

  assign tier       = customer.metafields.custom.discount_tier.value        | default: '—'
  assign disc_pct   = customer.metafields.custom.discount_percentage.value  | default: '0'
  assign company_name = customer.metafields.custom.shop_name.value | default: customer.metafields.custom.company_name.value
-%}

<style>
  /* ─── layout ─────────────────────────────────────────── */
  .dc {
    background-color: #f5f5f4;
    padding: 2.5rem 1.5rem 4rem;
  }
  html.a11y-high-contrast .dc { background-color: #ffffff !important; }

  .dc__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media screen and (min-width: 990px) {
    .dc__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }
  }

  /* ─── sidebar nav ─────────────────────────────────────── */
  .dc__nav {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media screen and (min-width: 990px) { .dc__nav { width: 14rem; } }

  html.a11y-high-contrast .dc__nav { border: 2px solid #000000 !important; }

  .dc__nav-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem 1.25rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #57534e;
    background: transparent;
    border: none;
    border-bottom: 1px solid #f5f5f4;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .dc__nav-btn:last-child { border-bottom: none; }
  .dc__nav-btn:hover { background-color: #f5f5f4; color: #1c1917; }
  .dc__nav-btn.is-active { background-color: #1c1917; color: #ffffff; }
  a.dc__nav-btn { text-decoration: none; }
  .dc__nav-btn--logout { color: #b91c1c; }
  .dc__nav-btn--logout:hover { background-color: #fef2f2; color: #b91c1c; }
  html.a11y-high-contrast .dc__nav-btn--logout { color: #000000; }

  /* Settings panel */
  .dc__settings {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 1.5rem;
  }
  html.a11y-high-contrast .dc__settings { border: 2px solid #000000 !important; }
  .dc__set-row { padding: 0.75rem 0; border-bottom: 1px solid #f5f5f4; }
  .dc__set-label { font-family: var(--font-body-family); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #78716c; margin: 0 0 0.25rem; }
  .dc__set-value { font-family: var(--font-body-family); font-size: 1rem; font-weight: 700; color: #1c1917; margin: 0; }
  .dc__set-sub { font-family: var(--font-body-family); font-size: 0.875rem; color: #78716c; margin: 0.125rem 0 0; }
  html.a11y-high-contrast .dc__set-label, html.a11y-high-contrast .dc__set-value, html.a11y-high-contrast .dc__set-sub { color: #000000 !important; }
  .dc__set-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .dc__set-note { font-family: var(--font-body-family); font-size: 0.8125rem; color: #78716c; margin: 1.25rem 0 0; line-height: 1.5; }
  html.a11y-high-contrast .dc__set-note { color: #000000 !important; }

  html.a11y-high-contrast .dc__nav-btn.is-active {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .dc__nav-icon { width: 1rem; height: 1rem; flex-shrink: 0; opacity: 0.7; }
  .dc__nav-btn.is-active .dc__nav-icon { opacity: 1; }

  /* ─── panels ──────────────────────────────────────────── */
  .dc__panels { flex: 1; min-width: 0; }
  .dc__panel { display: none; }
  .dc__panel.is-active { display: block; }

  /* ─── stat cards ──────────────────────────────────────── */
  .dc__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  @media screen and (min-width: 600px) { .dc__cards { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (min-width: 990px) { .dc__cards { grid-template-columns: repeat(3, 1fr); } }

  .dc__card {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 1.5rem;
  }
  html.a11y-high-contrast .dc__card { border: 2px solid #000000 !important; }

  .dc__card-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #78716c;
    margin: 0 0 0.5rem;
  }
  html.a11y-high-contrast .dc__card-label { color: #000000 !important; }

  .dc__card-value {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.75rem;
    color: #1c1917;
    line-height: 1.2;
    margin: 0 0 0.375rem;
  }
  html.a11y-high-contrast .dc__card-value { color: #000000 !important; }

  .dc__card-sub {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    color: #78716c;
    margin: 0;
  }
  html.a11y-high-contrast .dc__card-sub { color: #000000 !important; }

  /* tier badge */
  .dc__tier-badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background-color: #d97706;
    color: #ffffff;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  html.a11y-high-contrast .dc__tier-badge {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  /* ─── section title ───────────────────────────────────── */
  .dc__section-title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: #1c1917;
    margin: 0 0 1rem;
  }
  html.a11y-high-contrast .dc__section-title { color: #000000 !important; }

  /* ─── table ───────────────────────────────────────────── */
  .dc__table-wrap {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    overflow: hidden;
  }
  html.a11y-high-contrast .dc__table-wrap { border: 2px solid #000000 !important; }

  .dc__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
  }

  .dc__table thead { background-color: #f5f5f4; }
  html.a11y-high-contrast .dc__table thead { background-color: #ffffff !important; }

  .dc__table th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #78716c;
    white-space: nowrap;
    border-bottom: 1px solid #e7e5e4;
  }
  html.a11y-high-contrast .dc__table th { color: #000000 !important; border-bottom: 2px solid #000000 !important; }

  .dc__table td {
    padding: 0.875rem 1rem;
    color: #1c1917;
    border-bottom: 1px solid #f5f5f4;
    vertical-align: middle;
  }
  .dc__table tbody tr:last-child td { border-bottom: none; }
  html.a11y-high-contrast .dc__table td { color: #000000 !important; border-bottom: 1px solid #cccccc !important; }

  .dc__table tbody tr:hover td { background-color: #fafaf9; }

  .dc__order-link {
    font-weight: 700;
    color: #1c1917;
    text-decoration: none;
  }
  .dc__order-link:hover { text-decoration: underline; }
  html.a11y-high-contrast .dc__order-link { color: #000000 !important; text-decoration: underline; }

  /* status badges */
  .dc__badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: capitalize;
  }
  .dc__badge--paid    { background-color: #d1fae5; color: #065f46; }
  .dc__badge--pending { background-color: #fef3c7; color: #92400e; }
  .dc__badge--refunded, .dc__badge--voided { background-color: #fee2e2; color: #991b1b; }
  .dc__badge--other   { background-color: #e7e5e4; color: #44403c; }

  html.a11y-high-contrast .dc__badge {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #000000 !important;
  }

  /* action buttons */
  .dc__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.12s ease, border-color 0.12s ease;
    white-space: nowrap;
  }
  .dc__btn--outline {
    color: #1c1917;
    background: #ffffff;
    border: 1px solid #d6d3d1;
  }
  .dc__btn--outline:hover { background-color: #f5f5f4; border-color: #a8a29e; }
  .dc__btn--dark {
    color: #ffffff;
    background: #1c1917;
    border: 1px solid #1c1917;
  }
  .dc__btn--dark:hover { background-color: #292524; }

  html.a11y-high-contrast .dc__btn--outline {
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }
  html.a11y-high-contrast .dc__btn--dark {
    background-color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  .dc__btn-group { display: flex; gap: 0.375rem; flex-wrap: wrap; }

  /* ─── empty state ─────────────────────────────────────── */
  .dc__empty {
    padding: 3rem 1.5rem;
    text-align: center;
    color: #78716c;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
  }
  html.a11y-high-contrast .dc__empty { color: #000000 !important; }

  /* ─── account manager card ────────────────────────────── */
  .dc__mgr {
    background: #1c1917;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-top: 1.5rem;
  }
  html.a11y-high-contrast .dc__mgr { background-color: #000000 !important; border: 2px solid #000000 !important; }

  .dc__mgr-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #a8a29e;
    margin: 0 0 0.5rem;
  }
  .dc__mgr-name {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.125rem;
    color: #ffffff;
    margin: 0 0 0.875rem;
  }
  .dc__mgr-contact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .dc__mgr-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    color: #d6d3d1;
    text-decoration: none;
  }
  .dc__mgr-link:hover { color: #ffffff; text-decoration: underline; }
  .dc__mgr-link svg { width: 0.875rem; height: 0.875rem; flex-shrink: 0; }

  /* ─── placeholder panel ───────────────────────────────── */
  .dc__coming-soon {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 4rem 2rem;
    text-align: center;
  }
  html.a11y-high-contrast .dc__coming-soon { border: 2px solid #000000 !important; }

  .dc__coming-soon svg { width: 3rem; height: 3rem; color: #d6d3d1; margin-bottom: 1rem; }
  html.a11y-high-contrast .dc__coming-soon svg { color: #000000 !important; }
  .dc__coming-soon h3 {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }
  .dc__coming-soon p {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #78716c;
    margin: 0;
  }
  html.a11y-high-contrast .dc__coming-soon h3,
  html.a11y-high-contrast .dc__coming-soon p { color: #000000 !important; }

  /* ─── auth gate ───────────────────────────────────────── */
  .dc__auth-gate {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 4rem 2rem;
    text-align: center;
    max-width: 30rem;
    margin: 0 auto;
  }
  html.a11y-high-contrast .dc__auth-gate { border: 2px solid #000000 !important; }
  .dc__auth-gate h2 {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.5rem;
    color: #1c1917;
    margin: 0 0 0.75rem;
  }
  .dc__auth-gate p {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #57534e;
    margin: 0 0 1.5rem;
  }
  .dc__auth-gate a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    background-color: #1c1917;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 0.75rem;
    text-decoration: none;
  }
  .dc__auth-gate a:hover { background-color: #292524; }

  /* table scroll on mobile */
  .dc__table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
</style>

{%- unless customer -%}
  <div class="dc">
    <div class="dc__inner" style="justify-content: center;">
      <div class="dc__auth-gate">
        <h2>{{ section.settings.auth_heading | default: 'Sign in to access your dashboard' }}</h2>
        <p>{{ section.settings.auth_text | default: 'Please log in with your wholesale account to view your dashboard.' }}</p>
        <a href="/pages/partner-login?return_url={{ request.path | url_encode }}">{{ section.settings.auth_btn | default: 'Sign in' }}</a>
      </div>
    </div>
  </div>
{%- else -%}

<div class="dc" id="DashboardContent-{{ section.id }}">
  <div class="dc__inner">

    <!-- ── sidebar nav ─────────────────────────────────── -->
    <nav class="dc__nav" aria-label="Dashboard navigation">
      <button class="dc__nav-btn is-active" type="button" data-dc-tab="overview">
        <svg class="dc__nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        {{ section.settings.tab_overview | default: 'Overview' }}
      </button>
      <button class="dc__nav-btn" type="button" data-dc-tab="orders">
        <svg class="dc__nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        {{ section.settings.tab_orders | default: 'Order History' }}
      </button>
      <button class="dc__nav-btn" type="button" data-dc-tab="invoices">
        <svg class="dc__nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        {{ section.settings.tab_invoices | default: 'Invoices' }}
      </button>
      <a class="dc__nav-btn" href="/pages/quick-reorder">
        <svg class="dc__nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
        {{ section.settings.tab_reorder | default: 'Quick Reorder' }}
      </a>
      <button class="dc__nav-btn" type="button" data-dc-tab="settings">
        <svg class="dc__nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        {{ section.settings.tab_settings | default: 'Settings' }}
      </button>
      <a class="dc__nav-btn dc__nav-btn--logout" href="/account/logout">
        <svg class="dc__nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        {{ section.settings.tab_logout | default: 'Sign out' }}
      </a>
    </nav>

    <!-- ── panels ──────────────────────────────────────── -->
    <div class="dc__panels">

      <!-- Overview panel -->
      <div class="dc__panel is-active" id="dc-panel-overview" role="tabpanel">

        <!-- stat cards -->
        <div class="dc__cards">

          <!-- discount tier -->
          <div class="dc__card">
            <p class="dc__card-label">{{ section.settings.label_tier | default: 'Discount Tier' }}</p>
            <p class="dc__card-value">
              {{ tier }}
              {%- if tier != '—' -%}
                <span class="dc__tier-badge">{{ disc_pct }}% off</span>
              {%- endif -%}
            </p>
            <p class="dc__card-sub">{{ section.settings.sub_tier | default: 'Your active wholesale rate' }}</p>
          </div>

          <!-- total purchases -->
          <div class="dc__card">
            <p class="dc__card-label">{{ section.settings.label_spent | default: 'Total Purchases' }}</p>
            <p class="dc__card-value">{{ customer.total_spent | money }}</p>
            <p class="dc__card-sub">{{ section.settings.sub_spent | default: 'Lifetime wholesale spend' }}</p>
          </div>

          <!-- orders count -->
          <div class="dc__card">
            <p class="dc__card-label">{{ section.settings.label_orders | default: 'Orders Placed' }}</p>
            <p class="dc__card-value">{{ customer.orders_count }}</p>
            <p class="dc__card-sub">{{ section.settings.sub_orders | default: 'All time' }}</p>
          </div>

        </div>

        <!-- recent orders -->
        <h2 class="dc__section-title">{{ section.settings.recent_orders_title | default: 'Recent Orders' }}</h2>

        <div class="dc__table-wrap">
          {%- if customer.orders.size > 0 -%}
            <div class="dc__table-scroll">
              <table class="dc__table">
                <thead>
                  <tr>
                    <th>{{ section.settings.col_order | default: 'Order' }}</th>
                    <th>{{ section.settings.col_po | default: 'PO Number' }}</th>
                    <th>{{ section.settings.col_date | default: 'Date' }}</th>
                    <th>{{ section.settings.col_status | default: 'Status' }}</th>
                    <th>{{ section.settings.col_total | default: 'Total' }}</th>
                    <th>{{ section.settings.col_actions | default: 'Actions' }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders limit: 5 -%}
                    {%- liquid
                      assign po_num   = order.attributes.po_number | default: '—'
                      assign fin_stat = order.financial_status
                      assign badge_mod = 'other'
                      if fin_stat == 'paid'
                        assign badge_mod = 'paid'
                      elsif fin_stat == 'pending' or fin_stat == 'authorized'
                        assign badge_mod = 'pending'
                      elsif fin_stat == 'refunded' or fin_stat == 'voided'
                        assign badge_mod = 'refunded'
                      endif

                      assign reorder_params = ''
                      for item in order.line_items
                        if forloop.first
                          assign sep = ''
                        else
                          assign sep = '&'
                        endif
                        assign reorder_params = reorder_params | append: sep | append: 'items[][id]=' | append: item.variant_id | append: '&items[][quantity]=' | append: item.quantity
                      endfor
                    -%}
                    <tr>
                      <td>
                        <a class="dc__order-link" href="{{ order.customer_url }}">{{ order.name }}</a>
                      </td>
                      <td>{{ po_num }}</td>
                      <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                      <td>
                        <span class="dc__badge dc__badge--{{ badge_mod }}">{{ fin_stat | replace: '_', ' ' }}</span>
                      </td>
                      <td>{{ order.total_price | money }}</td>
                      <td>
                        <div class="dc__btn-group">
                          <a class="dc__btn dc__btn--outline" href="{{ order.customer_url }}" aria-label="Invoice for {{ order.name }}">
                            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            {{ section.settings.btn_invoice | default: 'Invoice' }}
                          </a>
                          {%- if order.line_items.size > 0 -%}
                            <a class="dc__btn dc__btn--dark" href="/cart/add?{{ reorder_params }}" aria-label="Reorder {{ order.name }}">
                              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
                              {{ section.settings.btn_reorder | default: 'Reorder' }}
                            </a>
                          {%- endif -%}
                        </div>
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <div class="dc__empty">{{ section.settings.no_orders_text | default: "You haven't placed any orders yet." }}</div>
          {%- endif -%}
        </div>

        <!-- account manager -->
        {%- if mgr_name != blank -%}
          <div class="dc__mgr">
            <p class="dc__mgr-label">{{ section.settings.mgr_section_label | default: 'Your Account Manager' }}</p>
            <p class="dc__mgr-name">{{ mgr_name }}</p>
            <div class="dc__mgr-contact">
              {%- if mgr_email != blank -%}
                <a class="dc__mgr-link" href="mailto:{{ mgr_email }}">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  {{ mgr_email }}
                </a>
              {%- endif -%}
              {%- if mgr_phone != blank -%}
                <a class="dc__mgr-link" href="tel:{{ mgr_phone }}">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.47 2 2 0 0 1 3.6 1.29h3a2 2 0 0 1 2 1.72c.13 1 .37 1.97.71 2.91a2 2 0 0 1-.45 2.11L7.91 9.03a16 16 0 0 0 6 6l.96-.95a2 2 0 0 1 2.11-.45c.94.34 1.91.58 2.91.71A2 2 0 0 1 21.73 16.92z"/></svg>
                  {{ mgr_phone }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      </div>
      <!-- /overview -->

      <!-- Order History panel -->
      <div class="dc__panel" id="dc-panel-orders" role="tabpanel">
        <h2 class="dc__section-title">{{ section.settings.tab_orders | default: 'Order History' }}</h2>
        <div class="dc__table-wrap">
          {%- if customer.orders.size > 0 -%}
            <div class="dc__table-scroll">
              <table class="dc__table">
                <thead>
                  <tr>
                    <th>{{ section.settings.col_order | default: 'Order' }}</th>
                    <th>{{ section.settings.col_po | default: 'PO Number' }}</th>
                    <th>{{ section.settings.col_date | default: 'Date' }}</th>
                    <th>{{ section.settings.col_status | default: 'Status' }}</th>
                    <th>{{ section.settings.col_total | default: 'Total' }}</th>
                    <th>{{ section.settings.col_actions | default: 'Actions' }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    {%- liquid
                      assign po_num   = order.attributes.po_number | default: '—'
                      assign fin_stat = order.financial_status
                      assign badge_mod = 'other'
                      if fin_stat == 'paid'
                        assign badge_mod = 'paid'
                      elsif fin_stat == 'pending' or fin_stat == 'authorized'
                        assign badge_mod = 'pending'
                      elsif fin_stat == 'refunded' or fin_stat == 'voided'
                        assign badge_mod = 'refunded'
                      endif
                      assign reorder_params = ''
                      for item in order.line_items
                        if forloop.first
                          assign sep = ''
                        else
                          assign sep = '&'
                        endif
                        assign reorder_params = reorder_params | append: sep | append: 'items[][id]=' | append: item.variant_id | append: '&items[][quantity]=' | append: item.quantity
                      endfor
                    -%}
                    <tr>
                      <td><a class="dc__order-link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td>{{ po_num }}</td>
                      <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                      <td><span class="dc__badge dc__badge--{{ badge_mod }}">{{ fin_stat | replace: '_', ' ' }}</span></td>
                      <td>{{ order.total_price | money }}</td>
                      <td>
                        <div class="dc__btn-group">
                          <a class="dc__btn dc__btn--outline" href="{{ order.customer_url }}">
                            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            {{ section.settings.btn_invoice | default: 'Invoice' }}
                          </a>
                          {%- if order.line_items.size > 0 -%}
                            <a class="dc__btn dc__btn--dark" href="/cart/add?{{ reorder_params }}">
                              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
                              {{ section.settings.btn_reorder | default: 'Reorder' }}
                            </a>
                          {%- endif -%}
                        </div>
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <div class="dc__empty">{{ section.settings.no_orders_text | default: "You haven't placed any orders yet." }}</div>
          {%- endif -%}
        </div>
      </div>
      <!-- /orders -->

      <!-- Invoices placeholder panel -->
      <div class="dc__panel" id="dc-panel-invoices" role="tabpanel">
        <h2 class="dc__section-title">{{ section.settings.tab_invoices | default: 'Invoices' }}</h2>
        <div class="dc__table-wrap">
          {%- if customer.orders.size > 0 -%}
            <div class="dc__table-scroll">
              <table class="dc__table">
                <thead>
                  <tr>
                    <th>{{ section.settings.col_invoice | default: 'Invoice / Order' }}</th>
                    <th>{{ section.settings.col_po | default: 'PO Number' }}</th>
                    <th>{{ section.settings.col_date | default: 'Date' }}</th>
                    <th>{{ section.settings.col_status | default: 'Status' }}</th>
                    <th>{{ section.settings.col_total | default: 'Total' }}</th>
                    <th>{{ section.settings.col_actions | default: 'Actions' }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    {%- liquid
                      assign po_num   = order.attributes.po_number | default: '—'
                      assign fin_stat = order.financial_status
                      assign badge_mod = 'other'
                      if fin_stat == 'paid'
                        assign badge_mod = 'paid'
                      elsif fin_stat == 'pending' or fin_stat == 'authorized'
                        assign badge_mod = 'pending'
                      elsif fin_stat == 'refunded' or fin_stat == 'voided'
                        assign badge_mod = 'refunded'
                      endif
                    -%}
                    <tr>
                      <td><a class="dc__order-link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td>{{ po_num }}</td>
                      <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                      <td><span class="dc__badge dc__badge--{{ badge_mod }}">{{ fin_stat | replace: '_', ' ' }}</span></td>
                      <td>{{ order.total_price | money }}</td>
                      <td>
                        <a class="dc__btn dc__btn--outline" href="{{ order.customer_url }}">
                          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                          {{ section.settings.btn_download | default: 'Download' }}
                        </a>
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <div class="dc__empty">{{ section.settings.no_invoices_text | default: 'No invoices yet — they appear here after your first order.' }}</div>
          {%- endif -%}
        </div>
      </div>

      <!-- Settings panel -->
      <div class="dc__panel" id="dc-panel-settings" role="tabpanel">
        <h2 class="dc__section-title">{{ section.settings.tab_settings | default: 'Settings' }}</h2>

        <div class="dc__settings">
          <div class="dc__set-row">
            <div>
              <p class="dc__set-label">Account</p>
              <p class="dc__set-value">{{ customer.name | default: customer.email }}</p>
              <p class="dc__set-sub">{{ customer.email }}</p>
            </div>
          </div>

          {%- if company_name != blank -%}
            <div class="dc__set-row">
              <div>
                <p class="dc__set-label">Company</p>
                <p class="dc__set-value">{{ company_name }}</p>
              </div>
            </div>
          {%- endif -%}

          <div class="dc__set-row">
            <div>
              <p class="dc__set-label">Discount tier</p>
              <p class="dc__set-value">{{ tier | capitalize }}{% if disc_pct != '0' and disc_pct != blank %} · {{ disc_pct }}%{% endif %}</p>
            </div>
          </div>

          <div class="dc__set-actions">
            <a class="dc__btn dc__btn--outline" href="/account/addresses">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {{ section.settings.manage_addresses | default: 'Shipping addresses' }}
            </a>
            <a class="dc__btn dc__btn--dark" href="/account/logout">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              {{ section.settings.tab_logout | default: 'Sign out' }}
            </a>
          </div>

          <p class="dc__set-note">{{ section.settings.settings_note | default: 'To update your company details, VAT number or partnership terms, contact your account manager.' }}</p>
        </div>
      </div>

    </div>
    <!-- /panels -->

  </div>
</div>

<script>
(function () {
  if (window.lpDcReady) return;
  window.lpDcReady = true;

  var btns   = document.querySelectorAll('[data-dc-tab]');
  var panels = document.querySelectorAll('.dc__panel');

  function activate(target, syncUrl) {
    var panel = document.getElementById('dc-panel-' + target);
    if (!panel) return;

    btns.forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-dc-tab') === target);
    });
    panels.forEach(function (p) { p.classList.remove('is-active'); });
    panel.classList.add('is-active');

    if (syncUrl && window.history && history.replaceState) {
      var url = new URL(window.location.href);
      if (target === 'overview') url.searchParams.delete('tab');
      else url.searchParams.set('tab', target);
      history.replaceState(null, '', url);
    }
  }

  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      activate(btn.getAttribute('data-dc-tab'), true);
    });
  });

  /* Deep links: /pages/partner-dashboard?tab=invoices (D-02) */
  var initial = new URLSearchParams(window.location.search).get('tab');
  if (initial) activate(initial, false);
})();
</script>

{%- endunless -%}

