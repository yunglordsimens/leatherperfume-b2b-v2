{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' dc--high-contrast'
  endif

  assign discount_tier = customer.metafields.custom.discount_tier | default: 'Standard'
  assign manager_name  = section.settings.manager_name  | default: 'Account Manager'
  assign manager_email = section.settings.manager_email | default: ''
  assign manager_phone = section.settings.manager_phone | default: ''
-%}

<style>
  /* ── Shell ─────────────────────────────────────────── */
  .dc {
    background-color: #f5f5f4;
    padding: 2rem 1.5rem;
    min-height: 60vh;
  }

  @media screen and (min-width: 990px) {
    .dc { padding: 3rem 2.5rem; }
  }

  .dc__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .dc__inner {
      grid-template-columns: 240px 1fr;
      align-items: start;
      gap: 2rem;
    }
  }

  /* ── Sidebar / nav ─────────────────────────────────── */
  .dc__sidebar {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    overflow: hidden;
  }

  @media screen and (min-width: 990px) {
    .dc__sidebar {
      position: sticky;
      top: 9rem;
    }
  }

  .dc__nav {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 0;
  }

  .dc__nav::-webkit-scrollbar { display: none; }

  @media screen and (min-width: 990px) {
    .dc__nav { flex-direction: column; }
  }

  .dc__nav-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 500;
    color: #78716c;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    text-align: left;
    width: auto;
  }

  @media screen and (min-width: 990px) {
    .dc__nav-btn {
      width: 100%;
      padding: 0.9rem 1.25rem;
      border-bottom: none;
      border-left: 3px solid transparent;
    }
  }

  .dc__nav-btn:hover {
    color: #1c1917;
    background-color: #fafaf9;
  }

  .dc__nav-btn.is-active {
    color: #b45309;
    font-weight: 700;
    background-color: #fffbeb;
    border-bottom-color: #b45309;
  }

  @media screen and (min-width: 990px) {
    .dc__nav-btn.is-active {
      border-bottom-color: transparent;
      border-left-color: #b45309;
    }
  }

  .dc--high-contrast .dc__nav-btn.is-active,
  html.a11y-high-contrast .dc__nav-btn.is-active {
    color: #000000;
    background-color: #f0f0f0;
    border-left-color: #000000;
    border-bottom-color: #000000;
  }

  .dc__nav-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  /* ── Main panel ────────────────────────────────────── */
  .dc__panel {
    display: none;
  }

  .dc__panel.is-active {
    display: block;
  }

  /* ── Cards grid (overview) ─────────────────────────── */
  .dc__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media screen and (min-width: 600px) {
    .dc__cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (min-width: 1200px) {
    .dc__cards { grid-template-columns: repeat(3, 1fr); }
  }

  .dc__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
  }

  .dc--high-contrast .dc__card,
  html.a11y-high-contrast .dc__card {
    border: 2px solid #000000;
  }

  .dc__card-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a8a29e;
    margin: 0 0 0.5rem;
  }

  .dc__card-value {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    color: #1c1917;
    margin: 0 0 0.25rem;
  }

  .dc__card-sub {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    color: #a8a29e;
    margin: 0;
  }

  .dc__card--tier .dc__card-value { color: #b45309; }

  html.a11y-high-contrast .dc__card-value,
  html.a11y-high-contrast .dc__card--tier .dc__card-value {
    color: #000000;
  }

  /* Manager card */
  .dc__card--manager {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dc__manager-name {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1c1917;
    margin: 0;
  }

  html.a11y-high-contrast .dc__manager-name { color: #000000; }

  .dc__manager-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    color: #b45309;
    text-decoration: none;
  }

  .dc__manager-link:hover { text-decoration: underline; }

  html.a11y-high-contrast .dc__manager-link { color: #000000; }

  /* ── Section heading ───────────────────────────────── */
  .dc__section-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.125rem;
    color: #1c1917;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e7e5e4;
  }

  html.a11y-high-contrast .dc__section-heading {
    color: #000000;
    border-bottom-color: #000000;
  }

  /* ── Orders table ──────────────────────────────────── */
  .dc__orders-wrap {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    overflow: hidden;
  }

  .dc--high-contrast .dc__orders-wrap,
  html.a11y-high-contrast .dc__orders-wrap {
    border: 2px solid #000000;
  }

  .dc__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
  }

  .dc__table thead {
    background-color: #fafaf9;
  }

  .dc__table th {
    padding: 0.875rem 1.25rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #78716c;
    border-bottom: 1px solid #e7e5e4;
    white-space: nowrap;
  }

  html.a11y-high-contrast .dc__table th {
    color: #000000;
    border-bottom-color: #000000;
  }

  .dc__table td {
    padding: 1rem 1.25rem;
    color: #1c1917;
    border-bottom: 1px solid #f5f5f4;
    vertical-align: middle;
  }

  html.a11y-high-contrast .dc__table td {
    color: #000000;
    border-bottom-color: #cccccc;
  }

  .dc__table tr:last-child td { border-bottom: none; }

  .dc__table tbody tr:hover { background-color: #fafaf9; }

  /* Mobile responsive table */
  @media screen and (max-width: 749px) {
    .dc__table thead { display: none; }

    .dc__table tbody tr {
      display: block;
      padding: 0.875rem 1.25rem;
      border-bottom: 1px solid #e7e5e4;
    }

    .dc__table tbody tr:last-child { border-bottom: none; }

    .dc__table td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.25rem 0;
      border-bottom: none;
      font-size: 0.875rem;
    }

    .dc__table td::before {
      content: attr(data-label);
      font-weight: 700;
      font-size: 0.75rem;
      color: #78716c;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-right: 0.5rem;
      flex-shrink: 0;
    }
  }

  /* Status badge */
  .dc__badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 999px;
    text-transform: capitalize;
  }

  .dc__badge--paid {
    background-color: #dcfce7;
    color: #15803d;
  }

  .dc__badge--pending,
  .dc__badge--unpaid {
    background-color: #fef3c7;
    color: #92400e;
  }

  .dc__badge--refunded,
  .dc__badge--voided {
    background-color: #fee2e2;
    color: #dc2626;
  }

  html.a11y-high-contrast .dc__badge {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 1px solid #ffffff;
  }

  /* Order link */
  .dc__order-link {
    color: #b45309;
    text-decoration: none;
    font-weight: 600;
  }

  .dc__order-link:hover { text-decoration: underline; }

  html.a11y-high-contrast .dc__order-link { color: #000000; }

  /* Empty state */
  .dc__empty {
    padding: 3rem 1.5rem;
    text-align: center;
    color: #78716c;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
  }

  /* ── Placeholder panels ────────────────────────────── */
  .dc__placeholder {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1rem;
    padding: 3rem 2rem;
    text-align: center;
  }

  .dc__placeholder-icon {
    width: 3rem;
    height: 3rem;
    color: #d6d3d1;
    margin: 0 auto 1rem;
  }

  .dc__placeholder-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.125rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }

  .dc__placeholder-text {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #78716c;
    margin: 0 0 1.5rem;
  }

  .dc__placeholder-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .dc__placeholder-btn:hover {
    background-color: #b45309;
    border-color: #b45309;
    color: #ffffff;
  }

  html.a11y-high-contrast .dc__placeholder-btn {
    background-color: #000000;
    border-color: #000000;
  }
</style>

<div class="dc{{ section_mod }}" id="DashboardContent-{{ section.id }}">
  <div class="dc__inner">

    <!-- Sidebar / Nav -->
    <nav class="dc__sidebar" aria-label="Dashboard navigation">
      <div class="dc__nav" role="tablist">
        <button
          class="dc__nav-btn is-active"
          role="tab"
          aria-selected="true"
          aria-controls="DcPanel-overview-{{ section.id }}"
          data-dc-tab="overview"
          id="DcTab-overview-{{ section.id }}"
        >
          <svg class="dc__nav-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
          </svg>
          Overview
        </button>

        <button
          class="dc__nav-btn"
          role="tab"
          aria-selected="false"
          aria-controls="DcPanel-orders-{{ section.id }}"
          data-dc-tab="orders"
          id="DcTab-orders-{{ section.id }}"
        >
          <svg class="dc__nav-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
          </svg>
          Orders
        </button>

        <button
          class="dc__nav-btn"
          role="tab"
          aria-selected="false"
          aria-controls="DcPanel-invoices-{{ section.id }}"
          data-dc-tab="invoices"
          id="DcTab-invoices-{{ section.id }}"
        >
          <svg class="dc__nav-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          Invoices
        </button>

        <button
          class="dc__nav-btn"
          role="tab"
          aria-selected="false"
          aria-controls="DcPanel-settings-{{ section.id }}"
          data-dc-tab="settings"
          id="DcTab-settings-{{ section.id }}"
        >
          <svg class="dc__nav-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Settings
        </button>
      </div>
    </nav>

    <!-- Main content -->
    <div class="dc__main">

      <!-- ── Overview tab ──────────────────────────────── -->
      <div
        class="dc__panel is-active"
        id="DcPanel-overview-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="DcTab-overview-{{ section.id }}"
      >
        <div class="dc__cards">

          <!-- Discount Tier -->
          <div class="dc__card dc__card--tier">
            <p class="dc__card-label">Discount Tier</p>
            <p class="dc__card-value">{{ discount_tier }}</p>
            <p class="dc__card-sub">Up to 40% off RRP</p>
          </div>

          <!-- YTD Purchases -->
          <div class="dc__card">
            <p class="dc__card-label">{{ section.settings.total_spent_label | default: 'Total Purchases' }}</p>
            <p class="dc__card-value">{{ customer.total_spent | money }}</p>
            <p class="dc__card-sub">Lifetime value</p>
          </div>

          <!-- Account Manager -->
          <div class="dc__card dc__card--manager">
            <p class="dc__card-label">Account Manager</p>
            <p class="dc__manager-name">{{ manager_name }}</p>
            {%- if manager_email != blank -%}
              <a href="mailto:{{ manager_email }}" class="dc__manager-link">
                <svg style="width:0.875rem;height:0.875rem;flex-shrink:0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                {{ manager_email }}
              </a>
            {%- endif -%}
            {%- if manager_phone != blank -%}
              <a href="tel:{{ manager_phone }}" class="dc__manager-link">
                <svg style="width:0.875rem;height:0.875rem;flex-shrink:0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                {{ manager_phone }}
              </a>
            {%- endif -%}
          </div>

        </div><!-- /.dc__cards -->

        <!-- Recent Orders -->
        <h2 class="dc__section-heading">Recent Orders</h2>

        <div class="dc__orders-wrap">
          {%- if customer.orders.size > 0 -%}
            <table class="dc__table">
              <thead>
                <tr>
                  <th scope="col">Order</th>
                  <th scope="col">Date</th>
                  <th scope="col">Status</th>
                  <th scope="col">Total</th>
                  <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders limit: 5 -%}
                  {%- assign status_lower = order.financial_status | downcase -%}
                  <tr>
                    <td data-label="Order">
                      <a href="{{ order.customer_url }}" class="dc__order-link">{{ order.name }}</a>
                    </td>
                    <td data-label="Date">{{ order.created_at | date: "%b %d, %Y" }}</td>
                    <td data-label="Status">
                      <span class="dc__badge dc__badge--{{ status_lower }}">{{ order.financial_status_label }}</span>
                    </td>
                    <td data-label="Total">{{ order.total_price | money }}</td>
                    <td>
                      <a href="{{ order.customer_url }}" class="dc__order-link" aria-label="View order {{ order.name }}">View</a>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <div class="dc__empty">No orders yet. Place your first order to get started.</div>
          {%- endif -%}
        </div><!-- /.dc__orders-wrap -->

      </div><!-- /#DcPanel-overview -->

      <!-- ── Orders tab ────────────────────────────────── -->
      <div
        class="dc__panel"
        id="DcPanel-orders-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="DcTab-orders-{{ section.id }}"
      >
        <h2 class="dc__section-heading">All Orders</h2>
        <div class="dc__orders-wrap">
          {%- if customer.orders.size > 0 -%}
            <table class="dc__table">
              <thead>
                <tr>
                  <th scope="col">Order</th>
                  <th scope="col">Date</th>
                  <th scope="col">Status</th>
                  <th scope="col">Total</th>
                  <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  {%- assign status_lower = order.financial_status | downcase -%}
                  <tr>
                    <td data-label="Order">
                      <a href="{{ order.customer_url }}" class="dc__order-link">{{ order.name }}</a>
                    </td>
                    <td data-label="Date">{{ order.created_at | date: "%b %d, %Y" }}</td>
                    <td data-label="Status">
                      <span class="dc__badge dc__badge--{{ status_lower }}">{{ order.financial_status_label }}</span>
                    </td>
                    <td data-label="Total">{{ order.total_price | money }}</td>
                    <td>
                      <a href="{{ order.customer_url }}" class="dc__order-link" aria-label="View order {{ order.name }}">View</a>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <div class="dc__empty">No orders yet.</div>
          {%- endif -%}
        </div>
      </div><!-- /#DcPanel-orders -->

      <!-- ── Invoices tab ──────────────────────────────── -->
      <div
        class="dc__panel"
        id="DcPanel-invoices-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="DcTab-invoices-{{ section.id }}"
      >
