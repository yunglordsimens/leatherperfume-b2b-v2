{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' editorial--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Editorial / Heritage — inline section styles
     ================================================ */

  .editorial {
    padding: 6rem 0;
    background-color: #ffffff;
    overflow: hidden;
  }

  .editorial__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .editorial__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Text column ───────────────────────────── */

  .editorial__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.25rem, 5vw, 3rem);
    line-height: 1.15;
    margin: 0 0 2rem;
    color: #1c1917;
  }

  @media screen and (min-width: 750px) {
    .editorial__heading {
      font-size: clamp(2.75rem, 6vw, 3.75rem);
    }
  }

  .editorial--high-contrast .editorial__heading {
    color: #000000;
  }

  .editorial__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-size: 1rem;
    line-height: 1.65;
    color: #57534e;
    margin-bottom: 2.5rem;
  }

  .editorial--high-contrast .editorial__body {
    color: #000000;
    font-weight: 500;
  }

  .editorial__body p {
    margin: 0;
  }

  /* ── Checklist ─────────────────────────────── */

  .editorial__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .editorial__check-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 1.125rem;
    color: #1c1917;
  }

  .editorial--high-contrast .editorial__check-item {
    color: #000000;
  }

  .editorial__check-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: #16a34a;
  }

  .editorial--high-contrast .editorial__check-icon {
    color: #000000;
  }

  /* ── Media column ──────────────────────────── */

  .editorial__media {
    position: relative;
    height: 400px;
    order: -1;
  }

  @media screen and (min-width: 750px) {
    .editorial__media {
      height: 600px;
    }
  }

  @media screen and (min-width: 990px) {
    .editorial__media {
      order: 0;
    }
  }

  /* Decorative amber shadow (default mode only) */
  .editorial__shadow-decor {
    position: absolute;
    top: 2rem;
    left: 2rem;
    width: 100%;
    height: 100%;
    background-color: rgba(180, 83, 9, 0.1);
    border-radius: 0.5rem;
    z-index: 0;
  }

  /* Main image frame */
  .editorial__image-frame {
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    z-index: 1;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .editorial--high-contrast .editorial__image-frame {
    border: 4px solid #000000;
    background-color: #ffffff;
  }

  .editorial__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .editorial__placeholder-icon {
    width: 4rem;
    height: 4rem;
    color: #a8a29e;
  }

  .editorial--high-contrast .editorial__placeholder-icon {
    color: #000000;
  }

  @media screen and (max-width: 989px) {
    .editorial__body { font-size: 1.15rem; }
  }
</style>

<section
  class="editorial{{ section_mod }}"
  id="Editorial-{{ section.id }}"
>
  <div class="editorial__container">

    {%- comment -%} ── Text column ── {%- endcomment -%}
    <div class="editorial__content">

      {%- if section.settings.heading != blank -%}
        <h2 class="editorial__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="editorial__body">
        {%- if section.settings.paragraph_1 != blank -%}
          {{ section.settings.paragraph_1 }}
        {%- endif -%}
        {%- if section.settings.paragraph_2 != blank -%}
          {{ section.settings.paragraph_2 }}
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="editorial__checklist" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="editorial__check-item" {{ block.shopify_attributes }}>
                <svg class="editorial__check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                {{ block.settings.text | escape }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>

    {%- comment -%} ── Media column ── {%- endcomment -%}
    <div class="editorial__media">
      {%- unless high_contrast -%}
        <div class="editorial__shadow-decor" aria-hidden="true"></div>
      {%- endunless -%}

      <div class="editorial__image-frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'editorial__image',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw'
          }}
        {%- else -%}
          <svg class="editorial__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% render 'accessibility-panel' %}

{% schema %}
{
  "name": "Editorial / Heritage",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "info": "Thicker borders, black icons, heavier text weight.",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made to be a bestseller."
    },
    {
      "type": "richtext",
      "id": "paragraph_1",
      "label": "First paragraph",
      "default": "<p>Leather Parfum is more than just fragrance. It is an anchor product for your retail business. We use the highest quality ingredients to create lasting, memorable compositions that keep clients coming back.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_2",
      "label": "Second paragraph",
      "default": "<p>Every bottle and leather item comes in premium packaging designed to look stunning on the shelves of boutiques and concept stores. We provide our partners with all necessary marketing materials for visual merchandising.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "Checklist item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": "Feature or benefit"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Editorial / Heritage",
      "blocks": [
        {
          "type": "checklist_item",
          "settings": {
            "text": "European quality certification"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "text": "Full-size testers for retail partners"
          }
        }
      ]
    }
  ]
}
{% endschema %}
