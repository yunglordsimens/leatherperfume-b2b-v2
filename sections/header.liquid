{%- comment -%}
  ============================================
  LP B2B CUSTOM HEADER (based on Dawn 13+)
  ============================================
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  @media screen and (min-width: 990px) {
    header-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
  .header__lp-nav {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  /* ================================================
     LP CUSTOM STYLES (overrides Dawn)
     ================================================ */
  .header-wrapper {
    background-color: #ffffff !important;
    border-bottom: 1px solid #e7e5e4 !important;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.06) !important;
  }

  /* Скрываем стандартное меню Dawn на десктопе */
  @media screen and (min-width: 990px) {
    .header__inline-menu,
    .header__menu,
    .header__submenu {
      display: none !important;
    }

    .header__lp-nav {
      display: flex !important;
      align-items: stretch;
      grid-area: navigation;
      height: 100%;
    }
  }

  /* LP Desktop nav */
  .lp-nav {
    display: flex;
    align-items: stretch;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
  }

  .lp-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .lp-nav__link,
  .lp-nav__btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0.875rem;
    height: 100%;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    text-decoration: none;
    color: #1c1917;
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .lp-nav__link:hover,
  .lp-nav__btn:hover,
  .lp-nav__link[aria-current="page"] {
    color: #b45309;
  }

  .lp-nav__chevron {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .lp-nav__item--catalog:hover .lp-mega,
  .lp-nav__item--catalog:focus-within .lp-mega {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .lp-nav__item--catalog:hover .lp-nav__chevron,
  .lp-nav__item--catalog:focus-within .lp-nav__chevron {
    transform: rotate(180deg);
  }

  .lp-nav__item--catalog:hover .lp-nav__btn {
    color: #b45309;
  }

  /* Mega menu */
  .lp-mega {
    position: absolute;
    top: 100%;
    left: 0;
    width: 44rem;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-top: none;
    border-radius: 0 0 1rem 1rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.18);
    z-index: 100;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .lp-mega__col-heading {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #1c1917;
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e7e5e4;
  }

  .lp-mega__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lp-mega__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 500;
    text-transform: none;
    letter-spacing: normal;
    color: #78716c;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lp-mega__link:hover {
    color: #b45309;
  }

  .lp-mega__link-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: #a8a29e;
  }

  .lp-mega__divider {
    grid-column: 1 / -1;
    height: 1px;
    background-color: #f5f5f4;
    border: none;
    margin: 0.5rem 0 0;
  }

  .lp-mega__cta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border-radius: 0.75rem;
    background-color: #f5f5f4;
    color: #1c1917;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lp-mega__cta:hover {
    background-color: #e7e5e4;
    color: #1c1917;
  }

  /* Language switcher */
  .header-lang {
    position: relative;
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header-lang {
      display: block;
    }
  }

  .header-lang__trigger {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    border: none;
    background: none;
    cursor: pointer;
    color: #1c1917;
    transition: color 0.15s ease;
  }

  .header-lang__trigger:hover {
    color: #b45309;
  }

  .header-lang__flag {
    font-size: 1.125rem;
    line-height: 1;
  }

  .header-lang__chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .header-lang:hover .header-lang__chevron {
    transform: rotate(180deg);
  }

  .header-lang__dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 9rem;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 100;
  }

  .header-lang:hover .header-lang__dropdown,
  .header-lang:focus-within .header-lang__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .header-lang__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    color: #1c1917;
    transition: background-color 0.15s ease;
    text-decoration: none;
    font-family: var(--font-body-family);
  }

  .header-lang__option:hover {
    background-color: #f5f5f4;
  }

  /* Accessibility button in header */
  .header__icon--a11y {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.75rem;
    background-color: #f5f5f4;
    border: none;
    cursor: pointer;
    color: #1c1917;
    transition: background-color 0.15s ease;
    font-family: var(--font-body-family);
    flex-shrink: 0;
  }

  .header__icon--a11y:hover {
    background-color: #e7e5e4;
  }

  .header__icon--a11y svg {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* High contrast overrides */
  html.a11y-high-contrast .header-wrapper {
    background-color: #ffffff !important;
    border-bottom: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  html.a11y-high-contrast .lp-mega {
    border: 4px solid #000000 !important;
    border-top: none !important;
    box-shadow: none !important;
  }

  html.a11y-high-contrast .header-lang__dropdown {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  html.a11y-high-contrast .header__icon--a11y {
    background-color: transparent !important;
    border: 2px solid #000000 !important;
  }

  html.a11y-high-contrast .lp-mega__cta {
    background-color: #000000 !important;
    color: #ffffff !important;
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

<sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}" class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %} header--has-localizations{% endif %}">

    {%- if section.settings.menu != blank -%}
      {% render 'header-drawer' %}
    {%- endif -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
{%- if settings.logo != blank -%}
  <div class="header__heading-logo-wrapper">
    {%- assign logo_width = settings.logo.width -%}
    {%- assign logo_height = logo_width | divided_by: settings.logo.aspect_ratio | round -%}
    <img
      src="{{ settings.logo | image_url: width: 600 }}"
      srcset="{{ settings.logo | image_url: width: 200 }} 200w,
              {{ settings.logo | image_url: width: 300 }} 300w,
              {{ settings.logo | image_url: width: 400 }} 400w,
              {{ settings.logo | image_url: width: 500 }} 500w,
              {{ settings.logo | image_url: width: 600 }} 600w"
      sizes="(max-width: 600px) 200px, 600px"
      alt="{{ settings.logo.alt | default: shop.name | escape }}"
      width="{{ logo_width }}"
      height="{{ logo_height }}"
      class="header__heading-logo motion-reduce"
      loading="eager"
    >
  </div>
{%- else -%}
  <span class="h2">{{ shop.name }}</span>
{%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ===== LP CUSTOM DESKTOP NAV ===== {%- endcomment -%}
    {%- if section.settings.menu != blank -%}
      <nav class="header__lp-nav small-hide medium-hide" aria-label="Main navigation">
        <ul class="lp-nav" role="list">
          {%- for link in section.settings.menu.links -%}
            {%- liquid
              assign is_catalog = false
              if link.title == 'Catalog' or link.title == 'Katalog' or link.handle == 'catalog' or link.handle == 'katalog'
                assign is_catalog = true
              endif
            -%}

            {%- if is_catalog -%}
              <li class="lp-nav__item lp-nav__item--catalog">
                <button class="lp-nav__btn" type="button" aria-haspopup="true" aria-expanded="false">
                  {{ link.title | escape }}
                  <svg class="lp-nav__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>

                <div class="lp-mega" role="region" aria-label="{{ link.title | escape }} menu">
                  <div class="lp-mega__col">
                    {%- assign col1 = link.links[0] -%}
                    <p class="lp-mega__col-heading">
                      {%- if col1 != blank -%}{{ col1.title | escape }}{%- else -%}Perfumes{%- endif -%}
                    </p>
                    <ul class="lp-mega__links" role="list">
                      {%- if col1 != blank and col1.links.size > 0 -%}
                        {%- for sub in col1.links -%}
                          <li><a href="{{ sub.url }}" class="lp-mega__link">{{ sub.title | escape }}</a></li>
                        {%- endfor -%}
                      {%- else -%}
                        <li><a href="/collections/all" class="lp-mega__link">All Fragrances</a></li>
                        <li><a href="/collections/women" class="lp-mega__link">Women's Collection</a></li>
                        <li><a href="/collections/men" class="lp-mega__link">Men's Collection</a></li>
                      {%- endif -%}
                    </ul>
                  </div>

                  <div class="lp-mega__col">
                    {%- assign col2 = link.links[1] -%}
                    <p class="lp-mega__col-heading">
                      {%- if col2 != blank -%}{{ col2.title | escape }}{%- else -%}Leather Goods{%- endif -%}
                    </p>
                    <ul class="lp-mega__links" role="list">
                      {%- if col2 != blank and col2.links.size > 0 -%}
                        {%- for sub in col2.links -%}
                          <li><a href="{{ sub.url }}" class="lp-mega__link">{{ sub.title | escape }}</a></li>
                        {%- endfor -%}
                      {%- else -%}
                        <li><a href="/collections/leather-goods" class="lp-mega__link">All Leather Goods</a></li>
                        <li><a href="/collections/belts" class="lp-mega__link">Premium Belts</a></li>
                        <li><a href="/collections/wallets" class="lp-mega__link">Wallets & Purses</a></li>
                      {%- endif -%}
                    </ul>
                  </div>

                  <hr class="lp-mega__divider">
                  <a href="{{ link.url | default: '/collections/all' }}" class="lp-mega__cta">
                    View Full Catalog
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                </div>
              </li>
            {%- else -%}
              <li class="lp-nav__item">
                <a href="{{ link.url }}" class="lp-nav__link"{% if link.active %} aria-current="page"{% endif %}>
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

{%- if section.settings.logo_position == 'middle-center' -%}
  <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
    {%- if settings.logo != blank -%}
      <div class="header__heading-logo-wrapper">
        {%- assign logo_width = settings.logo.width -%}
        {%- assign logo_height = logo_width | divided_by: settings.logo.aspect_ratio | round -%}
        <img
          src="{{ settings.logo | image_url: width: 600 }}"
          srcset="{{ settings.logo | image_url: width: 200 }} 200w,
                  {{ settings.logo | image_url: width: 300 }} 300w,
                  {{ settings.logo | image_url: width: 400 }} 400w,
                  {{ settings.logo | image_url: width: 500 }} 500w,
                  {{ settings.logo | image_url: width: 600 }} 600w"
          sizes="(max-width: 600px) 200px, 600px"
          alt="{{ settings.logo.alt | default: shop.name | escape }}"
          width="{{ logo_width }}"
          height="{{ logo_height }}"
          class="header__heading-logo motion-reduce"
          loading="eager"
        >
      </div>
    {%- else -%}
      <span class="h2">{{ shop.name }}</span>
    {%- endif -%}
  </a>
{%- endif -%}

    <div class="header__icons{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if localization.available_countries.size > 1 and section.settings.enable_country_selector -%}
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>{%- render 'country-localization', localPosition: 'HeaderCountry' -%}</div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if localization.available_languages.size > 1 and section.settings.enable_language_selector -%}
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>{%- render 'language-localization', localPosition: 'HeaderLanguage' -%}</div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      {% render 'header-search', input_id: 'Search-In-Modal' %}

      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}" rel="nofollow">
          {%- render 'icon-account' -%}
          <span class="visually-hidden">{%- if customer -%}Account{%- else -%}Log in{%- endif -%}</span>
        </a>
      {%- endif -%}

      {%- comment -%}── LP: Language switcher (custom) ──{%- endcomment -%}
      <div class="header-lang">
        {%- assign locale_code = request.locale.iso_code | downcase -%}
        {%- if locale_code == 'cs' -%}
          {%- assign current_flag = '🇨🇿' -%}{%- assign current_label = 'CS' -%}
        {%- elsif locale_code == 'vi' -%}
          {%- assign current_flag = '🇻🇳' -%}{%- assign current_label = 'VI' -%}
        {%- else -%}
          {%- assign current_flag = '🇬🇧' -%}{%- assign current_label = 'EN' -%}
        {%- endif -%}
        <button class="header-lang__trigger" type="button" aria-haspopup="listbox">
          <span class="header-lang__flag">{{ current_flag }}</span>
          <span>{{ current_label }}</span>
          <svg class="header-lang__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="header-lang__dropdown" role="listbox">
          <a href="?locale=en" class="header-lang__option">English <span>🇬🇧</span></a>
          <a href="?locale=cs" class="header-lang__option">Čeština <span>🇨🇿</span></a>
          <a href="?locale=vi" class="header-lang__option">Tiếng Việt <span>🇻🇳</span></a>
        </div>
      </div>

      {%- comment -%}── LP: Accessibility button in header ──{%- endcomment -%}
      <button id="open-accessibility" class="header__icon header__icon--a11y focus-inset" type="button" aria-label="Accessibility settings" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="12" cy="5" r="1.5"/><path d="M5 10h14"/><path d="M12 10v12"/><path d="M8 22l4-6 4 6"/>
        </svg>
      </button>

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {%- render 'icon-cart-empty' -%}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            <span aria-hidden="true">{{ cart.item_count }}</span>
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</sticky-header>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always' || this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      };

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => this.preventReveal = true;

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach(disclosure => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

