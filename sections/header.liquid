{% javascript %}
(function () {
  if (window.lpMegaReady) return;
  window.lpMegaReady = true;

  /* Mega menu is CSS hover-based; this only handles keyboard (Escape to close) */
  function init() {
    var items = document.querySelectorAll('.lp-nav__item--catalog');
    if (!items.length) return;

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      items.forEach(function (item) {
        var btn = item.querySelector('.lp-nav__btn');
        if (btn) btn.blur();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
{% endjavascript %}

