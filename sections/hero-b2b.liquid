{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' hero-b2b--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Hero B2B — inline section styles
     ================================================ */

  .hero-b2b {
    position: relative;
    overflow: hidden;
    background-color: #1c1917;
  }

  .hero-b2b--high-contrast {
    background-color: #ffffff;
    border-bottom: 4px solid #000000;
  }

  /* Decorative blur orb (dark mode only) */
  .hero-b2b__orb {
    position: absolute;
    top: 0;
    right: 0;
    width: 800px;
    height: 800px;
    background-color: rgba(120, 53, 15, 0.2);
    border-radius: 50%;
    filter: blur(64px);
    transform: translateY(-50%) translateX(33%);
    pointer-events: none;
  }

  /* Container */
  .hero-b2b__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media screen and (min-width: 990px) {
    .hero-b2b__container {
      grid-template-columns: 7fr 5fr;
      gap: 2rem;
      padding: 8rem 1.5rem;
    }
  }

  /* Content column */
  .hero-b2b__content {
    order: 2;
  }

  @media screen and (min-width: 990px) {
    .hero-b2b__content {
      order: 1;
    }
  }

  /* Badge */
  .hero-b2b__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    border-radius: 0.375rem;
    margin-bottom: 2rem;
    background-color: #292524;
    color: #f59e0b;
  }

  .hero-b2b--high-contrast .hero-b2b__badge {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .hero-b2b__badge-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Heading */
  .hero-b2b__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 1.1;
    margin: 0 0 2rem;
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .hero-b2b__heading {
      font-size: clamp(3.75rem, 8vw, 6rem);
    }
  }

  @media screen and (min-width: 990px) {
    .hero-b2b__heading {
      font-size: clamp(4.5rem, 7vw, 7rem);
    }
  }

  .hero-b2b--high-contrast .hero-b2b__heading {
    color: #000000;
    font-weight: 900;
  }

  /* Subheading */
  .hero-b2b__subheading {
    margin: 0 0 3rem;
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.65;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    color: #d6d3d1;
  }

  .hero-b2b--high-contrast .hero-b2b__subheading {
    color: #000000;
    font-weight: 500;
  }

  .hero-b2b__subheading p {
    margin: 0;
  }

  /* Button group */
  .hero-b2b__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media screen and (min-width: 600px) {
    .hero-b2b__buttons {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  /* Base button */
  .hero-b2b__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem 2rem;
    border-radius: 0.75rem;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  /* Primary button */
  .hero-b2b__btn--primary {
    background-color: #f59e0b;
    color: #1c1917;
  }

  .hero-b2b__btn--primary:hover {
    background-color: #fbbf24;
    color: #1c1917;
  }

  .hero-b2b--high-contrast .hero-b2b__btn--primary {
    background-color: #000000;
    color: #ffffff;
  }

  .hero-b2b--high-contrast .hero-b2b__btn--primary:hover {
    background-color: #292524;
  }

  /* Secondary button */
  .hero-b2b__btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #57534e;
  }

  .hero-b2b__btn--secondary:hover {
    background-color: #292524;
    color: #ffffff;
  }

  .hero-b2b--high-contrast .hero-b2b__btn--secondary {
    color: #000000;
    border: 4px solid #000000;
  }

  .hero-b2b--high-contrast .hero-b2b__btn--secondary:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .hero-b2b__btn-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* Media column */
  .hero-b2b__media {
    order: 1;
    display: flex;
    justify-content: center;
  }

  @media screen and (min-width: 990px) {
    .hero-b2b__media {
      order: 2;
      justify-content: flex-end;
    }
  }

  .hero-b2b__image-frame {
    position: relative;
    width: 100%;
    max-width: 28rem;
    aspect-ratio: 4 / 5;
    border-radius: 1rem;
    overflow: hidden;
    background-color: #292524;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
  }

  .hero-b2b--high-contrast .hero-b2b__image-frame {
    border: 4px solid #000000;
    background-color: #ffffff;
    box-shadow: none;
  }

  .hero-b2b__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Image placeholder */
  .hero-b2b__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-b2b__placeholder-icon {
    width: 6rem;
    height: 6rem;
    color: #57534e;
  }

  .hero-b2b--high-contrast .hero-b2b__placeholder-icon {
    color: #000000;
  }

  .hero-b2b__placeholder-label {
    font-family: var(--font-body-family);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.875rem;
    color: #78716c;
    border-bottom: 1px solid #57534e;
    padding-bottom: 0.5rem;
  }

  .hero-b2b--high-contrast .hero-b2b__placeholder-label {
    color: #000000;
    border-color: #000000;
  }

  @media screen and (max-width: 989px) {
    .hero-b2b__badge { font-size: 0.9rem; }
    .hero-b2b__subheading { font-size: 1.25rem; }
    .hero-b2b__placeholder-label { font-size: 1rem; }
  }
</style>

{% render 'accessibility-panel' %}

<section
  class="hero-b2b{{ section_mod }}"
  id="HeroB2B-{{ section.id }}"
  aria-label="{{ section.settings.heading | strip_html | escape }}"
>

  {%- unless high_contrast -%}
    <div class="hero-b2b__orb" aria-hidden="true"></div>
  {%- endunless -%}

  <div class="hero-b2b__container">

    {%- comment -%} ── Content column ── {%- endcomment -%}
    <div class="hero-b2b__content">

      {%- if customer and customer.tags contains 'wholesale' -%}
        <div class="hero-b2b__badge">
          <svg class="hero-b2b__badge-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          {{ section.settings.member_badge | default: 'Welcome back' | escape }}{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}
        </div>
      {%- elsif section.settings.badge_text != blank -%}
        <div class="hero-b2b__badge">
          <svg class="hero-b2b__badge-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          {{- section.settings.badge_text | escape -}}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hero-b2b__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="hero-b2b__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="hero-b2b__buttons">
        {%- if customer and customer.tags contains 'wholesale' -%}
          {%- comment -%} Logged-in partner: portal + dashboard {%- endcomment -%}
          <a href="{{ routes.all_products_collection_url }}" class="hero-b2b__btn hero-b2b__btn--primary">
            {{ section.settings.member_primary_label | default: 'Go to Order Portal' | escape }}
            <svg class="hero-b2b__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <a href="{{ pages['partner-dashboard'].url | default: '/pages/partner-dashboard' }}" class="hero-b2b__btn hero-b2b__btn--secondary">
            {{ section.settings.member_secondary_label | default: 'My Dashboard' | escape }}
          </a>
        {%- else -%}
          {%- if section.settings.button_primary_label != blank -%}
            <a
              href="{{ section.settings.button_primary_link | default: '#' }}"
              class="hero-b2b__btn hero-b2b__btn--primary"
            >
              {{- section.settings.button_primary_label | escape -}}
              <svg class="hero-b2b__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.button_secondary_label != blank -%}
            <a
              href="{{ section.settings.button_secondary_link | default: '#' }}"
              class="hero-b2b__btn hero-b2b__btn--secondary"
            >
              {{- section.settings.button_secondary_label | escape -}}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} ── Media column ── {%- endcomment -%}
    <div class="hero-b2b__media">
      <div class="hero-b2b__image-frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 600
            | image_tag:
              class: 'hero-b2b__image',
              loading: 'lazy',
              widths: '300, 400, 500, 600',
              sizes: '(min-width: 990px) 448px, (min-width: 750px) 350px, calc(100vw - 3rem)'
          }}
        {%- else -%}
          <div class="hero-b2b__placeholder" aria-hidden="true">
            <svg class="hero-b2b__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span class="hero-b2b__placeholder-label">L.P. Wholesale</span>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero B2B",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "info": "White background with black text for maximum readability.",
      "default": false
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "B2B Partnership"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your trusted supplier of niche perfumery."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Official portal for boutique owners. Recommended retail markup from 100%, dispatch from our Prague warehouse in 24 hours. Catalog access is restricted to verified partners.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Label",
      "default": "Apply for Partnership"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Label",
      "default": "Log in to portal"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Logged-in partner view"
    },
    {
      "type": "text",
      "id": "member_badge",
      "label": "Welcome badge",
      "default": "Welcome back"
    },
    {
      "type": "text",
      "id": "member_primary_label",
      "label": "Primary button (→ catalog)",
      "default": "Go to Order Portal"
    },
    {
      "type": "text",
      "id": "member_secondary_label",
      "label": "Secondary button (→ dashboard)",
      "default": "My Dashboard"
    }
  ],
  "presets": [
    {
      "name": "Hero B2B"
    }
  ]
}
{% endschema %}
