{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' how-it-works--high-contrast'
  endif

  assign step_1_url = section.settings.step_1_url | default: '/collections/all'
  assign step_2_url = section.settings.step_2_url | default: '/pages/wholesale-application'
  assign step_3_url = section.settings.step_3_url | default: '/cart'
  assign step_4_url = section.settings.step_4_url | default: '/pages/partner-dashboard'
-%}

<style>
  /* ================================================
     How It Works — inline section styles
     ================================================ */

  .how-it-works {
    padding: 6rem 1.5rem;
    background-color: #f5f5f4;
    border-top: 1px solid #e7e5e4;
  }

  .how-it-works--high-contrast {
    background-color: #ffffff;
    border-top: 4px solid #000000;
  }

  html.a11y-high-contrast .how-it-works {
    background-color: #ffffff !important;
    border-top: 4px solid #000000 !important;
  }

  .how-it-works__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
  }

  /* ── Header ─────────────────────────────────────── */

  .how-it-works__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .how-it-works__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.1;
    color: #1c1917;
    margin: 0 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .how-it-works__heading {
      font-size: clamp(3rem, 8vw, 4rem);
    }
  }

  html.a11y-high-contrast .how-it-works__heading {
    color: #000000 !important;
  }

  .how-it-works__subheading {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.65;
    color: #57534e;
    max-width: 42rem;
    margin: 0 auto;
  }

  .how-it-works--high-contrast .how-it-works__subheading,
  html.a11y-high-contrast .how-it-works__subheading {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  /* ── Steps grid ─────────────────────────────────── */

  .how-it-works__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media screen and (min-width: 600px) {
    .how-it-works__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .how-it-works__steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
  }

  /* ── Single step ────────────────────────────────── */

  .how-it-works__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Dashed connector line between steps (desktop only, not on last) */
  @media screen and (min-width: 990px) {
    .how-it-works__step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 2rem;
      left: 50%;
      width: 100%;
      height: 0;
      border-top: 2px dashed #d6d3d1;
      pointer-events: none;
      z-index: 0;
    }

    .how-it-works--high-contrast .how-it-works__step:not(:last-child)::after,
    html.a11y-high-contrast .how-it-works__step:not(:last-child)::after {
      border-top-color: #000000;
    }
  }

  /* ── Step number circle ─────────────────────────── */

  .how-it-works__number {
    position: relative;
    z-index: 1;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    flex-shrink: 0;
    background-color: #1c1917;
    color: #ffffff;
  }

  /* Anchor variant — when a step has a URL, the number becomes a link */
  a.how-it-works__number {
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  a.how-it-works__number:hover,
  a.how-it-works__number:focus-visible {
    background-color: #b45309;
    color: #ffffff;
    transform: scale(1.05);
    box-shadow: 0 0 0 4px #fef3c7;
  }

  .how-it-works--high-contrast .how-it-works__number,
  html.a11y-high-contrast .how-it-works__number {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  .how-it-works--high-contrast .how-it-works__step:last-child .how-it-works__number,
  html.a11y-high-contrast .how-it-works__step:last-child .how-it-works__number {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── Step text ──────────────────────────────────── */

  .how-it-works__step-heading {
    font-family: var(--font-body-family);
    font-size: 1.125rem;
    font-weight: 700;
    color: #1c1917;
    margin: 0 0 0.75rem;
  }

  html.a11y-high-contrast .how-it-works__step-heading {
    color: #000000 !important;
  }

  .how-it-works__step-desc {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #57534e;
    margin: 0;
    padding: 0 0.5rem;
  }

  .how-it-works--high-contrast .how-it-works__step-desc,
  html.a11y-high-contrast .how-it-works__step-desc {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  @media screen and (max-width: 989px) {
    .how-it-works__subheading { font-size: 1.15rem; }
    .how-it-works__step-desc  { font-size: 1.1rem; }
  }
</style>

<section
  class="how-it-works{{ section_mod }}"
  id="HowItWorks-{{ section.id }}"
>
  <div class="how-it-works__container">

    <div class="how-it-works__header">
      <h2 class="how-it-works__heading">{{ section.settings.heading | default: 'How to Order' | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="how-it-works__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="how-it-works__steps">

      <div class="how-it-works__step">
        {%- if step_1_url != blank -%}
          <a class="how-it-works__number" href="{{ step_1_url }}" aria-label="Step 1: Browse & Choose">1</a>
        {%- else -%}
          <div class="how-it-works__number" aria-hidden="true">1</div>
        {%- endif -%}
        <h4 class="how-it-works__step-heading">Browse &amp; Choose</h4>
        <p class="how-it-works__step-desc">Explore our catalog or select one of the ready-made packages above.</p>
      </div>

      <div class="how-it-works__step">
        {%- if step_2_url != blank -%}
          <a class="how-it-works__number" href="{{ step_2_url }}" aria-label="Step 2: Apply or Log In">2</a>
        {%- else -%}
          <div class="how-it-works__number" aria-hidden="true">2</div>
        {%- endif -%}
        <h4 class="how-it-works__step-heading">Apply / Log In</h4>
        <p class="how-it-works__step-desc">Log in to your account or apply for a new wholesale partnership to see prices.</p>
      </div>

      <div class="how-it-works__step">
        {%- if step_3_url != blank -%}
          <a class="how-it-works__number" href="{{ step_3_url }}" aria-label="Step 3: Confirm Order">3</a>
        {%- else -%}
          <div class="how-it-works__number" aria-hidden="true">3</div>
        {%- endif -%}
        <h4 class="how-it-works__step-heading">Confirm Order</h4>
        <p class="how-it-works__step-desc">Add products to cart. We will confirm availability and prepare your proforma invoice.</p>
      </div>

      <div class="how-it-works__step">
        {%- if step_4_url != blank -%}
          <a class="how-it-works__number" href="{{ step_4_url }}" aria-label="Step 4: Shipment">4</a>
        {%- else -%}
          <div class="how-it-works__number" aria-hidden="true">4</div>
        {%- endif -%}
        <h4 class="how-it-works__step-heading">Shipment</h4>
        <p class="how-it-works__step-desc">Once paid, your order is packed and shipped from Prague within 1–3 business days.</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "info": "White background with black border and connectors.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "How to Order"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A simple, transparent process from selecting your package to getting the products on your shelves."
    },
    {
      "type": "header",
      "content": "Step links",
      "info": "Each step number is a link with an orange hover. Leave blank to use the defaults: catalog, application, cart, partner dashboard."
    },
    {
      "type": "url",
      "id": "step_1_url",
      "label": "Step 1 link"
    },
    {
      "type": "url",
      "id": "step_2_url",
      "label": "Step 2 link"
    },
    {
      "type": "url",
      "id": "step_3_url",
      "label": "Step 3 link"
    },
    {
      "type": "url",
      "id": "step_4_url",
      "label": "Step 4 link"
    }
  ],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
