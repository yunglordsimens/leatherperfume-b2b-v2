{%- liquid
  assign heading     = section.settings.heading     | default: 'Invoices & Documents'
  assign description = section.settings.description | default: 'View, download, and manage your wholesale billing documents. Proforma invoices are generated upon order confirmation.'
  assign max_orders  = section.settings.max_orders  | default: 20
  assign contact_url = section.settings.contact_url | default: '/pages/contact'
-%}

<style>
  /* ── layout ────────────────────────────────────────────── */
  .inv {
    background-color: #f5f5f4;
    min-height: 60vh;
  }
  html.a11y-high-contrast .inv { background-color: #ffffff !important; }

  /* ── page header ───────────────────────────────────────── */
  .inv__header {
    background: #ffffff;
    border-bottom: 1px solid #e7e5e4;
    padding: 3rem 1.5rem;
  }
  html.a11y-high-contrast .inv__header { border-bottom: 4px solid #000000 !important; }

  .inv__header-inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media screen and (min-width: 768px) {
    .inv__header-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .inv__icon-wrap {
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background-color: #fef3c7;
    color: #b45309;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  html.a11y-high-contrast .inv__icon-wrap {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 4px solid #000000 !important;
  }
  .inv__icon-wrap svg { width: 2rem; height: 2rem; }

  .inv__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 5vw, 3rem);
    color: #1c1917;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }
  html.a11y-high-contrast .inv__heading { color: #000000 !important; }

  .inv__desc {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.7;
    color: #57534e;
    max-width: 42rem;
    margin: 0;
  }
  html.a11y-high-contrast .inv__desc { color: #000000 !important; font-weight: 500; }

  /* ── body ──────────────────────────────────────────────── */
  .inv__body {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  /* ── table card ────────────────────────────────────────── */
  .inv__card {
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }
  html.a11y-high-contrast .inv__card { border: 4px solid #000000 !important; box-shadow: none !important; }

  /* ── table head (desktop) ──────────────────────────────── */
  .inv__thead {
    display: none;
    background-color: #f5f5f4;
    border-bottom: 1px solid #e7e5e4;
    padding: 0.875rem 1.5rem;
    grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr 2fr;
    gap: 1rem;
  }
  @media screen and (min-width: 768px) { .inv__thead { display: grid; } }
  html.a11y-high-contrast .inv__thead { background-color: #ffffff !important; border-bottom: 2px solid #000000 !important; }

  .inv__th {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #78716c;
  }
  .inv__th--right { text-align: right; }
  html.a11y-high-contrast .inv__th { color: #000000 !important; }

  /* ── row ───────────────────────────────────────────────── */
  .inv__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-bottom: 1px solid #f5f5f4;
    transition: background-color 0.12s ease;
  }
  .inv__row:last-child { border-bottom: none; }
  .inv__row:hover { background-color: #fafaf9; }

  @media screen and (min-width: 768px) {
    .inv__row {
      display: grid;
      grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr 2fr;
      gap: 1rem;
      align-items: center;
      flex-direction: unset;
    }
  }
  html.a11y-high-contrast .inv__row { border-bottom: 1px solid #cccccc !important; }

  /* mobile label (hidden on desktop) */
  .inv__mob-label {
    display: inline-block;
    font-family: var(--font-body-family);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #78716c;
    margin-bottom: 0.125rem;
  }
  @media screen and (min-width: 768px) { .inv__mob-label { display: none; } }
  html.a11y-high-contrast .inv__mob-label { color: #000000 !important; }

  /* ── cells ─────────────────────────────────────────────── */
  .inv__cell { display: flex; flex-direction: column; gap: 0.125rem; }
  @media screen and (min-width: 768px) { .inv__cell { flex-direction: column; } }

  .inv__inv-num {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.0625rem;
    color: #1c1917;
    text-decoration: none;
  }
  .inv__inv-num:hover { text-decoration: underline; }
  html.a11y-high-contrast .inv__inv-num { color: #000000 !important; text-decoration: underline; }

  .inv__po {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #a8a29e;
  }
  html.a11y-high-contrast .inv__po { color: #000000 !important; }

  .inv__date {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #44403c;
  }
  html.a11y-high-contrast .inv__date { color: #000000 !important; }

  .inv__date--overdue {
    color: #b91c1c;
    font-weight: 700;
  }
  html.a11y-high-contrast .inv__date--overdue { color: #000000 !important; }

  /* ── status badges ─────────────────────────────────────── */
  .inv__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.65rem;
    border-radius: 0.5rem;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: fit-content;
  }
  .inv__badge svg { width: 0.875rem; height: 0.875rem; flex-shrink: 0; }

  .inv__badge--paid    { background-color: #d1fae5; color: #065f46; }
  .inv__badge--pending { background-color: #fef3c7; color: #92400e; }
  .inv__badge--overdue { background-color: #fee2e2; color: #991b1b; }

  html.a11y-high-contrast .inv__badge {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  /* ── actions cell ──────────────────────────────────────── */
  .inv__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }
  @media screen and (min-width: 768px) {
    .inv__actions { align-items: flex-end; }
  }

  .inv__amount {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.375rem;
    color: #1c1917;
    line-height: 1.2;
  }
  html.a11y-high-contrast .inv__amount { color: #000000 !important; }

  .inv__btns {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  @media screen and (min-width: 768px) { .inv__btns { justify-content: flex-end; } }

  .inv__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    border-radius: 0.625rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.12s ease, border-color 0.12s ease;
    white-space: nowrap;
  }
  .inv__btn svg { width: 0.875rem; height: 0.875rem; flex-shrink: 0; }

  .inv__btn--outline {
    color: #1c1917;
    background: #ffffff;
    border: 1px solid #d6d3d1;
  }
  .inv__btn--outline:hover { background-color: #f5f5f4; border-color: #a8a29e; }

  .inv__btn--dark {
    color: #ffffff;
    background: #1c1917;
    border: 1px solid #1c1917;
  }
  .inv__btn--dark:hover { background-color: #b45309; border-color: #b45309; }

  html.a11y-high-contrast .inv__btn--outline { border: 2px solid #000000 !important; color: #000000 !important; }
  html.a11y-high-contrast .inv__btn--dark { background-color: #000000 !important; border: 2px solid #000000 !important; }

  /* ── empty ─────────────────────────────────────────────── */
  .inv__empty {
    padding: 4rem 2rem;
    text-align: center;
  }
  .inv__empty svg { width: 3rem; height: 3rem; color: #d6d3d1; display: block; margin: 0 auto 1rem; }
  html.a11y-high-contrast .inv__empty svg { color: #000000 !important; }
  .inv__empty-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }
  .inv__empty-text {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #78716c;
    margin: 0;
  }
  html.a11y-high-contrast .inv__empty-heading,
  html.a11y-high-contrast .inv__empty-text { color: #000000 !important; }

  /* ── footer note ───────────────────────────────────────── */
  .inv__note {
    margin-top: 1.5rem;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #78716c;
  }
  html.a11y-high-contrast .inv__note { color: #000000 !important; }
  .inv__note a { color: #b45309; font-weight: 700; text-decoration: none; }
  .inv__note a:hover { text-decoration: underline; }
  html.a11y-high-contrast .inv__note a { color: #000000 !important; text-decoration: underline; }

  /* ── auth gate ─────────────────────────────────────────── */
  .inv__auth {
    max-width: 30rem;
    margin: 4rem auto;
    background: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.25rem;
    padding: 3.5rem 2rem;
    text-align: center;
  }
  html.a11y-high-contrast .inv__auth { border: 4px solid #000000 !important; }
  .inv__auth svg { width: 3rem; height: 3rem; color: #d6d3d1; display: block; margin: 0 auto 1rem; }
  html.a11y-high-contrast .inv__auth svg { color: #000000 !important; }
  .inv__auth h2 {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.5rem;
    color: #1c1917;
    margin: 0 0 0.625rem;
  }
  .inv__auth p {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #57534e;
    margin: 0 0 1.75rem;
  }
  .inv__auth a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background-color: #1c1917;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .inv__auth a:hover { background-color: #b45309; }
  html.a11y-high-contrast .inv__auth h2,
  html.a11y-high-contrast .inv__auth p { color: #000000 !important; }
  html.a11y-high-contrast .inv__auth a { background-color: #000000 !important; border: 2px solid #000000 !important; }

  /* mobile stacked rows */
  @media screen and (max-width: 767px) {
    .inv__row-mobile-pair {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  @media screen and (min-width: 768px) { .inv__row-mobile-pair { display: contents; } }
</style>

<div class="inv" id="InvoicesList-{{ section.id }}">

  <!-- ── page header ─────────────────────────────────────── -->
  <div class="inv__header">
    <div class="inv__header-inner">
      <div>
        <div class="inv__icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h1 class="inv__heading">{{ heading }}</h1>
        <p class="inv__desc">{{ description }}</p>
      </div>
    </div>
  </div>

  <!-- ── body ────────────────────────────────────────────── -->
  <div class="inv__body">

    {%- unless customer -%}

      <div class="inv__auth">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <h2>{{ section.settings.auth_heading | default: 'Sign in to view invoices' }}</h2>
        <p>{{ section.settings.auth_text | default: 'Please log in with your wholesale account to access your billing documents.' }}</p>
        <a href="/account/login?return_url={{ request.path | url_encode }}">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          {{ section.settings.auth_btn | default: 'Sign in' }}
        </a>
      </div>

    {%- else -%}

      <div class="inv__card">

        <!-- desktop table head -->
        <div class="inv__thead" role="row" aria-label="Invoice table headers">
          <div class="inv__th">{{ section.settings.col_invoice | default: 'Invoice / PO Ref' }}</div>
          <div class="inv__th">{{ section.settings.col_issued | default: 'Issue Date' }}</div>
          <div class="inv__th">{{ section.settings.col_due | default: 'Due Date' }}</div>
          <div class="inv__th">{{ section.settings.col_status | default: 'Status' }}</div>
          <div class="inv__th inv__th--right">{{ section.settings.col_amount | default: 'Amount & Actions' }}</div>
        </div>

        {%- assign orders_list = customer.orders | limit: max_orders -%}

        {%- if orders_list.size == 0 -%}
          <div class="inv__empty">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <p class="inv__empty-heading">{{ section.settings.empty_heading | default: 'No invoices yet' }}</p>
            <p class="inv__empty-text">{{ section.settings.empty_text | default: 'Your invoices will appear here once you place your first wholesale order.' }}</p>
          </div>
        {%- else -%}

          {%- for order in orders_list -%}
            {%- liquid
              assign fin_stat = order.financial_status

              assign status_key = 'overdue'
              if fin_stat == 'paid' or fin_stat == 'partially_paid'
                assign status_key = 'paid'
              elsif fin_stat == 'pending' or fin_stat == 'authorized'
                assign status_key = 'pending'
              endif

              assign status_label = 'Overdue'
              if status_key == 'paid'
                assign status_label = 'Paid'
              elsif status_key == 'pending'
                assign status_label = 'Pending'
              endif

              assign po_num = order.attributes.po_number | default: ''
              if po_num == blank
                assign po_num = order.metafields.custom.po_number | default: ''
              endif
            -%}

            <div class="inv__row" role="row">

              <!-- invoice ref + PO -->
              <div class="inv__cell">
                <span class="inv__mob-label">Invoice</span>
                <a class="inv__inv-num" href="/account/orders/{{ order.id }}">{{ order.name }}</a>
                {%- if po_num != blank -%}
                  <span class="inv__po">PO: {{ po_num }}</span>
                {%- endif -%}
              </div>

              <!-- issue date -->
              <div class="inv__cell">
                <span class="inv__mob-label">{{ section.settings.col_issued | default: 'Issued' }}</span>
                <span class="inv__date">{{ order.created_at | date: '%b %d, %Y' }}</span>
              </div>

              <!-- due date (approx 30 days after order) -->
              <div class="inv__cell">
                <span class="inv__mob-label">{{ section.settings.col_due | default: 'Due' }}</span>
                {%- assign due_ts = order.created_at | date: '%s' | plus: 2592000 -%}
                <span class="inv__date{%- if status_key == 'overdue' %} inv__date--overdue{%- endif -%}">
                  {{ due_ts | date: '%b %d, %Y' }}
                </span>
              </div>

              <!-- status badge -->
              <div class="inv__cell">
                <span class="inv__mob-label">{{ section.settings.col_status | default: 'Status' }}</span>
                <span class="inv__badge inv__badge--{{ status_key }}" aria-label="Status: {{ status_label }}">
                  {%- if status_key == 'paid' -%}
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif status_key == 'pending' -%}
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {%- else -%}
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  {%- endif -%}
                  {{ status_label }}
                </span>
              </div>

              <!-- amount + actions -->
              <div class="inv__actions">
                <span class="inv__mob-label">{{ section.settings.col_amount | default: 'Amount' }}</span>
                <span class="inv__amount">{{ order.total_price | money }}</span>
                <div class="inv__btns">
                  <a
                    class="inv__btn inv__btn--outline"
                    href="/account/orders/{{ order.id }}"
                    aria-label="View / download invoice {{ order.name }}"
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                      <polyline points="7 10 12 15 17 10"/>
                      <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    {{ section.settings.pdf_btn | default: 'PDF' }}
                  </a>

                  {%- if status_key == 'pending' or status_key == 'overdue' -%}
                    <a
                      class="inv__btn inv__btn--dark"
                      href="/account/orders/{{ order.id }}?checkout=1"
                      aria-label="Pay invoice {{ order.name }}"
                    >
                      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                        <line x1="1" y1="10" x2="23" y2="10"/>
                      </svg>
                      {{ section.settings.pay_btn | default: 'Pay Now' }}
                    </a>
                  {%- endif -%}
                </div>
              </div>

            </div>
          {%- endfor -%}

        {%- endif -%}

      </div>

      <p class="inv__note">
        {{ section.settings.footer_note | default: 'Need an older document?' }}
        <a href="{{ contact_url }}">{{ section.settings.contact_label | default: 'Contact your manager' }}</a>
      </p>

    {%- endunless -%}

  </div>
</div>

{% schema %}
{
  "name": "Invoices List B2B",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Page header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Invoices & Documents"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "View, download, and manage your wholesale billing documents. Proforma invoices are generated upon order confirmation."
    },
    {
      "type": "number",
      "id": "max_orders",
      "label": "Max invoices to show",
      "default": 20
    },
    {
      "type": "header",
      "content": "Table columns"
    },
    {
      "type": "text",
      "id": "col_invoice",
      "label": "Column: Invoice",
      "default": "Invoice / PO Ref"
    },
    {
      "type": "text",
      "id": "col_issued",
      "label": "Column: Issue Date",
      "default": "Issue Date"
    },
    {
      "type": "text",
      "id": "col_due",
      "label": "Column: Due Date",
      "default": "Due Date"
    },
    {
      "type": "text",
      "id": "col_status",
      "label": "Column: Status",
      "default": "Status"
    },
    {
      "type": "text",
      "id": "col_amount",
      "label": "Column: Amount",
      "default": "Amount & Actions"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "pdf_btn",
      "label": "PDF button label",
      "default": "PDF"
    },
    {
      "type": "text",
      "id": "pay_btn",
      "label": "Pay Now button label",
      "default": "Pay Now"
    },
    {
      "type": "header",
      "content": "Empty & footer"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "No invoices yet"
    },
    {
      "type": "textarea",
      "id": "empty_text",
