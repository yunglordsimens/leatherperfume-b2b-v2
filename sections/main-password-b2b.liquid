<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body { height: 100%; margin: 0; overflow-x: hidden; }
  .password-main { min-height: 100vh; display: flex; flex-direction: column; }

  .pw-wrap {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* ── LEFT ─────────────────────────── */
  .pw-left {
    display: none;
    background-color: #1c1917;
    color: #ffffff;
    width: 50%;
    padding: 3rem;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* Decorative blurred glow (matches wholesale-login panel) */
  .pw-left::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -20%;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(120, 53, 15, 0.35), transparent 70%);
    filter: blur(48px);
    pointer-events: none;
  }

  .pw-left > * { position: relative; z-index: 1; }

  @media (max-width: 767px) {
    .pw-left { display: none; }
  }

  @media (min-width: 1024px) {
    .pw-wrap { flex-direction: row; }
    .pw-left { display: flex; }
  }

  .pw-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #f59e0b;
    color: #1c1917;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .pw-badge svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }

  .pw-left__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .pw-left__desc {
    color: #d6d3d1;
    font-size: 1rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .pw-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .pw-benefit {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
  }

  .pw-benefit svg {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: #f59e0b;
  }

  /* ── EMAIL FORM ───────────────────── */
  .pw-email-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .pw-email-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a8a29e;
    margin-bottom: 0.75rem;
  }

  .pw-email-row {
    display: flex;
    gap: 0.5rem;
  }

  .pw-email-input {
    flex: 1;
    height: 44px;
    padding: 0 1rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 0.625rem;
    font-size: 0.9rem;
    color: #ffffff;
    outline: none;
    transition: border-color 0.15s;
  }

  .pw-email-input::placeholder { color: #78716c; }
  .pw-email-input:focus { border-color: rgba(255,255,255,0.4); }

  .pw-email-btn {
    height: 44px;
    padding: 0 1.25rem;
    background: #ea580c;
    color: #ffffff;
    border: none;
    border-radius: 0.625rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .pw-email-btn:hover { background: #c2410c; }

  .pw-email-success {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    background: rgba(22,163,74,0.15);
    border: 1px solid rgba(22,163,74,0.35);
    border-radius: 0.625rem;
    padding: 0.75rem 1rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pw-email-success svg { width: 1.1rem; height: 1.1rem; flex-shrink: 0; color: #86efac; }

  /* display:flex above overrides the browser's [hidden] rule —
     without this the success bar is visible before the click */
  .pw-email-success[hidden] { display: none !important; }

  .pw-email-error {
    margin-top: 0.5rem;
    color: #fca5a5;
    font-size: 0.875rem;
  }

  /* ── RIGHT ────────────────────────── */
  .pw-right {
    width: 100%;
    min-height: 100vh;
    background-color: #fafaf9;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .pw-right { width: 100%; min-height: 100vh; }
  }

  @media (min-width: 1024px) {
    .pw-right {
      width: 50%;
      padding: 3rem 5rem;
    }
  }

  .pw-right__inner {
    max-width: 28rem;
    margin: 0 auto;
    width: 100%;
  }

  .pw-lock-icon {
    display: block;
    width: 4rem;
    height: 4rem;
    color: #78716c;
    margin: 0 auto 2rem;
    flex-shrink: 0;
    transition: color 0.3s;
  }

  .pw-lock-icon--granted { color: #16a34a; }

  @media (min-width: 1024px) {
    .pw-lock-icon { margin-left: 0; margin-right: auto; }
  }

  .pw-right__heading {
    font-family: var(--font-heading-family);
    font-size: 2.25rem;
    font-weight: 700;
    color: #1c1917;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .pw-right__sub {
    color: #78716c;
    font-size: 0.975rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .pw-error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 0.75rem;
    color: #991b1b;
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .pw-input-wrap {
    position: relative;
    margin-bottom: 1rem;
  }

  .pw-input {
    width: 100%;
    height: 56px;
    padding: 0 3rem 0 1.25rem;
    border: 1px solid #d6d3d1;
    border-radius: 12px;
    font-size: 1rem;
    font-family: ui-monospace, 'Courier New', Courier, monospace;
    text-align: center;
    letter-spacing: 0.1em;
    background: #ffffff;
    color: #1c1917;
    outline: none;
    transition: border-color 0.15s;
  }

  .pw-input:focus { border-color: #1c1917; }

  .pw-toggle {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #a8a29e;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .pw-toggle svg { width: 1.2rem; height: 1.2rem; }

  .pw-submit {
    width: 100%;
    height: 56px;
    padding: 0;
    background: #1c1917;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    letter-spacing: 0.02em;
  }

  .pw-submit:hover { background: #ea580c; }

  .pw-admin {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: #78716c;
  }

  .pw-admin a {
    color: #1c1917;
    text-decoration: underline;
  }

  /* ── a11y high contrast ───────────── */
  html.a11y-high-contrast .pw-lock-icon { color: #000; }
  html.a11y-high-contrast .pw-lock-icon--granted { color: #000; }
  html.a11y-high-contrast .pw-left { background: #000; }
  html.a11y-high-contrast .pw-badge { background: #000; color: #fff; border: 2px solid #fff; }
  html.a11y-high-contrast .pw-left__desc { color: #fff; }
  html.a11y-high-contrast .pw-benefit { color: #fff; }
  html.a11y-high-contrast .pw-benefit svg { color: #fff; }
  html.a11y-high-contrast .pw-email-card { background: #000; border-color: #fff; }
  html.a11y-high-contrast .pw-email-input { background: #000; border-color: #fff; color: #fff; border-width: 2px; }
  html.a11y-high-contrast .pw-email-btn { background: #000; color: #fff; border: 2px solid #fff; }
  html.a11y-high-contrast .pw-email-success { background: #000; border-color: #fff; color: #fff; }
  html.a11y-high-contrast .pw-right { background: #fff; }
  html.a11y-high-contrast .pw-right__heading { color: #000; }
  html.a11y-high-contrast .pw-right__sub { color: #000; }
  html.a11y-high-contrast .pw-input { border-color: #000; border-width: 2px; }
  html.a11y-high-contrast .pw-submit { background: #000; }
  html.a11y-high-contrast .pw-admin { color: #000; }
  html.a11y-high-contrast .pw-admin a { color: #000; }
</style>

<div class="pw-wrap">

  {%- comment -%}── LEFT: brand ──{%- endcomment -%}
  <div class="pw-left">

    <span class="pw-badge">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
      </svg>
      B2B Portal
    </span>

    <h1 class="pw-left__heading">{{ section.settings.left_heading }}</h1>
    <p class="pw-left__desc">{{ section.settings.left_desc }}</p>

    <ul class="pw-benefits">
      {%- for i in (1..3) -%}
        {%- assign benefit_key = 'benefit_' | append: i -%}
        {%- assign benefit_text = section.settings[benefit_key] -%}
        {%- if benefit_text != blank -%}
          <li class="pw-benefit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {{ benefit_text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="pw-email-card">
      <span class="pw-email-label">Get early access</span>
      {%- form 'customer', id: 'PwEmailForm' -%}
        {%- if form.posted_successfully? -%}
          <div id="PwEmailSuccess" class="pw-email-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            You're on the list!
          </div>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter,early-access">
          <div class="pw-email-row">
            <input
              class="pw-email-input"
              type="email"
              name="contact[email]"
              id="PwEmailInput"
              value="{{ form.email }}"
              placeholder="your@email.com"
              autocomplete="email"
              aria-required="true"
              required
            >
            <button class="pw-email-btn" type="submit" id="PwEmailBtn">Notify</button>
          </div>
          {%- if form.errors -%}
            <div class="pw-email-error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>

  {%- comment -%}── RIGHT: form ──{%- endcomment -%}
  <div class="pw-right">
    <div class="pw-right__inner">

      <svg class="pw-lock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>

      <h2 class="pw-right__heading">{{ section.settings.form_heading }}</h2>
      <p class="pw-right__sub">{{ section.settings.form_desc }}</p>

      {%- form 'storefront_password' -%}

        {%- if form.errors -%}
          <div class="pw-error" role="alert">
            {{ 'general.password_page.login_form_error' | t }}
          </div>
        {%- endif -%}

        <div class="pw-input-wrap">
          <input
            class="pw-input"
            type="password"
            id="Password"
            name="password"
            placeholder="{{ section.settings.input_placeholder }}"
            autocomplete="current-password"
            autofocus
            required
          >
          <button class="pw-toggle" type="button" id="PwToggle" aria-label="Show password">
            <svg id="PwShow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <svg id="PwHide" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
              <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
              <line x1="1" y1="1" x2="23" y2="23"/>
            </svg>
          </button>
        </div>

        <button class="pw-submit" type="submit">{{ section.settings.button_text }}</button>

      {%- endform -%}

      <p class="pw-admin">{{ 'general.password_page.admin_link_html' | t }}</p>

    </div>
  </div>

</div>

<script>
(function () {
  var inp = document.getElementById('Password');
  var btn = document.getElementById('PwToggle');
  var show = document.getElementById('PwShow');
  var hide = document.getElementById('PwHide');
  var lockIcon = document.querySelector('.pw-lock-icon');
  var form = inp && inp.closest('form');

  if (inp && btn) {
    btn.addEventListener('click', function () {
      var isHidden = inp.type === 'password';
      inp.type = isHidden ? 'text' : 'password';
      show.style.display = isHidden ? 'none' : '';
      hide.style.display = isHidden ? '' : 'none';
      inp.focus();
    });
  }

  if (form && lockIcon) {
    form.addEventListener('submit', function () {
      lockIcon.classList.add('pw-lock-icon--granted');
    });
  }

})();
</script>

{% schema %}
{
  "name": "Password B2B",
  "settings": [
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left heading",
      "default": "Exclusive access for our partners."
    },
    {
      "type": "text",
      "id": "left_desc",
      "label": "Left description",
      "default": "Enter the password to preview our wholesale catalog."
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Up to 40% Margin"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Priority 24h Shipping"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Dedicated B2B Support"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Password Required"
    },
    {
      "type": "text",
      "id": "form_desc",
      "label": "Form description",
      "default": "Enter the store password to continue."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Enter Store"
    }
  ]
}
{% endschema %}
