<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .pw-wrap {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* ── LEFT ─────────────────────────── */
  .pw-left {
    display: none;
    background-color: #1c1917;
    color: #ffffff;
    width: 50%;
    padding: 5rem;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .pw-wrap { flex-direction: row; }
    .pw-left { display: flex; }
  }

  .pw-left__heading {
    font-family: var(--font-heading-family);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

  .pw-left__desc {
    color: #a8a29e;
    font-size: 1.05rem;
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  .pw-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pw-benefit {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1rem;
    color: #e7e5e4;
  }

  .pw-benefit svg {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    color: #f59e0b;
  }

  /* ── RIGHT ────────────────────────── */
  .pw-right {
    width: 100%;
    background-color: #fafaf9;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .pw-right {
      width: 50%;
      padding: 3rem 5rem;
    }
  }

  .pw-right__inner {
    max-width: 28rem;
    margin: 0 auto;
    width: 100%;
  }

  .pw-lock-icon {
    width: 3rem;
    height: 3rem;
    color: #78716c;
    margin-bottom: 2rem;
  }

  .pw-right__heading {
    font-family: var(--font-heading-family);
    font-size: 2.25rem;
    font-weight: 700;
    color: #1c1917;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .pw-right__sub {
    color: #78716c;
    font-size: 0.975rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .pw-error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 0.75rem;
    color: #991b1b;
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .pw-input-wrap {
    position: relative;
    margin-bottom: 1rem;
  }

  .pw-input {
    width: 100%;
    padding: 1rem 3rem 1rem 1.25rem;
    border: 1px solid #d6d3d1;
    border-radius: 0.75rem;
    font-size: 1rem;
    background: #ffffff;
    color: #1c1917;
    outline: none;
    transition: border-color 0.15s;
  }

  .pw-input:focus { border-color: #1c1917; }

  .pw-toggle {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #a8a29e;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .pw-toggle svg { width: 1.2rem; height: 1.2rem; }

  .pw-submit {
    width: 100%;
    padding: 1.1rem;
    background: #1c1917;
    color: #ffffff;
    border: none;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    letter-spacing: 0.02em;
  }

  .pw-submit:hover { background: #b45309; }

  .pw-admin {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: #78716c;
  }

  .pw-admin a {
    color: #1c1917;
    text-decoration: underline;
  }

  /* ── a11y high contrast ───────────── */
  html.a11y-high-contrast .pw-left { background: #000; }
  html.a11y-high-contrast .pw-left__desc { color: #fff; }
  html.a11y-high-contrast .pw-benefit { color: #fff; }
  html.a11y-high-contrast .pw-benefit svg { color: #fff; }
  html.a11y-high-contrast .pw-right { background: #fff; }
  html.a11y-high-contrast .pw-right__heading { color: #000; }
  html.a11y-high-contrast .pw-right__sub { color: #000; }
  html.a11y-high-contrast .pw-input { border-color: #000; border-width: 2px; }
  html.a11y-high-contrast .pw-submit { background: #000; }
  html.a11y-high-contrast .pw-admin { color: #000; }
  html.a11y-high-contrast .pw-admin a { color: #000; }
</style>

<div class="pw-wrap">

  {%- comment -%}── LEFT: brand ──{%- endcomment -%}
  <div class="pw-left">
    <h1 class="pw-left__heading">{{ section.settings.left_heading }}</h1>
    <p class="pw-left__desc">{{ section.settings.left_desc }}</p>
    <ul class="pw-benefits">
      {%- for i in (1..3) -%}
        {%- assign benefit_key = 'benefit_' | append: i -%}
        {%- assign benefit_text = section.settings[benefit_key] -%}
        {%- if benefit_text != blank -%}
          <li class="pw-benefit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {{ benefit_text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- comment -%}── RIGHT: form ──{%- endcomment -%}
  <div class="pw-right">
    <div class="pw-right__inner">

      <svg class="pw-lock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>

      <h2 class="pw-right__heading">{{ section.settings.form_heading }}</h2>
      <p class="pw-right__sub">{{ section.settings.form_desc }}</p>

      {%- form 'storefront_password' -%}

        {%- if form.errors -%}
          <div class="pw-error" role="alert">
            {{ 'general.password_page.login_form_error' | t }}
          </div>
        {%- endif -%}

        <div class="pw-input-wrap">
          <input
            class="pw-input"
            type="password"
            id="Password"
            name="password"
            placeholder="{{ section.settings.input_placeholder }}"
            autocomplete="current-password"
            autofocus
            required
          >
          <button class="pw-toggle" type="button" id="PwToggle" aria-label="Show password">
            <svg id="PwShow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <svg id="PwHide" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
              <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
              <line x1="1" y1="1" x2="23" y2="23"/>
            </svg>
          </button>
        </div>

        <button class="pw-submit" type="submit">{{ section.settings.button_text }}</button>

      {%- endform -%}

      <p class="pw-admin">{{ 'general.password_page.admin_link_html' | t }}</p>

    </div>
  </div>

</div>

<script>
(function () {
  var inp = document.getElementById('Password');
  var btn = document.getElementById('PwToggle');
  var show = document.getElementById('PwShow');
  var hide = document.getElementById('PwHide');
  if (!inp || !btn) return;
  btn.addEventListener('click', function () {
    var isHidden = inp.type === 'password';
    inp.type = isHidden ? 'text' : 'password';
    show.style.display = isHidden ? 'none' : '';
    hide.style.display = isHidden ? '' : 'none';
    inp.focus();
  });
})();
</script>

{% schema %}
{
  "name": "Password B2B",
  "settings": [
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left heading",
      "default": "Exclusive access for our partners."
    },
    {
      "type": "text",
      "id": "left_desc",
      "label": "Left description",
      "default": "Enter the password to preview our wholesale catalog."
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Up to 40% Margin"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Priority 24h Shipping"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Dedicated B2B Support"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Password Required"
    },
    {
      "type": "text",
      "id": "form_desc",
      "label": "Form description",
      "default": "Enter the store password to continue."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Enter Store"
    }
  ]
}
{% endschema %}
