{%- comment -%}
  sections/main-password-b2b.liquid
  Leather Parfum — B2B Password Page
{%- endcomment -%}

<style>
  /* ═══════════════════════════════════
     Password B2B — Base + Left column
  ═══════════════════════════════════ */

  *, *::before, *::after { box-sizing: border-box; }

  body.password {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background-color: #fafaf9;
    font-family: var(--font-body-family);
  }

  .pw {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Header ───────────────────────── */
  .pw-header {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 40;
    padding: 0 1.5rem;
    height: 5rem;
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 640px) {
    .pw-header { height: 6rem; padding: 0 2.5rem; }
  }

  html.a11y-high-contrast .pw-header {
    background-color: #ffffff;
    border-bottom: 4px solid #000000;
    position: fixed;
  }

  .pw-header__inner {
    width: 100%;
    max-width: 90rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pw-logo {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.5rem;
    color: #ffffff;
    text-decoration: none;
    mix-blend-mode: difference;
  }

  @media screen and (min-width: 640px) { .pw-logo { font-size: 1.875rem; } }

  html.a11y-high-contrast .pw-logo {
    color: #000000 !important;
    mix-blend-mode: normal !important;
  }

  .pw-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pw-a11y {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: rgba(255,255,255,0.1);
    border: none;
    cursor: pointer;
    color: #ffffff;
    mix-blend-mode: difference;
    transition: background-color 0.15s;
  }

  .pw-a11y:hover { background: rgba(255,255,255,0.2); }
  .pw-a11y svg { width: 1.5rem; height: 1.5rem; }

  html.a11y-high-contrast .pw-a11y {
    color: #000000 !important;
    mix-blend-mode: normal !important;
    border: 2px solid #000000 !important;
    background: transparent !important;
  }

  /* ── Main split ───────────────────── */
  .pw-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 1024px) {
    .pw-main {
      flex-direction: row;
      min-height: 100vh;
    }
  }

  /* ── Left column (brand manifesto) ── */
  .pw-left {
    width: 100%;
    padding: 8rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: #1c1917;
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 640px) { .pw-left { padding: 8rem 3rem 4rem; } }

  @media screen and (min-width: 1024px) {
    .pw-left { width: 50%; padding: 7rem 4rem 5rem; }
  }

  @media screen and (min-width: 1280px) { .pw-left { padding: 7rem 5rem 5rem; } }

  .pw-left::before {
    content: '';
    position: absolute;
    top: -20%; right: -20%;
    width: 80%; height: 80%;
    background: radial-gradient(circle, rgba(180,83,9,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  html.a11y-high-contrast .pw-left {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-right: 4px solid #000000;
  }

  html.a11y-high-contrast .pw-left::before { display: none; }

  .pw-left__inner {
    position: relative;
    z-index: 1;
    max-width: 36rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 1024px) { .pw-left__inner { margin: 0; } }

  .pw-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #f59e0b;
    background-color: #292524;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
  }

  .pw-badge svg { width: 0.875rem; height: 0.875rem; fill: currentColor; }

  html.a11y-high-contrast .pw-badge {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .pw-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 1.75rem;
  }

  html.a11y-high-contrast .pw-heading { color: #000000 !important; }

  .pw-desc {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #a8a29e;
    margin: 0 0 2.5rem;
  }

  html.a11y-high-contrast .pw-desc {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  /* Early access card */
  .pw-early {
    background-color: #292524;
    border: 1px solid #44403c;
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  html.a11y-high-contrast .pw-early {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
  }

  .pw-early__title {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e7e5e4;
    margin: 0 0 0.5rem;
  }

  html.a11y-high-contrast .pw-early__title { color: #000000 !important; }

  .pw-early__desc {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #a8a29e;
    margin: 0 0 1.25rem;
  }

  html.a11y-high-contrast .pw-early__desc { color: #000000 !important; }

  .pw-early__form {
    display: flex;
    gap: 0.5rem;
  }

  .pw-early__input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    background-color: #1c1917;
    border: 1px solid #57534e;
    border-radius: 0.75rem;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }

  .pw-early__input::placeholder { color: #78716c; }
  .pw-early__input:focus { border-color: #d97706; }

  html.a11y-high-contrast .pw-early__input {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .pw-early__btn {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    background-color: #b45309;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }

  .pw-early__btn:hover { background-color: #92400e; }

  html.a11y-high-contrast .pw-early__btn {
    background-color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  .pw-early__success {
    display: none;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    background-color: rgba(21,128,61,0.2);
    border: 1px solid #166534;
    border-radius: 0.75rem;
    color: #86efac;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .pw-early__success.is-visible { display: flex; }

  html.a11y-high-contrast .pw-early__success {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }
</style>

<div class="pw">

  {%- comment -%}── Header ──{%- endcomment -%}
  <header class="pw-header" role="banner">
    <div class="pw-header__inner">
      <a href="{{ routes.root_url }}" class="pw-logo">{{ shop.name }}</a>
      <div class="pw-header__actions">
        <button class="pw-a11y" type="button" aria-label="Accessibility options">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="16" cy="4" r="1"/>
            <path d="m18 19 1-7-6 1"/>
            <path d="m5 8 3-3 5.5 3-2.36 3.5"/>
            <path d="M4.24 14.5a5 5 0 0 0 6.88 6"/>
            <path d="M13.76 17.5a5 5 0 0 0-6.88-6"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  {%- comment -%}── Main split ──{%- endcomment -%}
  <main class="pw-main">

    {%- comment -%}── LEFT: Brand manifesto ──{%- endcomment -%}
    <div class="pw-left">
      <div class="pw-left__inner">

        <div class="pw-badge" aria-label="B2B Portal">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
          </svg>
          B2B Portal
        </div>

        <h2 class="pw-heading">Our wholesale portal is currently restricted.</h2>

        <p class="pw-desc">Leather Parfum is a private B2B platform tailored for premium boutiques and concept stores. We are preparing new collections and updating wholesale pricing.</p>

        <div class="pw-early">
          <h3 class="pw-early__title">Want early access?</h3>
          <p class="pw-early__desc">Leave your email to be notified when we accept new partnership applications.</p>

          <div class="pw-early__success" id="EarlySuccess" role="status" aria-live="polite">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:1.125rem;height:1.125rem;flex-shrink:0">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            Email received! We'll be in touch.
          </div>

          <form class="pw-early__form" id="EarlyForm" novalidate>
            <input
              class="pw-early__input"
              type="email"
              placeholder="boutique@email.com"
              autocomplete="email"
              required
              aria-label="Email for early access"
            >
            <button class="pw-early__btn" type="submit">Notify</button>
          </form>
        </div>

      </div>
    </div>

    {%- comment -%}── RIGHT: Password form (added in next prompt) ──{%- endcomment -%}

  </main>
</div>

<script>
(function () {
  if (window.lpPwB2B) return;
  window.lpPwB2B = true;

  var earlyForm    = document.getElementById('EarlyForm');
  var earlySuccess = document.getElementById('EarlySuccess');

  if (earlyForm && earlySuccess) {
    earlyForm.addEventListener('submit', function (e) {
      e.preventDefault();
      earlyForm.style.display = 'none';
      earlySuccess.classList.add('is-visible');
    });
  }
})();
</script>

{% schema %}
{
  "name": "Password B2B",
  "settings": []
}
{% endschema %}
