{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' massy-wrap--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Massy Form Wrapper — inline section styles
     ================================================ */

  .massy-wrap {
    padding: 3rem 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .massy-wrap { padding: 4rem 1.5rem; }
  }

  /* ── Card shell ─────────────────────────────────── */

  .massy-wrap__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  @media screen and (min-width: 600px) { .massy-wrap__card { padding: 2.5rem; } }
  @media screen and (min-width: 990px) { .massy-wrap__card { padding: 3rem; } }

  .massy-wrap--high-contrast .massy-wrap__card,
  html.a11y-high-contrast .massy-wrap__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── Massy field overrides ──────────────────────── */
  /*
     These selectors cover the most common class names Massy uses.
     If the actual classes differ, inspect the rendered HTML and
     update the selectors below to match.
  */

  /* Labels */
  .massy-wrap__card label,
  .massy-wrap__card .massy-label,
  .massy-wrap__card .field-label {
    display: block;
    font-family: var(--font-body-family) !important;
    font-size: 0.9375rem !important;
    font-weight: 700 !important;
    color: #44403c !important;
    margin-bottom: 0.625rem !important;
  }

  html.a11y-high-contrast .massy-wrap__card label,
  html.a11y-high-contrast .massy-wrap__card .massy-label,
  html.a11y-high-contrast .massy-wrap__card .field-label {
    color: #000000 !important;
  }

  /* Inputs, selects, textareas */
  .massy-wrap__card input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]),
  .massy-wrap__card select,
  .massy-wrap__card textarea,
  .massy-wrap__card .massy-input,
  .massy-wrap__card .field-input {
    width: 100% !important;
    padding: 0.875rem 1rem !important;
    font-family: var(--font-body-family) !important;
    font-size: 1rem !important;
    font-weight: 500 !important;
    color: #1c1917 !important;
    background-color: #ffffff !important;
    border: 1.5px solid #d6d3d1 !important;
    border-radius: 0.75rem !important;
    outline: none !important;
    box-sizing: border-box !important;
    transition: border-color 0.15s ease, box-shadow 0.15s ease !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    box-shadow: none !important;
  }

  .massy-wrap__card input:focus,
  .massy-wrap__card select:focus,
  .massy-wrap__card textarea:focus,
  .massy-wrap__card .massy-input:focus,
  .massy-wrap__card .field-input:focus {
    border-color: #b45309 !important;
    box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.15) !important;
  }

  .massy-wrap--high-contrast .massy-wrap__card input,
  .massy-wrap--high-contrast .massy-wrap__card select,
  .massy-wrap--high-contrast .massy-wrap__card textarea,
  html.a11y-high-contrast .massy-wrap__card input,
  html.a11y-high-contrast .massy-wrap__card select,
  html.a11y-high-contrast .massy-wrap__card textarea {
    border: 2px solid #000000 !important;
  }

  /* Checkboxes & radios — keep their native look but tint accent */
  .massy-wrap__card input[type="checkbox"],
  .massy-wrap__card input[type="radio"] {
    width: 1.125rem !important;
    height: 1.125rem !important;
    padding: 0 !important;
    accent-color: #b45309 !important;
    border-radius: 0.25rem !important;
  }

  html.a11y-high-contrast .massy-wrap__card input[type="checkbox"],
  html.a11y-high-contrast .massy-wrap__card input[type="radio"] {
    accent-color: #000000 !important;
  }

  /* Submit button */
  .massy-wrap__card input[type="submit"],
  .massy-wrap__card button[type="submit"],
  .massy-wrap__card .massy-btn,
  .massy-wrap__card .massy-submit {
    width: 100% !important;
    padding: 1.125rem 1.5rem !important;
    font-family: var(--font-body-family) !important;
    font-size: 1.0625rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.075em !important;
    color: #ffffff !important;
    background-color: #1c1917 !important;
    border: 2px solid #1c1917 !important;
    border-radius: 0.75rem !important;
    cursor: pointer !important;
    transition: background-color 0.2s ease, border-color 0.2s ease !important;
    box-shadow: none !important;
    -webkit-appearance: none !important;
    appearance: none !important;
  }

  .massy-wrap__card input[type="submit"]:hover,
  .massy-wrap__card button[type="submit"]:hover,
  .massy-wrap__card .massy-btn:hover,
  .massy-wrap__card .massy-submit:hover {
    background-color: #b45309 !important;
    border-color: #b45309 !important;
  }

  .massy-wrap--high-contrast .massy-wrap__card input[type="submit"],
  .massy-wrap--high-contrast .massy-wrap__card button[type="submit"],
  html.a11y-high-contrast .massy-wrap__card input[type="submit"],
  html.a11y-high-contrast .massy-wrap__card button[type="submit"] {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }

  /* Error messages */
  .massy-wrap__card .massy-error,
  .massy-wrap__card .field-error,
  .massy-wrap__card .error-message {
    font-family: var(--font-body-family) !important;
    font-size: 0.875rem !important;
    font-weight: 700 !important;
    color: #dc2626 !important;
    margin-top: 0.375rem !important;
  }

  html.a11y-high-contrast .massy-wrap__card .massy-error,
  html.a11y-high-contrast .massy-wrap__card .field-error {
    color: #000000 !important;
  }

  /* Success message */
  .massy-wrap__card .massy-success,
  .massy-wrap__card .success-message {
    font-family: var(--font-body-family) !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
    color: #15803d !important;
    background-color: #f0fdf4 !important;
    border: 1px solid #bbf7d0 !important;
    border-radius: 0.75rem !important;
    padding: 1rem 1.25rem !important;
  }

  /* Form row spacing */
  .massy-wrap__card .massy-field,
  .massy-wrap__card .field-group,
  .massy-wrap__card .form-group {
    margin-bottom: 1.25rem !important;
  }

  /* Headings inside form */
  .massy-wrap__card h2,
  .massy-wrap__card h3 {
    font-family: var(--font-heading-family) !important;
    font-weight: var(--font-heading-weight) !important;
    color: #1c1917 !important;
    margin-bottom: 1.5rem !important;
    padding-bottom: 1rem !important;
    border-bottom: 1px solid #e7e5e4 !important;
  }

  html.a11y-high-contrast .massy-wrap__card h2,
  html.a11y-high-contrast .massy-wrap__card h3 {
    color: #000000 !important;
    border-bottom-color: #000000 !important;
  }

  /* ── Two-column page layout ─────────────────────────
     When application-info and this section are used
     together on page.application, they go side-by-side.
  ─────────────────────────────────────────────────── */

  @media screen and (min-width: 990px) {
    .shopify-section:has(.app-info) {
      width: 40%;
      float: left;
      clear: left;
    }

    .shopify-section:has(.massy-wrap) {
      width: 60%;
      float: right;
      clear: right;
    }

    /* Clearfix for the section container */
    .shopify-section:has(.massy-wrap)::after {
      content: '';
      display: table;
      clear: both;
    }
  }
</style>

<div
  class="massy-wrap{{ section_mod }}"
  id="MassyFormWrapper-{{ section.id }}"
>
  <div class="massy-wrap__card">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Massy Form Wrapper",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "info": "White background with black borders.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Massy Form Wrapper"
    }
  ]
}
{% endschema %}
