{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' packages-grid--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Packages Grid — inline section styles
     ================================================ */

  .packages-grid {
    padding: 5rem 1.5rem;
    background-color: #1c1917;
  }

  @media screen and (min-width: 750px) {
    .packages-grid {
      padding: 6rem 1.5rem;
    }
  }

  .packages-grid--high-contrast {
    background-color: #ffffff;
    border: 4px solid #000000;
  }

  html.a11y-high-contrast .packages-grid {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
  }

  .packages-grid__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
  }

  /* ── Cards grid ─────────────────────────────────── */

  .packages-grid__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media screen and (min-width: 750px) {
    .packages-grid__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .packages-grid__cards {
      grid-template-columns: repeat(4, 1fr);
      align-items: stretch;
    }
  }

  /* ── Base card ──────────────────────────────────── */

  .pkg-card {
    position: relative;
    border-radius: 1.25rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    color: #1c1917;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pkg-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  /* ── Featured card ──────────────────────────────── */

  .pkg-card--featured {
    background-color: #b45309;
    border-color: #b45309;
    color: #ffffff;
  }

  .pkg-card--featured:hover {
    box-shadow: 0 20px 40px rgba(180, 83, 9, 0.4);
  }

  /* ── High contrast card overrides ──────────────── */

  .packages-grid--high-contrast .pkg-card,
  html.a11y-high-contrast .pkg-card {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .packages-grid--high-contrast .pkg-card--featured,
  html.a11y-high-contrast .pkg-card--featured {
    background-color: #000000 !important;
    border-color: #000000 !important;
    color: #ffffff !important;
  }

  /* ── Badge ──────────────────────────────────────── */

  .pkg-card__badge-wrap {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
  }

  .pkg-card__badge {
    display: inline-block;
    background-color: #ffffff;
    color: #b45309;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.375rem 1rem;
    border-radius: 0 0 0.75rem 0.75rem;
    white-space: nowrap;
  }

  .packages-grid--high-contrast .pkg-card__badge,
  html.a11y-high-contrast .pkg-card__badge {
    background-color: #ffffff !important;
    color: #000000 !important;
  }

  /* ── Icon ───────────────────────────────────────── */

  .pkg-card__icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .pkg-card--featured .pkg-card__icon {
    margin-top: 1.5rem;
  }

  /* ── Heading & subtitle ─────────────────────────── */

  .pkg-card__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.375rem;
    line-height: 1.2;
    margin: 0 0 0.375rem;
    color: inherit;
  }

  .pkg-card__subtitle {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.7;
    margin: 0 0 1.25rem;
  }

  html.a11y-high-contrast .pkg-card__subtitle {
    opacity: 1 !important;
  }

  /* ── Tags row ───────────────────────────────────── */

  .pkg-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .pkg-card__tag {
    display: inline-block;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
  }

  .pkg-card__tag--sku {
    background-color: rgba(0, 0, 0, 0.08);
    color: inherit;
  }

  .pkg-card--featured .pkg-card__tag--sku {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .pkg-card__tag--discount {
    background-color: rgba(0, 0, 0, 0.08);
    color: inherit;
  }

  .pkg-card--featured .pkg-card__tag--discount {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .packages-grid--high-contrast .pkg-card__tag,
  html.a11y-high-contrast .pkg-card__tag {
    background-color: rgba(0, 0, 0, 0.1) !important;
    color: inherit !important;
  }

  html.a11y-high-contrast .pkg-card--featured .pkg-card__tag {
    background-color: rgba(255, 255, 255, 0.2) !important;
  }

  /* ── Description ────────────────────────────────── */

  .pkg-card__desc {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 1.25rem;
    opacity: 0.85;
    flex-grow: 1;
  }

  .pkg-card__desc p {
    margin: 0;
  }

  html.a11y-high-contrast .pkg-card__desc {
    opacity: 1 !important;
  }

  /* ── Features list ──────────────────────────────── */

  .pkg-card__features {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .pkg-card__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .pkg-card__check {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: #b45309;
  }

  .pkg-card--featured .pkg-card__check {
    color: #fef3c7;
  }

  .packages-grid--high-contrast .pkg-card__check,
  html.a11y-high-contrast .pkg-card__check {
    color: #b45309 !important;
  }

  html.a11y-high-contrast .pkg-card--featured .pkg-card__check {
    color: #ffffff !important;
  }

  /* ── Price block ────────────────────────────────── */

  .pkg-card__price-block {
    margin-bottom: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .pkg-card--featured .pkg-card__price-block {
    border-top-color: rgba(255, 255, 255, 0.2);
  }

  html.a11y-high-contrast .pkg-card__price-block {
    border-top-color: rgba(0, 0, 0, 0.3) !important;
  }

  .pkg-card__price-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.65;
    margin: 0 0 0.25rem;
  }

  html.a11y-high-contrast .pkg-card__price-label {
    opacity: 1 !important;
  }

  .pkg-card__price {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 2rem;
    line-height: 1;
    margin: 0;
    color: inherit;
  }

  /* ── CTA button ─────────────────────────────────── */

  .pkg-card__btn {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    padding: 0.875rem 1.5rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
    border: 2px solid transparent;
    margin-top: auto;
  }

  .pkg-card__btn--standard {
    background-color: #1c1917;
    color: #ffffff;
    border-color: #1c1917;
  }

  .pkg-card__btn--standard:hover {
    background-color: #b45309;
    border-color: #b45309;
  }

  .pkg-card__btn--featured {
    background-color: #ffffff;
    color: #b45309;
    border-color: #ffffff;
  }

  .pkg-card__btn--featured:hover {
    background-color: #fef3c7;
    border-color: #fef3c7;
  }

  .packages-grid--high-contrast .pkg-card__btn--standard,
  html.a11y-high-contrast .pkg-card__btn--standard {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }

  .packages-grid--high-contrast .pkg-card__btn--featured,
  html.a11y-high-contrast .pkg-card__btn--featured {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #ffffff !important;
  }

</style>

<section
  class="packages-grid{{ section_mod }}"
  id="PackagesGrid-{{ section.id }}"
>
  <div class="packages-grid__container">

    {%- if section.blocks.size > 0 -%}
      <div class="packages-grid__cards">

        {%- for block in section.blocks -%}
          {%- liquid
            assign is_featured = block.settings.is_featured
            assign card_mod = ''
            if is_featured
              assign card_mod = ' pkg-card--featured'
            endif
            assign btn_mod = 'pkg-card__btn--standard'
            if is_featured
              assign btn_mod = 'pkg-card__btn--featured'
            endif

            case block.settings.icon
              when 'store'
                assign icon_char = '🏪'
              when 'sparkles'
                assign icon_char = '⭐'
              when 'refresh'
                assign icon_char = '🔄'
              when 'flame'
                assign icon_char = '🔥'
              else
                assign icon_char = '📦'
            endcase
          -%}

          <div
            class="pkg-card{{ card_mod }}"
            {{ block.shopify_attributes }}
          >

            {%- if is_featured and block.settings.badge_label != blank -%}
              <div class="pkg-card__badge-wrap">
                <span class="pkg-card__badge">{{ block.settings.badge_label | escape }}</span>
              </div>
            {%- endif -%}

            <div class="pkg-card__icon" aria-hidden="true">{{ icon_char }}</div>

            {%- if block.settings.heading != blank -%}
              <h3 class="pkg-card__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.subtitle != blank -%}
              <p class="pkg-card__subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}

            {%- if block.settings.tag_sku != blank or block.settings.tag_discount != blank -%}
              <div class="pkg-card__tags">
                {%- if block.settings.tag_sku != blank -%}
                  <span class="pkg-card__tag pkg-card__tag--sku">{{ block.settings.tag_sku | escape }}</span>
                {%- endif -%}
                {%- if block.settings.tag_discount != blank -%}
                  <span class="pkg-card__tag pkg-card__tag--discount">{{ block.settings.tag_discount | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="pkg-card__desc">{{ block.settings.description }}</div>
            {%- endif -%}

            {%- liquid
              assign has_features = false
              if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank or block.settings.feature_4 != blank
                assign has_features = true
              endif
            -%}

            {%- if has_features -%}
              <ul class="pkg-card__features" role="list">
                {%- for i in (1..4) -%}
                  {%- liquid
                    case i
                      when 1
                        assign feat = block.settings.feature_1
                      when 2
                        assign feat = block.settings.feature_2
                      when 3
                        assign feat = block.settings.feature_3
                      when 4
                        assign feat = block.settings.feature_4
                    endcase
                  -%}
                  {%- if feat != blank -%}
                    <li class="pkg-card__feature">
                      <svg class="pkg-card__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{{ feat | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.price != blank -%}
              <div class="pkg-card__price-block">
                {%- if block.settings.price_label != blank -%}
                  <p class="pkg-card__price-label">{{ block.settings.price_label | escape }}</p>
                {%- endif -%}
                <p class="pkg-card__price">{{ block.settings.price | escape }}</p>
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <a
                href="{{ block.settings.button_link | default: '#' }}"
                class="pkg-card__btn {{ btn_mod }}"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}

          </div>
        {%- endfor -%}

      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Packages Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
