{%- liquid
  assign high_contrast = section.settings.high_contrast
  assign section_mod = ''
  if high_contrast
    assign section_mod = ' packages-ws--high-contrast'
  endif
-%}

<style>
  /* ================================================
     Wholesale Packages — inline section styles
     ================================================ */

  .packages-ws {
    padding: 6rem 0;
    background-color: #1c1917;
    color: #ffffff;
  }

  .packages-ws--high-contrast {
    background-color: #ffffff;
    border-top: 4px solid #000000;
    color: #000000;
  }

  .packages-ws__container {
    max-width: var(--page-width, 80rem);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Header ────────────────────────────────── */

  .packages-ws__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .packages-ws__eyebrow {
    display: block;
    font-family: var(--font-body-family);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    color: #f59e0b;
  }

  .packages-ws--high-contrast .packages-ws__eyebrow {
    color: #000000;
  }

  .packages-ws__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.25rem, 5vw, 3rem);
    line-height: 1.15;
    margin: 0 0 1.5rem;
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .packages-ws__heading {
      font-size: clamp(2.75rem, 6vw, 3.75rem);
    }
  }

  .packages-ws--high-contrast .packages-ws__heading {
    color: #000000;
  }

  .packages-ws__subheading {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.65;
    color: #a8a29e;
    max-width: 42rem;
    margin: 0 auto;
  }

  .packages-ws--high-contrast .packages-ws__subheading {
    color: #000000;
    font-weight: 500;
  }

  .packages-ws__subheading p {
    margin: 0;
  }

  /* ── Grid ──────────────────────────────────── */

  .packages-ws__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media screen and (min-width: 990px) {
    .packages-ws__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Package card ──────────────────────────── */

  .pkg-card {
    padding: 2.5rem;
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: #292524;
    border: 1px solid #44403c;
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .pkg-card {
      padding: 3rem;
    }
  }

  .pkg-card--featured {
    background-color: #b45309;
    border-color: transparent;
    box-shadow: 0 25px 50px -12px rgba(120, 53, 15, 0.2);
  }

  .packages-ws--high-contrast .pkg-card {
    background-color: transparent;
    border: 4px solid #000000;
    color: #000000;
    box-shadow: none;
  }

  .packages-ws--high-contrast .pkg-card--featured {
    border: 8px solid #000000;
    box-shadow: none;
  }

  /* ── Top badge ("Best Value") ──────────────── */

  .pkg-card__top-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.375rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 9999px;
    white-space: nowrap;
    background-color: #ffffff;
    color: #92400e;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.15);
  }

  .packages-ws--high-contrast .pkg-card__top-badge {
    background-color: #000000;
    color: #ffffff;
    box-shadow: none;
  }

  /* ── Card header ───────────────────────────── */

  .pkg-card__header {
    margin-bottom: 2rem;
  }

  .pkg-card--featured .pkg-card__header {
    padding-top: 1rem;
  }

  .pkg-card__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.875rem;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .pkg-card__badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Inline SKU / discount tags */
  .pkg-card__tag {
    padding: 0.25rem 0.75rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 0.375rem;
    line-height: 1.5;
  }

  /* Standard card tags */
  .pkg-card__tag--sku {
    background-color: #1c1917;
    color: #d6d3d1;
  }

  .pkg-card__tag--discount {
    background-color: rgba(120, 53, 15, 0.5);
    color: #f59e0b;
  }

  /* Featured card tags */
  .pkg-card--featured .pkg-card__tag--sku {
    background-color: #92400e;
    color: #fffbeb;
  }

  .pkg-card--featured .pkg-card__tag--discount {
    background-color: #ffffff;
    color: #92400e;
  }

  /* High contrast tags — all variants */
  .packages-ws--high-contrast .pkg-card__tag--sku,
  .packages-ws--high-contrast .pkg-card__tag--discount,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__tag--sku,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__tag--discount {
    background-color: transparent;
    color: #000000;
    border: 2px solid #000000;
  }

  /* ── Description ───────────────────────────── */

  .pkg-card__description {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.65;
    color: #a8a29e;
    flex-grow: 1;
    margin-bottom: 2.5rem;
  }

  .pkg-card--featured .pkg-card__description {
    color: #fef3c7;
  }

  .packages-ws--high-contrast .pkg-card__description,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__description {
    color: #000000;
    font-weight: 500;
  }

  .pkg-card__description p {
    margin: 0;
  }

  /* ── Footer (price + button) ───────────────── */

  .pkg-card__footer {
    border-top: 1px solid #44403c;
    padding-top: 2rem;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media screen and (min-width: 600px) {
    .pkg-card__footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .pkg-card--featured .pkg-card__footer {
    border-top-color: #d97706;
  }

  .packages-ws--high-contrast .pkg-card__footer,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__footer {
    border-top-color: #000000;
  }

  .pkg-card__price-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #78716c;
    margin: 0 0 0.25rem;
  }

  .pkg-card--featured .pkg-card__price-label {
    color: #fde68a;
  }

  .packages-ws--high-contrast .pkg-card__price-label,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__price-label {
    color: #78716c;
  }

  .pkg-card__price {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .packages-ws--high-contrast .pkg-card__price,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__price {
    color: #000000;
  }

  /* ── Card button ───────────────────────────── */

  .pkg-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1;
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease;
    background-color: #ffffff;
    color: #1c1917;
  }

  @media screen and (min-width: 600px) {
    .pkg-card__btn {
      width: auto;
    }
  }

  .pkg-card__btn:hover {
    background-color: #e7e5e4;
  }

  .pkg-card--featured .pkg-card__btn {
    background-color: #1c1917;
    color: #ffffff;
  }

  .pkg-card--featured .pkg-card__btn:hover {
    background-color: #000000;
  }

  .packages-ws--high-contrast .pkg-card .pkg-card__btn,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__btn {
    background-color: #000000;
    color: #ffffff;
  }

  .packages-ws--high-contrast .pkg-card .pkg-card__btn:hover,
  .packages-ws--high-contrast .pkg-card--featured .pkg-card__btn:hover {
    background-color: #292524;
  }

  /* ── More packages CTA ─────────────────────── */

  .packages-ws__more {
    text-align: center;
  }

  .packages-ws__more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    border-radius: 0.75rem;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1;
    text-decoration: none;
    border: 1px solid #57534e;
    color: #ffffff;
    background-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .packages-ws__more-btn:hover {
    background-color: #292524;
    color: #ffffff;
  }

  .packages-ws--high-contrast .packages-ws__more-btn {
    border: 4px solid #000000;
    color: #000000;
  }

  .packages-ws--high-contrast .packages-ws__more-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .packages-ws__more-btn-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }
</style>

<section
  class="packages-ws{{ section_mod }}"
  id="PackagesWholesale-{{ section.id }}"
>
  <div class="packages-ws__container">

    {%- comment -%} ── Section header ── {%- endcomment -%}
    <header class="packages-ws__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="packages-ws__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="packages-ws__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="packages-ws__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </header>

    {%- comment -%} ── Package cards ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="packages-ws__grid">

        {%- for block in section.blocks -%}
          {%- liquid
            assign card_mod = ''
            if block.settings.is_featured
              assign card_mod = ' pkg-card--featured'
            endif
          -%}

          <article class="pkg-card{{ card_mod }}" {{ block.shopify_attributes }}>

            {%- if block.settings.badge_label != blank -%}
              <div class="pkg-card__top-badge">
                {{- block.settings.badge_label | escape -}}
              </div>
            {%- endif -%}

            <div class="pkg-card__header">
              {%- if block.settings.heading != blank -%}
                <h3 class="pkg-card__heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              <div class="pkg-card__badges">
                {%- if block.settings.tag_sku != blank -%}
                  <span class="pkg-card__tag pkg-card__tag--sku">
                    {{- block.settings.tag_sku | escape -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.tag_discount != blank -%}
                  <span class="pkg-card__tag pkg-card__tag--discount">
                    {{- block.settings.tag_discount | escape -}}
                  </span>
                {%- endif -%}
              </div>
            </div>

            {%- if block.settings.description != blank -%}
              <div class="pkg-card__description">{{ block.settings.description }}</div>
            {%- endif -%}

            <div class="pkg-card__footer">
              <div class="pkg-card__price-block">
                {%- if block.settings.price_label != blank -%}
                  <p class="pkg-card__price-label">{{ block.settings.price_label | escape }}</p>
                {%- endif -%}
                {%- if block.settings.price != blank -%}
                  <p class="pkg-card__price">{{ block.settings.price | escape }}</p>
                {%- endif -%}
              </div>

              {%- if block.settings.button_label != blank -%}
                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="pkg-card__btn"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>

          </article>
        {%- endfor -%}

      </div>
    {%- endif -%}

    {%- comment -%} ── More packages CTA ── {%- endcomment -%}
    {%- if section.settings.more_label != blank -%}
      <div class="packages-ws__more">
        <a
          href="{{ section.settings.more_link | default: '#' }}"
          class="packages-ws__more-btn"
        >
          {{- section.settings.more_label | escape -}}
          <svg class="packages-ws__more-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% render 'accessibility-panel' %}

{% schema %}
{
  "name": "Wholesale Packages",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "high_contrast",
      "label": "High contrast mode",
      "info": "White background with black borders.",
      "default": false
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Getting Started"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Ready-Made Solutions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We've designed optimal packages for a quick sales launch. Choose the one that best fits your retail format.</p>"
    },
    {
      "type": "header",
      "content": "More packages button"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Button label",
      "default": "View more wholesale packages"
    },
    {
      "type": "url",
      "id": "more_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        {
          "type": "header",
          "content": "Style"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Featured card (amber highlight)",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_label",
          "label": "Top badge text",
          "info": "e.g. \"Best Value\". Leave blank to hide.",
          "default": ""
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Package name",
          "default": "Package Name"
        },
        {
          "type": "text",
          "id": "tag_sku",
          "label": "SKU count tag",
          "default": "20 SKUs"
        },
        {
          "type": "text",
          "id": "tag_discount",
          "label": "Discount tag",
          "default": "10% Discount"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Description of what this package includes and who it is for.</p>"
        },
        {
          "type": "header",
          "content": "Pricing"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Investment"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "from 25,000 CZK"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Wholesale Packages",
      "blocks": [
        {
          "type": "package",
          "settings": {
            "is_featured": false,
            "badge_label": "",
            "heading": "Fragrance Corner",
            "tag_sku": "20 SKUs",
            "tag_discount": "10% Discount",
