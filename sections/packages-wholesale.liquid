{%- liquid
  assign heading         = section.settings.heading         | default: 'Ready-Made Solutions'
  assign getting_started = section.settings.getting_started_text | default: 'Getting Started'
  assign subheading      = section.settings.subheading

  assign p1_name     = section.settings.p1_name      | default: 'Fragrance Corner'
  assign p1_desc     = section.settings.p1_desc
  assign p1_skus     = section.settings.p1_skus      | default: '20 SKUs'
  assign p1_discount = section.settings.p1_discount  | default: '10% Discount'
  assign p1_price    = section.settings.p1_price     | default: 'from 25,000 CZK'
  assign p1_btn      = section.settings.p1_btn_label | default: 'Learn More'
  assign p1_link     = section.settings.p1_btn_link

  assign p2_name     = section.settings.p2_name      | default: 'Boutique Launch'
  assign p2_desc     = section.settings.p2_desc
  assign p2_skus     = section.settings.p2_skus      | default: '60 SKUs'
  assign p2_discount = section.settings.p2_discount  | default: '15% Discount'
  assign p2_price    = section.settings.p2_price     | default: 'from 50,000 CZK'
  assign p2_btn      = section.settings.p2_btn_label | default: 'Apply Now'
  assign p2_link     = section.settings.p2_btn_link
  assign p2_badge    = section.settings.p2_badge     | default: 'Best Value'

  assign more_label = section.settings.more_label | default: 'View more wholesale packages'
  assign more_link  = section.settings.more_link
-%}

<style>
  /* ================================================
     Packages Wholesale — inline section styles
     ================================================ */

  .pkg-wh {
    background-color: #1c1917;
    color: #ffffff;
    padding: 5rem 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .pkg-wh { padding: 6rem 1.5rem; }
  }

  html.a11y-high-contrast .pkg-wh {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-top: 4px solid #000000 !important;
  }

  .pkg-wh__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
  }

  /* ── Header ───────────────────────────────────────── */
  .pkg-wh__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .pkg-wh__eyebrow {
    display: block;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f59e0b;
    margin-bottom: 1rem;
  }

  html.a11y-high-contrast .pkg-wh__eyebrow {
    color: #000000 !important;
  }

  .pkg-wh__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 1.5rem;
  }

  html.a11y-high-contrast .pkg-wh__heading {
    color: #000000 !important;
  }

  .pkg-wh__subheading {
    max-width: 42rem;
    margin: 0 auto;
    font-family: var(--font-body-family);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
    color: #a8a29e;
  }

  html.a11y-high-contrast .pkg-wh__subheading {
    color: #000000 !important;
    font-weight: 500;
  }

  /* ── Cards grid ───────────────────────────────────── */
  .pkg-wh__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  @media screen and (min-width: 990px) {
    .pkg-wh__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* ── Card base ────────────────────────────────────── */
  .pkg-wh__card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    border-radius: 1.5rem;
    background-color: #292524;
    border: 1px solid #44403c;
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .pkg-wh__card { padding: 3rem; }
  }

  html.a11y-high-contrast .pkg-wh__card {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
  }

  /* ── Card — featured variant ─────────────────────── */
  .pkg-wh__card--featured {
    background-color: #b45309;
    border-color: transparent;
    box-shadow: 0 25px 50px -12px rgba(120, 53, 15, 0.4);
  }

  html.a11y-high-contrast .pkg-wh__card--featured {
    background-color: #ffffff !important;
    border: 8px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── "Best Value" badge ──────────────────────────── */
  .pkg-wh__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.5rem 1.5rem;
    background-color: #ffffff;
    color: #78350f;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 9999px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    white-space: nowrap;
  }

  html.a11y-high-contrast .pkg-wh__badge {
    background-color: #000000 !important;
    color: #ffffff !important;
    box-shadow: none !important;
  }

  /* Push content down on featured card to accommodate badge */
  .pkg-wh__card--featured .pkg-wh__card-head {
    padding-top: 1rem;
  }

  /* ── Card header ──────────────────────────────────── */
  .pkg-wh__card-head {
    margin-bottom: 2rem;
  }

  .pkg-wh__card-title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.2;
    color: inherit;
    margin: 0 0 1rem;
  }

  .pkg-wh__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .pkg-wh__tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    border-radius: 0.375rem;
  }

  .pkg-wh__tag--skus {
    background-color: #1c1917;
    color: #d6d3d1;
  }

  .pkg-wh__tag--discount {
    background-color: rgba(120, 53, 15, 0.5);
    color: #f59e0b;
  }

  /* Featured card tags */
  .pkg-wh__card--featured .pkg-wh__tag--skus {
    background-color: #92400e;
    color: #fffbeb;
  }

  .pkg-wh__card--featured .pkg-wh__tag--discount {
    background-color: #ffffff;
    color: #78350f;
  }

  html.a11y-high-contrast .pkg-wh__tag {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  /* ── Card description ─────────────────────────────── */
  .pkg-wh__card-desc {
    flex-grow: 1;
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.7;
    color: #a8a29e;
    margin: 0 0 2.5rem;
  }

  .pkg-wh__card--featured .pkg-wh__card-desc {
    color: #fef3c7;
  }

  html.a11y-high-contrast .pkg-wh__card-desc {
    color: #000000 !important;
    font-weight: 500;
  }

  /* ── Card footer ──────────────────────────────────── */
  .pkg-wh__card-foot {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
    padding-top: 2rem;
    margin-top: auto;
    border-top: 1px solid #44403c;
  }

  @media screen and (min-width: 600px) {
    .pkg-wh__card-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .pkg-wh__card--featured .pkg-wh__card-foot {
    border-top-color: #d97706;
  }

  html.a11y-high-contrast .pkg-wh__card-foot {
    border-top-color: #000000 !important;
  }

  .pkg-wh__price-label {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #78716c;
    margin: 0 0 0.25rem;
  }

  .pkg-wh__card--featured .pkg-wh__price-label {
    color: #fcd34d;
  }

  html.a11y-high-contrast .pkg-wh__price-label {
    color: #000000 !important;
  }

  .pkg-wh__price-value {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
    color: inherit;
    margin: 0;
  }

  /* ── Card CTA button ──────────────────────────────── */
  .pkg-wh__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 2rem;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    border: 2px solid transparent;
    white-space: nowrap;
  }

  @media screen and (min-width: 600px) {
    .pkg-wh__btn { width: auto; }
  }

  /* Standard card button */
  .pkg-wh__btn--light {
    background-color: #ffffff;
    color: #1c1917;
    border-color: #ffffff;
  }

  .pkg-wh__btn--light:hover {
    background-color: #e7e5e4;
    border-color: #e7e5e4;
    color: #1c1917;
  }

  /* Featured card button */
  .pkg-wh__btn--dark {
    background-color: #1c1917;
    color: #ffffff;
    border-color: #1c1917;
  }

  .pkg-wh__btn--dark:hover {
    background-color: #292524;
    border-color: #292524;
    color: #ffffff;
  }

  html.a11y-high-contrast .pkg-wh__btn {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }

  html.a11y-high-contrast .pkg-wh__btn:hover {
    background-color: #292524 !important;
    border-color: #292524 !important;
  }

  /* ── "View more" button ──────────────────────────── */
  .pkg-wh__more-wrap {
    text-align: center;
  }

  .pkg-wh__more {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #ffffff;
    background-color: transparent;
    border: 1px solid #57534e;
    border-radius: 0.75rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .pkg-wh__more:hover {
    background-color: #292524;
    color: #ffffff;
    border-color: #57534e;
  }

  html.a11y-high-contrast .pkg-wh__more {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 4px solid #000000 !important;
  }

  html.a11y-high-contrast .pkg-wh__more:hover {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .pkg-wh__more-arrow {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .pkg-wh__more:hover .pkg-wh__more-arrow {
    transform: translateX(4px);
  }
</style>

<section class="pkg-wh" id="PackagesWholesale-{{ section.id }}">
  <div class="pkg-wh__inner">

    <!-- Header -->
    <div class="pkg-wh__header">
      <span class="pkg-wh__eyebrow">{{ getting_started }}</span>
      <h2 class="pkg-wh__heading">{{ heading }}</h2>
      {%- if subheading != blank -%}
        <p class="pkg-wh__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <!-- Cards grid -->
    <div class="pkg-wh__grid">

      <!-- Card 1: Fragrance Corner -->
      <article class="pkg-wh__card">
        <header class="pkg-wh__card-head">
          <h3 class="pkg-wh__card-title">{{ p1_name }}</h3>
          <div class="pkg-wh__tags">
            {%- if p1_skus != blank -%}
              <span class="pkg-wh__tag pkg-wh__tag--skus">{{ p1_skus }}</span>
            {%- endif -%}
            {%- if p1_discount != blank -%}
              <span class="pkg-wh__tag pkg-wh__tag--discount">{{ p1_discount }}</span>
            {%- endif -%}
          </div>
        </header>

        {%- if p1_desc != blank -%}
          <p class="pkg-wh__card-desc">{{ p1_desc }}</p>
        {%- endif -%}

        <footer class="pkg-wh__card-foot">
          <div>
            <p class="pkg-wh__price-label">Investment</p>
            <p class="pkg-wh__price-value">{{ p1_price }}</p>
          </div>
          <a href="{{ p1_link | default: '#' }}" class="pkg-wh__btn pkg-wh__btn--light">
            {{ p1_btn }}
          </a>
        </footer>
      </article>

      <!-- Card 2: Boutique Launch (featured) -->
      <article class="pkg-wh__card pkg-wh__card--featured">
        {%- if p2_badge != blank -%}
          <span class="pkg-wh__badge">{{ p2_badge }}</span>
        {%- endif -%}

        <header class="pkg-wh__card-head">
          <h3 class="pkg-wh__card-title">{{ p2_name }}</h3>
          <div class="pkg-wh__tags">
            {%- if p2_skus != blank -%}
              <span class="pkg-wh__tag pkg-wh__tag--skus">{{ p2_skus }}</span>
            {%- endif -%}
            {%- if p2_discount != blank -%}
              <span class="pkg-wh__tag pkg-wh__tag--discount">{{ p2_discount }}</span>
            {%- endif -%}
          </div>
        </header>

        {%- if p2_desc != blank -%}
          <p class="pkg-wh__card-desc">{{ p2_desc }}</p>
        {%- endif -%}

        <footer class="pkg-wh__card-foot">
          <div>
            <p class="pkg-wh__price-label">Investment</p>
            <p class="pkg-wh__price-value">{{ p2_price }}</p>
          </div>
          <a href="{{ p2_link | default: '#' }}" class="pkg-wh__btn pkg-wh__btn--dark">
            {{ p2_btn }}
          </a>
        </footer>
      </article>

    </div><!-- /.pkg-wh__grid -->

    <!-- More packages button -->
    {%- if more_label != blank -%}
      <div class="pkg-wh__more-wrap">
        <a href="{{ more_link | default: '#' }}" class="pkg-wh__more">
          {{ more_label }}
          <svg class="pkg-wh__more-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div><!-- /.pkg-wh__inner -->
</section>

{% schema %}
{
  "name": "Packages Wholesale",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "getting_started_text",
      "label": "Eyebrow text",
      "default": "Getting Started"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready-Made Solutions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We've designed optimal packages for a quick sales launch. Choose the one that best fits your retail format."
    },

    {
      "type": "header",
      "content": "Card 1 — Standard"
    },
    {
      "type": "text",
      "id": "p1_name",
      "label": "Card name",
      "default": "Fragrance Corner"
    },
    {
      "type": "text",
      "id": "p1_skus",
      "label": "SKU count (tag)",
      "default": "20 SKUs"
    },
    {
      "type": "text",
      "id": "p1_discount",
      "label": "Discount (tag)",
      "default": "10% Discount"
    },
    {
      "type": "textarea",
      "id": "p1_desc",
      "label": "Description",
      "default": "Ideal for existing clothing or shoe boutiques. A compact display featuring the most popular fragrances for cross-selling. Includes a basic tester set."
    },
    {
      "type": "text",
      "id": "p1_price",
      "label": "Investment (price)",
      "default": "from 25,000 CZK"
    },
    {
      "type": "text",
      "id": "p1_btn_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "p1_btn_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Card 2 — Featured (Best Value)"
    },
    {
      "type": "text",
      "id": "p2_badge",
      "label": "Badge text",
      "default": "Best Value"
    },
    {
      "type": "text",
      "id": "p2_name",
      "label": "Card name",
      "default": "Boutique Launch"
    },
    {
      "type": "text",
      "id": "p2_skus",
      "label": "SKU count (tag)",
      "default": "60 SKUs"
    },
    {
      "type": "text",
      "id": "p2_discount",
      "label": "Discount (tag)",
      "default": "15% Discount"
    },
    {
      "type": "textarea",
      "id": "p2_desc",
      "label": "Description",
      "default": "Full inventory for a new store. Includes the entire fragrance line, leather accessories, gift sets, and extensive marketing support with a dedicated manager."
    },
    {
      "type": "text",
      "id": "p2_price",
      "label": "Investment (price)",
      "default": "from 50,000 CZK"
    },
    {
      "type": "text",
      "id": "p2_btn_label",
      "label": "Button label",
      "default": "Apply Now"
    },
    {
      "type": "url",
      "id": "p2_btn_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "\"View More\" Button"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Button label",
      "default": "View more wholesale packages"
    },
    {
      "type": "url",
      "id": "more_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Packages Wholesale"
    }
  ]
}
{% endschema %}
