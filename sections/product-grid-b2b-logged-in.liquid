{%- liquid
  assign atc_label       = section.settings.atc_label       | default: 'Add to Order'
  assign oos_label       = section.settings.oos_label       | default: 'Out of Stock'
  assign empty_heading   = section.settings.empty_heading   | default: 'No products found'
  assign clear_label     = section.settings.clear_label     | default: 'Clear Filters'

  assign is_wholesale = false
  if customer and customer.b2b? or customer.tags contains 'wholesale'
    assign is_wholesale = true
  endif
-%}

<style>
  /* ── Layout: float right next to sidebar ─────────── */
  @media screen and (min-width: 990px) {
    .shopify-section:has(.pgbl) {
      float: right;
      width: calc(100% - 320px);
      clear: right;
    }
    .shopify-section:has(.pgbl)::after {
      content: '';
      display: table;
      clear: both;
    }
  }

  /* Contain the sidebar + grid floats so <main> keeps the height of the
     taller column. Without this, main collapses to the header height and
     the footer (and any later section) wraps beside the sidebar whenever a
     filter leaves only a few cards (e.g. "Belt"). */
  #MainContent:has(.pgbl) { display: flow-root; }
  .shopify-section:has(.pgbl) ~ .shopify-section { clear: both; }

  .pgbl {
    padding: 2rem 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .pgbl { padding: 2.5rem 0 2.5rem 2rem; }
  }

  /* ── Meta bar ─────────────────────────────────────── */
  .pgbl__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pgbl__count {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #78716c;
  }

  html.a11y-high-contrast .pgbl__count { color: #000000 !important; }

  .pgbl__active-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    background-color: #f5f5f4;
    color: #1c1917;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .pgbl__active-filter:hover { background-color: #e7e5e4; }

  html.a11y-high-contrast .pgbl__active-filter {
    border: 2px solid #000000 !important;
    background-color: #ffffff !important;
  }

  /* ── Grid ─────────────────────────────────────────── */
  .pgbl__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 600px) { .pgbl__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (min-width: 1200px) { .pgbl__grid { grid-template-columns: repeat(3, 1fr); } }

  /* ── Card ─────────────────────────────────────────── */
  .pgbl__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.25rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease;
  }

  .pgbl__card:hover { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }

  html.a11y-high-contrast .pgbl__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  .pgbl__card[hidden] { display: none !important; }

  .pgbl__card--oos {
    opacity: 0.6;
    filter: grayscale(1);
  }

  /* Image */
  .pgbl__img-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 0.875rem;
    overflow: hidden;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  html.a11y-high-contrast .pgbl__img-wrap { border: 2px solid #000000 !important; }

  .pgbl__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .pgbl__card:hover .pgbl__img { transform: scale(1.04); }

  .pgbl__img-placeholder { color: #d6d3d1; }
  .pgbl__img-placeholder svg { width: 3rem; height: 3rem; }

  /* Badges */
  .pgbl__badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pgbl__badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 0.375rem;
    background-color: #1c1917;
    color: #ffffff;
  }

  .pgbl__badge--amber { background-color: #b45309; }

  html.a11y-high-contrast .pgbl__badge {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  /* Body */
  .pgbl__body { flex-grow: 1; display: flex; flex-direction: column; }

  .pgbl__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .pgbl__category {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #78716c;
  }

  html.a11y-high-contrast .pgbl__category { color: #000000 !important; }

  .pgbl__sku {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #a8a29e;
    background-color: #f5f5f4;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
  }

  html.a11y-high-contrast .pgbl__sku {
    background-color: #f0f0f0 !important;
    color: #000000 !important;
  }

  .pgbl__title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.125rem;
    color: #1c1917;
    margin: 0 0 0.375rem;
    line-height: 1.3;
  }

  html.a11y-high-contrast .pgbl__title { color: #000000 !important; }

  .pgbl__size {
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    color: #78716c;
    margin: 0 0 1rem;
  }

  html.a11y-high-contrast .pgbl__size { color: #000000 !important; }

  /* Foot */
  .pgbl__foot { margin-top: auto; }

  /* Stock row */
  .pgbl__stock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  .pgbl__stock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #57534e;
  }

  html.a11y-high-contrast .pgbl__stock { color: #000000 !important; }

  .pgbl__stock-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .pgbl__stock-dot--green { background-color: #22c55e; }
  .pgbl__stock-dot--amber { background-color: #f59e0b; }
  .pgbl__stock-dot--red   { background-color: #ef4444; }

  html.a11y-high-contrast .pgbl__stock-dot { background-color: #000000 !important; }

  /* Price block */
  .pgbl__prices {
    padding-top: 0.875rem;
    border-top: 1px solid #e7e5e4;
    margin-bottom: 1rem;
  }

  html.a11y-high-contrast .pgbl__prices { border-top-color: #000000 !important; }

  .pgbl__price-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .pgbl__price-label {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #78716c;
    margin: 0;
    line-height: 1.4;
  }

  html.a11y-high-contrast .pgbl__price-label { color: #000000 !important; }

  .pgbl__price-label--wsp { color: #b45309; }

  html.a11y-high-contrast .pgbl__price-label--wsp { color: #000000 !important; }

  .pgbl__rrp-val {
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #a8a29e;
    text-decoration: line-through;
  }

  /* Guests: RRP is the price they pay — show it plainly */
  .pgbl__rrp-val--retail {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 400;
    color: #1c1917;
    text-decoration: none;
  }

  html.a11y-high-contrast .pgbl__rrp-val--retail { color: #000000 !important; }

  .pgbl__wsp-val {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.375rem;
    color: #1c1917;
    line-height: 1;
  }

  html.a11y-high-contrast .pgbl__wsp-val { color: #000000 !important; }

  .pgbl__margin {
    text-align: right;
    margin-top: 0.375rem;
  }

  .pgbl__margin-badge {
    display: inline-block;
    padding: 0.2rem 0.625rem;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 0.375rem;
    background-color: #dcfce7;
    color: #15803d;
  }

  html.a11y-high-contrast .pgbl__margin-badge {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  /* Qty + ATC */
  .pgbl__atc-wrap { display: flex; flex-direction: column; gap: 0.625rem; }

  .pgbl__qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    padding: 0.25rem;
  }

  html.a11y-high-contrast .pgbl__qty-row {
    border: 2px solid #000000 !important;
    background-color: #ffffff !important;
  }

  .pgbl__qty-btn {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    border-radius: 0.625rem;
    cursor: pointer;
    color: #57534e;
    font-size: 1.25rem;
    line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .pgbl__qty-btn:hover {
    background-color: #e7e5e4;
    color: #1c1917;
  }

  html.a11y-high-contrast .pgbl__qty-btn { color: #000000 !important; }
  html.a11y-high-contrast .pgbl__qty-btn:hover { background-color: #e0e0e0 !important; }

  .pgbl__qty-input {
    width: 4rem;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1c1917;
    background: none;
    border: none;
    outline: none;
    -moz-appearance: textfield;
  }

  .pgbl__qty-input::-webkit-inner-spin-button,
  .pgbl__qty-input::-webkit-outer-spin-button { -webkit-appearance: none; }

  html.a11y-high-contrast .pgbl__qty-input { color: #000000 !important; }

  .pgbl__atc-btn {
    width: 100%;
    padding: 0.9375rem 1rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.75rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .pgbl__atc-btn:hover {
    background-color: #ea580c;
    border-color: #ea580c;
  }

  .pgbl__atc-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .pgbl__atc-btn.is-error {
    background-color: #b91c1c;
    border-color: #b91c1c;
    font-size: 0.8125rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .pgbl__title-link { color: inherit; text-decoration: none; }
  .pgbl__title-link:hover { color: #b45309; text-decoration: underline; text-underline-offset: 3px; }
  .pgbl__title-link:focus-visible { outline: 2px solid #b45309; outline-offset: 2px; }
  a.pgbl__img-wrap { cursor: pointer; }

  .pgbl__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
  }

  .pgbl__page-link {
    color: #1c1917;
    font-weight: 700;
    text-decoration: none;
    padding: 0.625rem 1.25rem;
    border: 1px solid #d6d3d1;
    border-radius: 0.75rem;
  }

  .pgbl__page-link:hover { border-color: #b45309; color: #b45309; }
  .pgbl__page-info { color: #78716c; }

  html.a11y-high-contrast .pgbl__page-link { border: 2px solid #000000 !important; color: #000000 !important; }

  .pgbl__atc-btn.is-success {
    background-color: #15803d;
    border-color: #15803d;
  }

  html.a11y-high-contrast .pgbl__atc-btn {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }

  /* Guest / non-wholesale prompt */
  .pgbl__login-btn {
    box-sizing: border-box;
    text-decoration: none;
    color: #1c1917;
    background-color: transparent;
  }

  .pgbl__login-btn:hover { color: #ffffff; }

  html.a11y-high-contrast .pgbl__login-btn {
    background-color: #ffffff !important;
    color: #000000 !important;
  }

  .pgbl__atc-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  /* OOS button */
  .pgbl__oos-btn {
    width: 100%;
    padding: 0.9375rem 1rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #a8a29e;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    cursor: not-allowed;
    text-align: center;
  }

  html.a11y-high-contrast .pgbl__oos-btn {
    border: 2px solid #000000 !important;
    color: #000000 !important;
    background-color: #f0f0f0 !important;
  }

  /* Empty state */
  .pgbl__empty {
    text-align: center;
    padding: 4rem 2rem;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.5rem;
    display: none;
  }

  .pgbl__empty.is-visible { display: block; }

  html.a11y-high-contrast .pgbl__empty { border: 4px solid #000000 !important; }

  .pgbl__empty-icon { width: 3.5rem; height: 3.5rem; color: #d6d3d1; margin: 0 auto 1.25rem; }
  .pgbl__empty-icon svg { width: 100%; height: 100%; }

  .pgbl__empty-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.375rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }

  html.a11y-high-contrast .pgbl__empty-heading { color: #000000 !important; }

  .pgbl__empty-text {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #78716c;
    margin: 0 0 1.5rem;
  }

  html.a11y-high-contrast .pgbl__empty-text { color: #000000 !important; }

  .pgbl__empty-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pgbl__empty-btn:hover { background-color: #ea580c; border-color: #ea580c; color: #ffffff; }

  html.a11y-high-contrast .pgbl__empty-btn {
    background-color: #000000 !important;
    border-color: #000000 !important;
  }
</style>

<div class="pgbl" id="ProductGridLoggedIn-{{ section.id }}">

  <!-- Meta bar -->
  <div class="pgbl__meta">
    <p class="pgbl__count" id="PgblCount-{{ section.id }}" aria-live="polite">
      Showing {{ collection.products_count }} item{% if collection.products_count != 1 %}s{% endif %}
    </p>
    <button
      class="pgbl__active-filter"
      id="PgblActiveFilter-{{ section.id }}"
      style="display:none"
      aria-live="polite"
      type="button"
    ></button>
  </div>

  <!-- Grid -->
  {%- paginate collection.products by 250 -%}
  <div class="pgbl__grid" id="PgblGrid-{{ section.id }}">

    {%- for product in collection.products -%}
      {%- liquid
        assign v   = product.selected_or_first_available_variant
        assign sku = v.sku | default: product.id

        comment — determine stock state
        endcomment
        if v.available
          assign inv_qty = v.inventory_quantity | default: 99
          if inv_qty > 0 and inv_qty < 5
            assign stock_label = 'Low Stock'
            assign stock_mod   = 'amber'
          else
            assign stock_label = 'In Stock'
            assign stock_mod   = 'green'
          endif
        else
          assign stock_label = 'Out of Stock'
          assign stock_mod   = 'red'
        endif

        comment — Prices. WSP is the price Shopify charges this customer:
          for B2B buyers variant.price already comes from their catalog.
          RRP comes from the custom.rrp metafield (compare_at_price is
          null for B2B buyers); guests fall back to the regular price.
        endcomment
        assign wsp_cents = v.price
        capture rrp_cents
          render 'money-meta-cents', value: product.metafields.custom.rrp.value
        endcapture
        assign rrp_cents = rrp_cents | strip | plus: 0
        if rrp_cents == 0
          assign cap_cents = v.compare_at_price | default: 0
          if cap_cents > wsp_cents
            assign rrp_cents = cap_cents
          elsif is_wholesale == false
            assign rrp_cents = wsp_cents
          endif
        endif

        comment — Margin %
        endcomment
        assign margin = 0
        if rrp_cents > wsp_cents and wsp_cents > 0
          assign margin = rrp_cents | minus: wsp_cents | times: 100.0 | divided_by: wsp_cents | round
        endif

        comment — Size/option
        endcomment
        assign first_option = v.option1 | default: ''
        if v.option2 != blank
          assign first_option = first_option | append: ' / ' | append: v.option2
        endif
        assign img_alt = product.featured_image.alt | default: product.title | escape

        comment — Badge from tags or metafield
        endcomment
        assign badge_meta = product.metafields.custom.badge
      -%}

      <div
        class="pgbl__card{% unless v.available %} pgbl__card--oos{% endunless %}"
        data-title="{{ product.title | downcase | escape }}"
        data-sku="{{ sku | downcase | escape }}"
        data-category="{{ product.type | escape }}"
        data-available="{{ v.available }}"
      >
        <!-- Image -->
        <a href="{{ product.url }}" class="pgbl__img-wrap" tabindex="-1" aria-hidden="true">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 600 | image_tag:
              class: 'pgbl__img',
              alt: img_alt,
              loading: 'lazy',
              width: product.featured_image.width,
              height: product.featured_image.height
            }}
          {%- else -%}
            <div class="pgbl__img-placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          {%- endif -%}

          <div class="pgbl__badges" aria-hidden="true">
            {%- if badge_meta != blank -%}
              <span class="pgbl__badge">{{ badge_meta }}</span>
            {%- elsif product.tags contains 'Bestseller' -%}
              <span class="pgbl__badge">Bestseller</span>
            {%- elsif product.tags contains 'New' -%}
              <span class="pgbl__badge pgbl__badge--amber">New</span>
            {%- elsif product.tags contains 'B2B Only' -%}
              <span class="pgbl__badge">B2B Only</span>
            {%- endif -%}
          </div>
        </a>

        <!-- Body -->
        <div class="pgbl__body">
          <div class="pgbl__meta-row">
            <span class="pgbl__category">{{ product.type | default: 'Product' }}</span>
            <span class="pgbl__sku">{{ sku }}</span>
          </div>

          <h3 class="pgbl__title"><a href="{{ product.url }}" class="pgbl__title-link">{{ product.title }}</a></h3>

          {%- if first_option != blank and first_option != 'Default Title' -%}
            <p class="pgbl__size">{{ first_option }}</p>
          {%- endif -%}

          <!-- Foot -->
          <div class="pgbl__foot">

            <!-- Stock -->
            <div class="pgbl__stock-row">
              <div class="pgbl__stock">
                <span class="pgbl__stock-dot pgbl__stock-dot--{{ stock_mod }}" aria-hidden="true"></span>
                {{ stock_label }}
              </div>
            </div>

            <!-- Prices -->
            <div class="pgbl__prices">
              {%- if rrp_cents > 0 -%}
                <div class="pgbl__price-row">
                  <p class="pgbl__price-label">RRP</p>
                  <p class="pgbl__rrp-val{% unless is_wholesale %} pgbl__rrp-val--retail{% endunless %}">{{ rrp_cents | money }}</p>
                </div>
              {%- endif -%}
              {%- if is_wholesale -%}
                <div class="pgbl__price-row">
                  <p class="pgbl__price-label pgbl__price-label--wsp">Your Price (WSP)</p>
                  <p class="pgbl__wsp-val">{{ wsp_cents | money }}</p>
                </div>
                {%- if margin > 0 -%}
                  <div class="pgbl__margin">
                    <span class="pgbl__margin-badge">+{{ margin }}% Margin</span>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div><!-- /.pgbl__prices -->

            <!-- Add to cart, login prompt or OOS -->
            {%- if is_wholesale == false -%}
              {%- if customer -%}
                <a href="/pages/wholesale-application" class="pgbl__atc-btn pgbl__login-btn">Apply for B2B pricing</a>
              {%- else -%}
                <a href="/pages/partner-login" class="pgbl__atc-btn pgbl__login-btn">Log in for B2B price</a>
              {%- endif -%}
            {%- elsif product.has_only_default_variant == false and product.available -%}
              <a href="{{ product.url }}" class="pgbl__atc-btn pgbl__login-btn">{{ section.settings.options_label | default: 'Choose options' }}</a>
            {%- elsif v.available -%}
              <div class="pgbl__atc-wrap">
                <div class="pgbl__qty-row">
                  <button
                    type="button"
                    class="pgbl__qty-btn"
                    data-qty-dec
                    aria-label="Decrease quantity"
                  >
                    <svg style="width:1rem;height:1rem" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </button>
                  <input
                    type="number"
                    class="pgbl__qty-input"
                    value="{{ v.quantity_rule.min | default: 1 }}"
                    min="{{ v.quantity_rule.min | default: 1 }}"
                    step="{{ v.quantity_rule.increment | default: 1 }}"
                    {%- if v.quantity_rule.max != null %} max="{{ v.quantity_rule.max }}"{% endif %}
                    aria-label="Quantity"
                    data-qty-input
                  >
                  <button
                    type="button"
                    class="pgbl__qty-btn"
                    data-qty-inc
                    aria-label="Increase quantity"
                  >
                    <svg style="width:1rem;height:1rem" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </button>
                </div>

                <button
                  type="button"
                  class="pgbl__atc-btn"
                  data-atc-btn
                  data-variant-id="{{ v.id }}"
                >
                  <svg class="pgbl__atc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  <span data-atc-text>{{ atc_label }}</span>
                  <span class="visually-hidden">: {{ product.title | escape }}</span>
                </button>
              </div>
            {%- else -%}
              <button type="button" class="pgbl__oos-btn" disabled aria-disabled="true">
                {{ oos_label }}
              </button>
            {%- endif -%}

          </div><!-- /.pgbl__foot -->
        </div><!-- /.pgbl__body -->
      </div><!-- /.pgbl__card -->
    {%- else -%}
      <!-- Collection has no products at all -->
      <div class="pgbl__empty is-visible" aria-live="assertive">
        <div class="pgbl__empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </div>
        <h3 class="pgbl__empty-heading">{{ empty_heading }}</h3>
        <p class="pgbl__empty-text">This collection has no products yet.</p>
      </div>
    {%- endfor -%}

    <!-- JS-driven empty state (shown when filters hide all cards) -->
    {%- if collection.products.size > 0 -%}
    <div class="pgbl__empty" id="PgblEmpty-{{ section.id }}" aria-live="assertive">
      <div class="pgbl__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <h3 class="pgbl__empty-heading">{{ empty_heading }}</h3>
      <p class="pgbl__empty-text" id="PgblEmptyMsg-{{ section.id }}">Try adjusting your filters.</p>
      <button class="pgbl__empty-btn" id="PgblClearBtn-{{ section.id }}" type="button">
        {{ clear_label }}
      </button>
    </div>
    {%- endif -%}

  </div><!-- /.pgbl__grid -->

  {%- if paginate.pages > 1 -%}
    <nav class="pgbl__pagination" aria-label="Pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pgbl__page-link">&larr; Previous</a>{%- endif -%}
      <span class="pgbl__page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pgbl__page-link">Next &rarr;</a>{%- endif -%}
    </nav>
  {%- endif -%}
  {%- endpaginate -%}
</div><!-- /.pgbl -->

<script>
(function () {
  if (window.lpProductGridLoggedInReady) return;
  window.lpProductGridLoggedInReady = true;

  var sid        = '{{ section.id }}';
  var countEl    = document.getElementById('PgblCount-' + sid);
  var filterPill = document.getElementById('PgblActiveFilter-' + sid);
  var emptyEl    = document.getElementById('PgblEmpty-' + sid);
  var emptyMsg   = document.getElementById('PgblEmptyMsg-' + sid);
  var clearBtn   = document.getElementById('PgblClearBtn-' + sid);
  var cards      = Array.from(document.querySelectorAll('#ProductGridLoggedIn-' + sid + ' .pgbl__card'));

  /* ── Quantity controls ──────────────────────────── */
  cards.forEach(function (card) {
    var decBtn   = card.querySelector('[data-qty-dec]');
    var incBtn   = card.querySelector('[data-qty-inc]');
    var qtyInput = card.querySelector('[data-qty-input]');

    if (!decBtn || !incBtn || !qtyInput) return;

    /* Quantity rules (B2B): min / increment / max come from the input attrs */
    var qMin  = parseInt(qtyInput.min)  || 1;
    var qStep = parseInt(qtyInput.step) || 1;
    var qMax  = parseInt(qtyInput.max)  || Infinity;

    function clampQty(v) {
      v = parseInt(v) || qMin;
      if (v < qMin) v = qMin;
      v = qMin + Math.round((v - qMin) / qStep) * qStep;
      if (v > qMax) v = qMin + Math.floor((qMax - qMin) / qStep) * qStep;
      return v;
    }

    decBtn.addEventListener('click', function () {
      qtyInput.value = clampQty((parseInt(qtyInput.value) || qMin) - qStep);
    });

    incBtn.addEventListener('click', function () {
      qtyInput.value = clampQty((parseInt(qtyInput.value) || qMin) + qStep);
    });

    qtyInput.addEventListener('change', function () {
      qtyInput.value = clampQty(qtyInput.value);
    });
  });

  /* ── Add to cart (AJAX) ─────────────────────────── */
  cards.forEach(function (card) {
    var atcBtn   = card.querySelector('[data-atc-btn]');
    var qtyInput = card.querySelector('[data-qty-input]');
    if (!atcBtn) return;

    var label    = atcBtn.querySelector('[data-atc-text]');
    var original = label ? label.textContent : '';

    function setLabel(text) { if (label) label.textContent = text; }
    function reset(ms) {
      setTimeout(function () {
        atcBtn.classList.remove('is-success', 'is-error');
        atcBtn.disabled = false;
        setLabel(original);
      }, ms);
    }

    atcBtn.addEventListener('click', function () {
      var variantId = parseInt(atcBtn.getAttribute('data-variant-id'));
      var qty       = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

      atcBtn.disabled = true;
      setLabel('Adding…');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: qty }] })
      })
      .then(function (res) {
        return res.json().then(function (data) {
          /* 422: sold out, quantity rule, max reached … — Shopify explains why */
          if (!res.ok || (data.status && data.status >= 400)) {
            throw new Error(data.description || data.message || 'Could not add to cart');
          }
          return data;
        });
      })
      .then(function () {
        atcBtn.classList.add('is-success');
        setLabel('✓ Added');
        return fetch('/cart.js').then(function (r) { return r.json(); });
      })
      .then(function (cart) {
        if (window.lpUpdateCartBubble) window.lpUpdateCartBubble(cart.item_count);
        document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = cart.item_count; });
        window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        reset(2000);
      })
      .catch(function (err) {
        atcBtn.classList.add('is-error');
        setLabel(err.message);
        reset(4000);
      });
    });
  });

  /* ── Client-side filtering ──────────────────────── */
  function getFilters() {
    var searchInput = document.querySelector('[data-catalog-search]');
    var catChecked  = document.querySelector('[data-catalog-category]:checked');
    var stockCheck  = document.querySelector('[data-catalog-instock]');
    return {
      search:   searchInput ? searchInput.value.trim().toLowerCase() : '',
      category: catChecked  ? catChecked.value : 'all',
      inStock:  stockCheck  ? stockCheck.checked : false
    };
  }

  function applyFilters() {
    var f = getFilters();
    var visible = 0;

    cards.forEach(function (card) {
      var title     = card.getAttribute('data-title')    || '';
      var sku       = card.getAttribute('data-sku')      || '';
      var category  = card.getAttribute('data-category') || '';
      var available = card.getAttribute('data-available');

      var matchSearch   = !f.search   || title.includes(f.search) || sku.includes(f.search);
      var matchCategory = f.category === 'all' || category.toLowerCase() === f.category.toLowerCase();
      var matchStock    = !f.inStock  || available === 'true';

      var show = matchSearch && matchCategory && matchStock;
      card.hidden = !show;
      if (show) visible++;
    });

    if (countEl) {
      countEl.textContent = 'Showing ' + visible + ' item' + (visible !== 1 ? 's' : '');
    }

    if (filterPill) {
      if (f.category !== 'all') {
        filterPill.textContent = f.category + ' ×';
        filterPill.style.display = 'inline-flex';
        filterPill.onclick = function () {
          var allRadio = document.querySelector('[data-catalog-category="all"]');
          if (allRadio) { allRadio.checked = true; allRadio.dispatchEvent(new Event('change')); }
        };
      } else {
        filterPill.style.display = 'none';
      }
    }

    if (emptyEl) {
      if (visible === 0) {
        emptyEl.classList.add('is-visible');
        if (emptyMsg && f.search) {
          emptyMsg.textContent = 'No products matched “' + f.search + '”.';
        } else if (emptyMsg) {
          emptyMsg.textContent = 'Try adjusting your filters.';
        }
      } else {
        emptyEl.classList.remove('is-visible');
      }
    }
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      var searchInput = document.querySelector('[data-catalog-search]');
      var allRadio    = document.querySelector('[data-catalog-category="all"]');
      var stockCheck  = document.querySelector('[data-catalog-instock]');
      if (searchInput) searchInput.value = '';
      if (allRadio)   { allRadio.checked = true; allRadio.dispatchEvent(new Event('change')); }
      if (stockCheck) stockCheck.checked = false;
      applyFilters();
    });
  }

  window.addEventListener('catalog:filter', applyFilters);
  applyFilters();
})();
</script>

{% schema %}
{
  "name": "Product Grid B2B – Logged In",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Renders products from the current collection with wholesale pricing. WSP is the price Shopify charges the customer (for B2B buyers: their catalog price). RRP comes from the product metafield custom.rrp (money); without it guests see the regular price and B2B buyers see no RRP/margin."
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart button label",
      "default": "Add to Order"
    },
    {
      "type": "text",
      "id": "oos_label",
      "label": "Out of stock label",
      "default": "Out of Stock"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "No products found"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear filters button label",
      "default": "Clear Filters"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Button for products with several variants",
      "default": "Choose options"
    }
  ],
  "presets": [
    {
      "name": "Product Grid B2B (Logged In)"
    }
  ]
}
{% endschema %}
