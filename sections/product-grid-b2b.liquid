<style>
  .pgb {
    padding: 2rem 1.5rem;
    background-color: #f5f5f4;
  }

  html.a11y-high-contrast .pgb {
    background-color: #ffffff !important;
  }

  @media screen and (min-width: 1024px) {
    .pgb { padding: 3rem 0; }
  }

  .pgb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media screen and (min-width: 600px) {
    .pgb__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (min-width: 1024px) {
    .pgb__grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Card ─────────────────────────────────────────── */
  .pgb__card {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.25rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease;
  }

  .pgb__card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  html.a11y-high-contrast .pgb__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── Image ────────────────────────────────────────── */
  .pgb__img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: #f5f5f4;
    overflow: hidden;
  }

  .pgb__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pgb__card:hover .pgb__img { transform: scale(1.04); }

  html.a11y-high-contrast .pgb__card:hover .pgb__img { transform: none; }

  .pgb__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d6d3d1;
  }

  .pgb__img-placeholder svg { width: 3rem; height: 3rem; }

  .pgb__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: #f59e0b;
    color: #1c1917;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
  }

  html.a11y-high-contrast .pgb__badge {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 1px solid #ffffff !important;
  }

  /* ── Body ─────────────────────────────────────────── */
  .pgb__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .pgb__sku {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a8a29e;
    margin: 0 0 0.25rem;
  }

  html.a11y-high-contrast .pgb__sku { color: #000000 !important; }

  .pgb__name {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1rem;
    color: #1c1917;
    margin: 0 0 0.25rem;
    line-height: 1.35;
  }

  html.a11y-high-contrast .pgb__name { color: #000000 !important; }

  .pgb__variant {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    color: #78716c;
    margin: 0 0 1rem;
  }

  html.a11y-high-contrast .pgb__variant { color: #000000 !important; }

  /* ── Prices ───────────────────────────────────────── */
  .pgb__prices {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #f5f5f4;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  html.a11y-high-contrast .pgb__prices { border-top-color: #000000 !important; }

  .pgb__wsp-label {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #78716c;
    margin: 0 0 0.125rem;
  }

  html.a11y-high-contrast .pgb__wsp-label { color: #000000 !important; }

  .pgb__wsp {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: #1c1917;
    margin: 0;
  }

  html.a11y-high-contrast .pgb__wsp { color: #000000 !important; }

  .pgb__margin {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    color: #16a34a;
    background-color: #f0fdf4;
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    display: inline-block;
    margin-top: 0.25rem;
  }

  html.a11y-high-contrast .pgb__margin {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #000000 !important;
  }

  .pgb__rrp-wrap { text-align: right; }

  .pgb__rrp-label {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a8a29e;
    margin: 0 0 0.125rem;
  }

  html.a11y-high-contrast .pgb__rrp-label { color: #000000 !important; }

  .pgb__rrp {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #a8a29e;
    text-decoration: line-through;
    margin: 0;
  }

  html.a11y-high-contrast .pgb__rrp {
    color: #000000 !important;
    text-decoration-thickness: 2px;
  }

  /* Login prompt for non-wholesale visitors */
  .pgb__login-note {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #b45309;
    margin-top: auto;
    margin-bottom: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f5f5f4;
  }

  .pgb__login-note a { color: inherit; text-decoration: underline; }

  html.a11y-high-contrast .pgb__login-note { color: #000000 !important; border-top-color: #000000 !important; }

  /* ── Add to Order button ──────────────────────────── */
  .pgb__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .pgb__atc:hover:not(:disabled) { background-color: #ea580c; }

  .pgb__atc:disabled {
    background-color: #d6d3d1;
    color: #a8a29e;
    cursor: not-allowed;
  }

  .pgb__atc.is-added { background-color: #16a34a; }

  html.a11y-high-contrast .pgb__atc {
    background-color: #000000 !important;
    border: 2px solid #000000 !important;
    color: #ffffff !important;
  }

  html.a11y-high-contrast .pgb__atc:disabled {
    background-color: #999999 !important;
    border-color: #999999 !important;
  }

  .pgb__atc svg { width: 1rem; height: 1rem; flex-shrink: 0; }

  /* ── Empty ────────────────────────────────────────── */
  .pgb__empty {
    text-align: center;
    padding: 4rem 2rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: #78716c;
  }

  html.a11y-high-contrast .pgb__empty { color: #000000 !important; }
</style>

<div class="pgb" id="ProductGridB2B-{{ section.id }}">

  {%- if collection.products_count > 0 -%}
    <div class="pgb__grid">

      {%- for product in collection.products -%}
        {%- liquid
          assign variant   = product.variants.first
          assign wsp_meta  = product.metafields.custom.wholesale_price.value
          assign wsp_cents = wsp_meta | times: 100 | round
          if wsp_meta == blank or wsp_cents == 0
            assign wsp_cents = variant.price
          endif
          assign rrp_cents  = variant.compare_at_price | default: variant.price
          assign margin_pct = 0
          if wsp_cents > 0
            assign margin_pct = rrp_cents | minus: wsp_cents | times: 100 | divided_by: wsp_cents
          endif
          assign badge        = product.metafields.custom.badge.value
          assign is_wholesale = false
          if customer and customer.tags contains 'wholesale'
            assign is_wholesale = true
          endif
        -%}

        <div
          class="pgb__card"
          data-product-id="{{ product.id }}"
          data-variant-id="{{ variant.id }}"
        >

          <!-- Image -->
          <div class="pgb__img-wrap">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 600 | image_tag:
                class: 'pgb__img',
                alt: product.title | escape,
                loading: 'lazy',
                width: 300,
                height: 300
              }}
            {%- else -%}
              <div class="pgb__img-placeholder" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            {%- endif -%}
            {%- if badge != blank -%}
              <span class="pgb__badge">{{ badge }}</span>
            {%- endif -%}
          </div>

          <!-- Body -->
          <div class="pgb__body">
            {%- if variant.sku != blank -%}
              <p class="pgb__sku">{{ variant.sku }}</p>
            {%- endif -%}
            <p class="pgb__name">{{ product.title }}</p>
            {%- unless variant.title == 'Default Title' -%}
              <p class="pgb__variant">{{ variant.title }}</p>
            {%- endunless -%}

            {%- if is_wholesale -%}

              <div class="pgb__prices">
                <div>
                  <p class="pgb__wsp-label">WSP</p>
                  <p class="pgb__wsp">{{ wsp_cents | money }}</p>
                  {%- if margin_pct > 0 -%}
                    <span class="pgb__margin">+{{ margin_pct }}% margin</span>
                  {%- endif -%}
                </div>
                {%- if rrp_cents > wsp_cents -%}
                  <div class="pgb__rrp-wrap">
                    <p class="pgb__rrp-label">RRP</p>
                    <p class="pgb__rrp">{{ rrp_cents | money }}</p>
                  </div>
                {%- endif -%}
              </div>

              <button
                type="button"
                class="pgb__atc"
                data-pgb-atc
                data-variant="{{ variant.id }}"
                aria-label="Add {{ product.title | escape }} to order"
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                </svg>
                Add to Order
              </button>

            {%- else -%}

              <p class="pgb__login-note">
                <a href="{{ routes.account_login_url }}">Log in for B2B price</a>
              </p>

              <button type="button" class="pgb__atc" disabled aria-disabled="true">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                Add to Order
              </button>

            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}

    </div>
  {%- else -%}
    <p class="pgb__empty">No products found in this collection.</p>
  {%- endif -%}

</div>

<script>
(function () {
  if (window.lpProductGridB2BReady) return;
  window.lpProductGridB2BReady = true;

  var ATC_SVG = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>';

  document.querySelectorAll('[data-pgb-atc]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      var variantId = parseInt(btn.getAttribute('data-variant'));
      if (!variantId) return;

      btn.disabled = true;
      btn.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        body: JSON.stringify({id: variantId, quantity: 1})
      })
      .then(function (r) { return r.json(); })
      .then(function () {
        btn.classList.add('is-added');
        btn.textContent = 'Added!';
        return fetch('/cart.js').then(function (r) { return r.json(); });
      })
      .then(function (cart) {
        window.dispatchEvent(new CustomEvent('cart:updated', {detail: cart}));
        setTimeout(function () {
          btn.disabled = false;
          btn.classList.remove('is-added');
          btn.innerHTML = ATC_SVG + 'Add to Order';
        }, 1800);
      })
      .catch(function () {
        btn.disabled = false;
        btn.innerHTML = ATC_SVG + 'Add to Order';
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Grid B2B",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Product Grid B2B"
    }
  ]
}
{% endschema %}
