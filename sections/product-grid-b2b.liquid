{%- liquid
  assign heading         = section.settings.heading
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign show_rrp        = section.settings.show_rrp
  if section.settings.show_rrp == nil
    assign show_rrp = true
  endif
  assign empty_text      = section.settings.empty_text | default: 'No products found in this collection.'
-%}

<style>
  .pgb {
    padding: 2rem 1.5rem;
    background-color: #f5f5f4;
  }

  html.a11y-high-contrast .pgb {
    background-color: #ffffff !important;
  }

  @media screen and (min-width: 1024px) {
    .pgb { padding: 3rem 0; }
  }

  .pgb__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: rgb(var(--color-foreground, 28 25 23));
    margin: 0 0 1.5rem;
    line-height: 1.2;
  }

  html.a11y-high-contrast .pgb__heading { color: #000000 !important; }

  .pgb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media screen and (min-width: 600px) {
    .pgb__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (min-width: 1024px) {
    .pgb__grid--3 { grid-template-columns: repeat(3, 1fr); }
    .pgb__grid--4 { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Card ─────────────────────────────────────────── */
  .pgb__card {
    position: relative;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 1.25rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease;
  }

  .pgb__card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  html.a11y-high-contrast .pgb__card {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
  }

  /* ── Image ────────────────────────────────────────── */
  .pgb__img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: #f5f5f4;
    overflow: hidden;
  }

  .pgb__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pgb__card:hover .pgb__img { transform: scale(1.04); }

  html.a11y-high-contrast .pgb__card:hover .pgb__img { transform: none; }

  .pgb__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d6d3d1;
  }

  .pgb__img-placeholder svg { width: 3rem; height: 3rem; }

  .pgb__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: #f59e0b;
    color: #1c1917;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
  }

  html.a11y-high-contrast .pgb__badge {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 1px solid #ffffff !important;
  }

  /* Out-of-stock chip on image */
  .pgb__oos {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: #1c1917;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
  }

  html.a11y-high-contrast .pgb__oos {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 1px solid #ffffff !important;
  }

  /* ── Body ─────────────────────────────────────────── */
  .pgb__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .pgb__sku {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a8a29e;
    margin: 0 0 0.25rem;
  }

  html.a11y-high-contrast .pgb__sku { color: #000000 !important; }

  .pgb__name {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1rem;
    color: #1c1917;
    margin: 0 0 0.25rem;
    line-height: 1.35;
  }

  html.a11y-high-contrast .pgb__name { color: #000000 !important; }

  .pgb__variant {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    color: #78716c;
    margin: 0 0 1rem;
  }

  html.a11y-high-contrast .pgb__variant { color: #000000 !important; }

  /* ── Prices ───────────────────────────────────────── */
  .pgb__prices {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #f5f5f4;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  html.a11y-high-contrast .pgb__prices { border-top-color: #000000 !important; }

  .pgb__wsp-label {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #78716c;
    margin: 0 0 0.125rem;
  }

  html.a11y-high-contrast .pgb__wsp-label { color: #000000 !important; }

  .pgb__wsp {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: #1c1917;
    margin: 0;
  }

  html.a11y-high-contrast .pgb__wsp { color: #000000 !important; }

  .pgb__margin {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    color: #16a34a;
    background-color: #f0fdf4;
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    display: inline-block;
    margin-top: 0.25rem;
  }

  html.a11y-high-contrast .pgb__margin {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #000000 !important;
  }

  .pgb__rrp-wrap { text-align: right; }

  .pgb__rrp-label {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a8a29e;
    margin: 0 0 0.125rem;
  }

  html.a11y-high-contrast .pgb__rrp-label { color: #000000 !important; }

  .pgb__rrp {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    color: #a8a29e;
    text-decoration: line-through;
    margin: 0;
  }

  html.a11y-high-contrast .pgb__rrp {
    color: #000000 !important;
    text-decoration-thickness: 2px;
  }

  /* Login prompt for non-wholesale visitors */
  .pgb__login-note {
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #b45309;
    margin-top: auto;
    margin-bottom: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f5f5f4;
  }

  .pgb__login-note a { color: inherit; text-decoration: underline; }

  html.a11y-high-contrast .pgb__login-note { color: #000000 !important; border-top-color: #000000 !important; }

  /* ── Actions: qty + ATC ───────────────────────────── */
  .pgb__actions {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }

  .pgb__qty-row {
    display: inline-flex;
    align-items: center;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    padding: 0.125rem;
    flex-shrink: 0;
  }

  html.a11y-high-contrast .pgb__qty-row {
    border: 2px solid #000000 !important;
    background-color: #ffffff !important;
  }

  .pgb__qty-btn {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #57534e;
    transition: background-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .pgb__qty-btn:hover:not(:disabled) { background-color: #e7e5e4; color: #1c1917; }
  .pgb__qty-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  html.a11y-high-contrast .pgb__qty-btn { color: #000000 !important; }

  .pgb__qty-btn svg { width: 0.875rem; height: 0.875rem; }

  .pgb__qty-input {
    width: 2.25rem;
    height: 2rem;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1c1917;
    background: none;
    border: none;
    outline: none;
    -moz-appearance: textfield;
  }

  .pgb__qty-input::-webkit-inner-spin-button,
  .pgb__qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .pgb__qty-input:disabled { opacity: 0.4; }

  html.a11y-high-contrast .pgb__qty-input { color: #000000 !important; }

  /* ── Add to Order button ──────────────────────────── */
  .pgb__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex: 1;
    padding: 0.625rem 1rem;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    background-color: #1c1917;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
    min-height: 2.25rem;
  }

  .pgb__atc:hover:not(:disabled) { background-color: #ea580c; }

  .pgb__atc:disabled {
    background-color: #d6d3d1;
    color: #78716c;
    cursor: not-allowed;
  }

  .pgb__atc.is-added { background-color: #16a34a; }

  html.a11y-high-contrast .pgb__atc {
    background-color: #000000 !important;
    border: 2px solid #000000 !important;
    color: #ffffff !important;
  }

  html.a11y-high-contrast .pgb__atc:disabled {
    background-color: #999999 !important;
    border-color: #999999 !important;
  }

  .pgb__atc svg { width: 1rem; height: 1rem; flex-shrink: 0; }

  /* ── Mini "Added" toast (per card) ────────────────── */
  .pgb__notify {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background-color: #16a34a;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.35);
    opacity: 0;
    transform: translateY(-0.5rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
    z-index: 5;
  }

  .pgb__notify.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .pgb__notify--error {
    background-color: #dc2626;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
  }

  html.a11y-high-contrast .pgb__notify {
    background-color: #000000 !important;
    color: #ffffff !important;
    border: 2px solid #ffffff !important;
    box-shadow: none !important;
  }

  html.a11y-high-contrast .pgb__notify--error {
    background-color: #000000 !important;
    border: 2px solid #ffffff !important;
  }

  .pgb__notify svg { width: 0.875rem; height: 0.875rem; flex-shrink: 0; }

  /* ── Empty ────────────────────────────────────────── */
  .pgb__empty {
    text-align: center;
    padding: 4rem 2rem;
    background-color: #ffffff;
    border: 1px dashed #d6d3d1;
    border-radius: 1.25rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: #78716c;
  }

  html.a11y-high-contrast .pgb__empty {
    background-color: #ffffff !important;
    border: 4px dashed #000000 !important;
    color: #000000 !important;
  }

  .pgb__empty-icon {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    color: #d6d3d1;
  }

  html.a11y-high-contrast .pgb__empty-icon { color: #000000 !important; }

  .pgb__empty-icon svg { width: 100%; height: 100%; }

  .pgb__empty p { margin: 0; }
</style>

<div class="pgb" id="ProductGridB2B-{{ section.id }}">

  {%- if heading != blank -%}
    <h2 class="pgb__heading">{{ heading }}</h2>
  {%- endif -%}

  {%- if collection.products_count > 0 -%}
    <div class="pgb__grid pgb__grid--{{ columns_desktop }}">

      {%- for product in collection.products -%}
        {%- liquid
          assign variant   = product.variants.first
          assign wsp_meta  = product.metafields.custom.wholesale_price.value
          assign wsp_cents = wsp_meta | times: 100 | round
          if wsp_meta == blank or wsp_cents == 0
            assign wsp_cents = variant.price
          endif
          assign rrp_cents  = variant.compare_at_price | default: variant.price
          assign margin_pct = 0
          if wsp_cents > 0
            assign margin_pct = rrp_cents | minus: wsp_cents | times: 100 | divided_by: wsp_cents
          endif
          assign badge        = product.metafields.custom.badge.value
          assign in_stock     = variant.available
          assign is_wholesale = false
          if customer and customer.tags contains 'wholesale'
            assign is_wholesale = true
          endif
        -%}

        <div
          class="pgb__card"
          data-product-id="{{ product.id }}"
          data-variant-id="{{ variant.id }}"
        >

          <!-- Toast -->
          <div class="pgb__notify" data-pgb-notify aria-live="polite" role="status">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span data-pgb-notify-text>Added!</span>
          </div>

          <!-- Image -->
          <div class="pgb__img-wrap">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 600 | image_tag:
                class: 'pgb__img',
                alt: product.title | escape,
                loading: 'lazy',
                width: 300,
                height: 300
              }}
            {%- else -%}
              <div class="pgb__img-placeholder" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            {%- endif -%}
            {%- if badge != blank -%}
              <span class="pgb__badge">{{ badge }}</span>
            {%- endif -%}
            {%- unless in_stock -%}
              <span class="pgb__oos">Out of Stock</span>
            {%- endunless -%}
          </div>

          <!-- Body -->
          <div class="pgb__body">
            {%- if variant.sku != blank -%}
              <p class="pgb__sku">{{ variant.sku }}</p>
            {%- endif -%}
            <p class="pgb__name">{{ product.title }}</p>
            {%- unless variant.title == 'Default Title' -%}
              <p class="pgb__variant">{{ variant.title }}</p>
            {%- endunless -%}

            {%- if is_wholesale -%}

              <div class="pgb__prices">
                <div>
                  <p class="pgb__wsp-label">WSP</p>
                  <p class="pgb__wsp">{{ wsp_cents | money }}</p>
                  {%- if margin_pct > 0 -%}
                    <span class="pgb__margin">+{{ margin_pct }}% margin</span>
                  {%- endif -%}
                </div>
                {%- if show_rrp and rrp_cents > wsp_cents -%}
                  <div class="pgb__rrp-wrap">
                    <p class="pgb__rrp-label">RRP</p>
                    <p class="pgb__rrp">{{ rrp_cents | money }}</p>
                  </div>
                {%- endif -%}
              </div>

              <div class="pgb__actions">
                <div class="pgb__qty-row">
                  <button
                    type="button"
                    class="pgb__qty-btn"
                    data-pgb-dec
                    aria-label="Decrease quantity"
                    {%- unless in_stock %} disabled{% endunless -%}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                  <input
                    type="number"
                    class="pgb__qty-input"
                    data-pgb-qty
                    value="1"
                    min="1"
                    aria-label="Quantity for {{ product.title | escape }}"
                    {%- unless in_stock %} disabled{% endunless -%}
                  >
                  <button
                    type="button"
                    class="pgb__qty-btn"
                    data-pgb-inc
                    aria-label="Increase quantity"
                    {%- unless in_stock %} disabled{% endunless -%}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                </div>

                {%- if in_stock -%}
                  <button
                    type="button"
                    class="pgb__atc"
                    data-pgb-atc
                    data-variant="{{ variant.id }}"
                    aria-label="Add {{ product.title | escape }} to order"
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                    <span data-pgb-atc-label>Add</span>
                  </button>
                {%- else -%}
                  <button type="button" class="pgb__atc" disabled aria-disabled="true">
                    <span>Out of Stock</span>
                  </button>
                {%- endif -%}
              </div>

            {%- else -%}

              <p class="pgb__login-note">
                <a href="{{ routes.account_login_url }}">Log in for B2B price</a>
              </p>

              <button type="button" class="pgb__atc" disabled aria-disabled="true">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                Add to Order
              </button>

            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}

    </div>
  {%- else -%}
    <div class="pgb__empty" role="status">
      <div class="pgb__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7l3-4h12l3 4"/>
          <path d="M3 7v13a1 1 0 001 1h16a1 1 0 001-1V7"/>
          <path d="M9 11a3 3 0 006 0"/>
        </svg>
      </div>
      <p>{{ empty_text }}</p>
    </div>
  {%- endif -%}

</div>

<script>
(function () {
  if (window.lpProductGridB2BReady) return;
  window.lpProductGridB2BReady = true;

  /* ── Update header cart icon counters ─────────────── */
  function updateCartCount(count) {
    var selectors = [
      '[data-cart-count]',
      '.cart-count-bubble span:first-child',
      '.cart-count',
      '.js-cart-count',
      '#CartCount',
      '#cart-icon-bubble .cart-count-bubble span:first-child'
    ];
    selectors.forEach(function (sel) {
      document.querySelectorAll(sel).forEach(function (el) {
        el.textContent = count;
      });
    });
    /* Show the bubble if it was hidden (Dawn hides it at 0) */
    document.querySelectorAll('.cart-count-bubble').forEach(function (el) {
      if (count > 0) el.removeAttribute('hidden');
    });
  }

  /* ── Per-card wiring ──────────────────────────────── */
  document.querySelectorAll('.pgb__card').forEach(function (card) {
    var qtyInput = card.querySelector('[data-pgb-qty]');
    var decBtn   = card.querySelector('[data-pgb-dec]');
    var incBtn   = card.querySelector('[data-pgb-inc]');
    var atcBtn   = card.querySelector('[data-pgb-atc]');
    var notify   = card.querySelector('[data-pgb-notify]');
    var notifyTx = card.querySelector('[data-pgb-notify-text]');
    var atcLabel = card.querySelector('[data-pgb-atc-label]');

    function getQty() {
      var n = parseInt(qtyInput && qtyInput.value, 10);
      return (isNaN(n) || n < 1) ? 1 : n;
    }
    function setQty(n) {
      if (!qtyInput) return;
      if (n < 1) n = 1;
      qtyInput.value = n;
    }

    if (decBtn && qtyInput) decBtn.addEventListener('click', function () { setQty(getQty() - 1); });
    if (incBtn && qtyInput) incBtn.addEventListener('click', function () { setQty(getQty() + 1); });
    if (qtyInput) qtyInput.addEventListener('change', function () { setQty(getQty()); });

    function showNotify(msg, isError) {
      if (!notify) return;
      if (notifyTx) notifyTx.textContent = msg;
      notify.classList.toggle('pgb__notify--error', !!isError);
      notify.classList.add('is-visible');
      clearTimeout(notify._t);
      notify._t = setTimeout(function () {
        notify.classList.remove('is-visible');
        notify.classList.remove('pgb__notify--error');
      }, 2000);
    }

    function markOutOfStock() {
      if (!atcBtn) return;
      atcBtn.disabled = true;
      atcBtn.setAttribute('aria-disabled', 'true');
      if (atcLabel) atcLabel.textContent = 'Out of Stock';
      else atcBtn.textContent = 'Out of Stock';
      [decBtn, incBtn, qtyInput].forEach(function (el) { if (el) el.disabled = true; });
    }

    if (atcBtn && atcBtn.hasAttribute('data-pgb-atc')) {
      atcBtn.addEventListener('click', function () {
        if (atcBtn.disabled) return;
        var variantId = parseInt(atcBtn.getAttribute('data-variant'), 10);
        var qty       = getQty();
        if (!variantId) return;

        atcBtn.disabled = true;
        var originalLabel = atcLabel ? atcLabel.textContent : 'Add';
        if (atcLabel) atcLabel.textContent = 'Adding…';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
          body: JSON.stringify({id: variantId, quantity: qty})
        })
        .then(function (r) {
          if (!r.ok) {
            return r.json().then(function (err) { throw err; });
          }
          return r.json();
        })
        .then(function () {
          atcBtn.classList.add('is-added');
          if (atcLabel) atcLabel.textContent = 'Added!';
          showNotify('Added ' + qty + ' to cart');
          /* Fetch fresh cart and broadcast */
          return fetch('/cart.js').then(function (r) { return r.json(); });
        })
        .then(function (cart) {
          if (!cart) return;
          updateCartCount(cart.item_count || 0);
          /* Broadcast to MOQ bar (custom) and Dawn header (native) */
          window.dispatchEvent(new CustomEvent('cart:updated', {detail: cart}));
          document.dispatchEvent(new CustomEvent('cart:changed', {detail: {cart: cart}}));
          /* Reset after 2s */
          setTimeout(function () {
            atcBtn.disabled = false;
            atcBtn.classList.remove('is-added');
            if (atcLabel) atcLabel.textContent = originalLabel;
            setQty(1);
          }, 2000);
        })
        .catch(function (err) {
          var msg = (err && (err.description || err.message)) || '';
          /* Shopify returns 422 with "sold out" or "stock" wording when OOS */
          if (/stock|sold out|inventory/i.test(msg)) {
            showNotify('Out of Stock', true);
            markOutOfStock();
          } else {
            atcBtn.disabled = false;
            if (atcLabel) atcLabel.textContent = originalLabel;
            showNotify(msg || 'Error adding', true);
          }
        });
      });
    }
  });
})();
</script>

