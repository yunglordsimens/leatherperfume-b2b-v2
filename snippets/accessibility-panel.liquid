<style>
  .a11y-panel {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.875rem;
  }

  .a11y-panel__details {
    position: relative;
  }

  .a11y-panel__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background-color: #1c1917;
    color: #f5f5f4;
    border-radius: 2rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    user-select: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: background-color 0.2s;
    border: 1px solid #44403c;
  }

  .a11y-panel__toggle:hover {
    background-color: #292524;
  }

  .a11y-panel__toggle::-webkit-details-marker,
  .a11y-panel__toggle::marker {
    display: none;
  }

  .a11y-panel__toggle-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .a11y-panel__body {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    background-color: #1c1917;
    border: 1px solid #44403c;
    border-radius: 0.75rem;
    padding: 1rem;
    min-width: 14rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .a11y-panel__section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #78716c;
    margin: 0 0 0.5rem;
  }

  .a11y-panel__lang-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .a11y-panel__lang-form {
    margin: 0;
    padding: 0;
  }

  .a11y-panel__lang-btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.4375rem 0.625rem;
    background: transparent;
    color: #d6d3d1;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-family: var(--font-body-family, sans-serif);
    font-weight: 400;
    transition: background-color 0.15s, color 0.15s;
  }

  .a11y-panel__lang-btn:hover {
    background-color: #292524;
    color: #f5f5f4;
  }

  .a11y-panel__lang-btn--active {
    color: #f59e0b;
    font-weight: 600;
    cursor: default;
  }

  .a11y-panel__lang-btn--active:hover {
    background-color: transparent;
    color: #f59e0b;
  }

  .a11y-panel__divider {
    border: none;
    border-top: 1px solid #292524;
    margin: 0.75rem 0;
  }

  .a11y-panel__skip-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.625rem;
    color: #d6d3d1;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s, color 0.15s;
  }

  .a11y-panel__skip-link:hover {
    background-color: #292524;
    color: #f5f5f4;
  }

  .a11y-panel__skip-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
</style>

<div class="a11y-panel">
  <details class="a11y-panel__details">
    <summary class="a11y-panel__toggle" aria-label="Accessibility options">
      <svg class="a11y-panel__toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="10"/>
        <circle cx="12" cy="8" r="1" fill="currentColor" stroke="none"/>
        <line x1="12" y1="11" x2="12" y2="16"/>
        <line x1="10" y1="13" x2="14" y2="13"/>
      </svg>
      <span>Accessibility</span>
    </summary>

    <div class="a11y-panel__body" role="dialog" aria-label="Accessibility options">

      {%- if localization.available_languages.size > 1 -%}
        <p class="a11y-panel__section-label">Language</p>
        <ul class="a11y-panel__lang-list">
          {%- for language in localization.available_languages -%}
            <li>
              {%- if language.iso_code == localization.language.iso_code -%}
                <span class="a11y-panel__lang-btn a11y-panel__lang-btn--active" aria-current="true">
                  {{- language.endonym_name | capitalize -}}
                </span>
              {%- else -%}
                {%- form 'localization', class: 'a11y-panel__lang-form' -%}
                  <input type="hidden" name="_method" value="PUT">
                  <input type="hidden" name="return_to" value="{{ request.path }}">
                  <input type="hidden" name="locale_code" value="{{ language.iso_code }}">
                  <button type="submit" class="a11y-panel__lang-btn" lang="{{ language.iso_code }}">
                    {{- language.endonym_name | capitalize -}}
                  </button>
                {%- endform -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        <hr class="a11y-panel__divider">
      {%- endif -%}

      <a href="#MainContent" class="a11y-panel__skip-link">
        <svg class="a11y-panel__skip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <polyline points="13 17 18 12 13 7"/>
          <polyline points="6 17 11 12 6 7"/>
        </svg>
        Skip to content
      </a>

    </div>
  </details>
</div>
