<style>
  /* ================================================
     Accessibility Panel — styles
     ================================================ */

  /* ── Trigger button ──────────────────────────── */
  .a11y-trigger {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 198;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    background-color: #1c1917;
    color: #f5f5f4;
    border: 1px solid #44403c;
    border-radius: 2rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--font-body-family, sans-serif);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: background-color 0.2s ease;
    line-height: 1;
  }

  .a11y-trigger:hover,
  .a11y-trigger:focus-visible {
    background-color: #292524;
    outline: 2px solid #f59e0b;
    outline-offset: 2px;
  }

  .a11y-trigger__icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  /* ── Backdrop ──────────────────────────────────── */
  .a11y-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .a11y-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Slide-in panel ────────────────────────────── */
  .a11y-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20rem;
    background-color: #1c1917;
    color: #ffffff;
    z-index: 200;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .a11y-panel {
      width: 24rem;
    }
  }

  .a11y-panel.is-open {
    transform: translateX(0);
  }

  /* ── Panel header ────────────────────────────── */
  .a11y-panel__header {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #292524;
    flex-shrink: 0;
  }

  .a11y-panel__title {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: var(--font-heading-family, sans-serif);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    color: #ffffff;
  }

  .a11y-panel__title-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: #f59e0b;
    flex-shrink: 0;
  }

  .a11y-panel__close {
    padding: 0.5rem;
    background: transparent;
    border: none;
    color: #d6d3d1;
    cursor: pointer;
    border-radius: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }

  .a11y-panel__close:hover,
  .a11y-panel__close:focus-visible {
    background-color: #292524;
    color: #ffffff;
    outline: 2px solid #f59e0b;
    outline-offset: 1px;
  }

  .a11y-panel__close-icon {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  /* ── Panel body ──────────────────────────────── */
  .a11y-panel__body {
    padding: 1.5rem;
    overflow-y: auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── Section group ───────────────────────────── */
  .a11y-group__title {
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #d6d3d1;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .a11y-group__title-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  /* ── Text-size button group ──────────────────── */
  .a11y-size-group {
    background-color: #292524;
    border-radius: 0.75rem;
    padding: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .a11y-size-btn {
    width: 100%;
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    color: #a8a29e;
    border-radius: 0.5rem;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.9375rem;
    font-family: var(--font-body-family, sans-serif);
    text-align: center;
    transition: background-color 0.15s ease, color 0.15s ease;
    line-height: 1;
  }

  .a11y-size-btn:hover {
    color: #ffffff;
  }

  .a11y-size-btn.is-active {
    background-color: #d97706;
    color: #ffffff;
  }

  .a11y-size-btn:focus-visible {
    outline: 2px solid #f59e0b;
    outline-offset: -2px;
  }

  /* ── Toggle row ──────────────────────────────── */
  .a11y-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    background-color: #292524;
    padding: 1.25rem;
    border-radius: 0.75rem;
    font-family: var(--font-body-family, sans-serif);
    font-weight: 700;
    font-size: 0.9375rem;
    transition: background-color 0.15s ease;
    user-select: none;
  }

  .a11y-toggle-row:hover {
    background-color: #44403c;
  }

  .a11y-toggle-row__label {
    flex-grow: 1;
    color: #ffffff;
  }

  /* ── Toggle switch (CSS-driven via :has) ─────── */
  .a11y-toggle-track {
    width: 3.5rem;
    height: 2rem;
    border-radius: 9999px;
    background-color: #57534e;
    position: relative;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  /* Native checkbox — visually hidden but accessible */
  .a11y-toggle-input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
    z-index: 1;
  }

  .a11y-toggle-knob {
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: #ffffff;
    transition: transform 0.2s ease;
    pointer-events: none;
  }

  /* Checked state via :has() — widely supported as of 2024 */
  .a11y-toggle-track:has(.a11y-toggle-input:checked) {
    background-color: #f59e0b;
  }

  .a11y-toggle-track:has(.a11y-toggle-input:checked) .a11y-toggle-knob {
    transform: translateX(1.5rem);
  }

  /* Fallback for browsers without :has() — controlled by JS class */
  .a11y-toggle-track.is-on {
    background-color: #f59e0b;
  }

  .a11y-toggle-track.is-on .a11y-toggle-knob {
    transform: translateX(1.5rem);
  }

  .a11y-toggle-input:focus-visible ~ .a11y-toggle-knob {
    outline: 2px solid #f59e0b;
    outline-offset: 3px;
  }

  /* ================================================
     Global accessibility effects (applied to <html>)
     ================================================ */

  /* ── Text size ───────────────────────────────── */
  html[data-a11y-text="small"]  { font-size: 87.5%; }
  html[data-a11y-text="large"]  { font-size: 112.5%; }

  /* ── High contrast ───────────────────────────── */
  html.a11y-high-contrast,
  html.a11y-high-contrast body {
    background-color: #ffffff;
    color: #000000;
  }

  /* Dark-background sections → white */
  html.a11y-high-contrast .hero-b2b,
  html.a11y-high-contrast .packages-ws,
  html.a11y-high-contrast .bottom-cta {
    background-color: #ffffff !important;
    color: #000000 !important;
  }

  html.a11y-high-contrast .hero-b2b        { border-bottom: 4px solid #000000 !important; }
  html.a11y-high-contrast .packages-ws     { border-top:    4px solid #000000 !important; }
  html.a11y-high-contrast .bottom-cta      { border-top:    4px solid #000000 !important; }
  html.a11y-high-contrast .trust-bar       { border-bottom: 4px solid #000000 !important; }
  html.a11y-high-contrast .cat-cards       { border-bottom: 4px solid #000000 !important; }

  /* All headings, text → black */
  html.a11y-high-contrast h1,
  html.a11y-high-contrast h2,
  html.a11y-high-contrast h3,
  html.a11y-high-contrast h4,
  html.a11y-high-contrast h5,
  html.a11y-high-contrast h6,
  html.a11y-high-contrast p,
  html.a11y-high-contrast li,
  html.a11y-high-contrast span,
  html.a11y-high-contrast label {
    color: #000000 !important;
  }

  /* Buttons → black bg, white text */
  html.a11y-high-contrast [class*="__btn"],
  html.a11y-high-contrast [class*="-btn"] {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
    box-shadow: none !important;
  }

  html.a11y-high-contrast [class*="__btn"]:hover,
  html.a11y-high-contrast [class*="-btn"]:hover {
    background-color: #292524 !important;
  }

  /* Cards → white with black border */
  html.a11y-high-contrast .cat-card,
  html.a11y-high-contrast .pkg-card {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
    box-shadow: none !important;
  }

  html.a11y-high-contrast .pkg-card--featured {
    border-width: 8px !important;
  }

  /* Icon circles */
  html.a11y-high-contrast .cat-card__media-wrap,
  html.a11y-high-contrast .trust-bar__icon-wrap {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
  }

  /* SVG icons */
  html.a11y-high-contrast svg {
    color: #000000 !important;
  }

  /* Package tags */
  html.a11y-high-contrast [class*="__tag"] {
    background-color: transparent !important;
    color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  /* Badge (orb) → hidden */
  html.a11y-high-contrast .hero-b2b__orb,
  html.a11y-high-contrast .editorial__shadow-decor {
    display: none !important;
  }

  /* ── Highlight links ─────────────────────────── */
  html.a11y-highlight-links a {
    text-decoration: underline !important;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    outline: 2px solid #f59e0b;
    outline-offset: 2px;
    border-radius: 2px;
  }

  html.a11y-highlight-links a:hover {
    outline-width: 3px;
  }
</style>

{%- comment -%}
  Trigger button — fixed bottom-right.
  Deduplication is handled in JS: only the first instance is kept.
{%- endcomment -%}
<button
  type="button"
  id="open-accessibility"
  class="a11y-trigger"
  aria-expanded="false"
  aria-controls="a11y-panel"
  aria-label="Open accessibility options"
>
  <svg class="a11y-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="8" r="3"/>
    <path d="M4 19c0-4 3.6-7 8-7s8 3 8 7"/>
    <path d="M9 13l3 4 3-4"/>
  </svg>
</button>

{%- comment -%} Click-outside backdrop {%- endcomment -%}
<div class="a11y-backdrop" id="a11y-backdrop" aria-hidden="true"></div>

{%- comment -%} Slide-in panel {%- endcomment -%}
<div
  class="a11y-panel"
  id="a11y-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Accessibility options"
  aria-hidden="true"
>

  <!-- ── Header ── -->
  <div class="a11y-panel__header">
    <h2 class="a11y-panel__title">
      <svg class="a11y-panel__title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="3"/>
        <path d="M4 19c0-4 3.6-7 8-7s8 3 8 7"/>
        <path d="M9 13l3 4 3-4"/>
      </svg>
      Accessibility
    </h2>
    <button
      type="button"
      class="a11y-panel__close"
      id="a11y-close"
      aria-label="Close accessibility panel"
    >
      <svg class="a11y-panel__close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- ── Body ── -->
  <div class="a11y-panel__body">

    <!-- Text Size -->
    <div class="a11y-group" id="a11y-group-size">
      <h3 class="a11y-group__title">
        <svg class="a11y-group__title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <polyline points="4 7 4 4 20 4 20 7"/>
          <line x1="9" y1="20" x2="15" y2="20"/>
          <line x1="12" y1="4" x2="12" y2="20"/>
        </svg>
        Text Size
      </h3>
      <div class="a11y-size-group" role="group" aria-label="Text size">
        <button type="button" class="a11y-size-btn" data-a11y-size="small"    aria-pressed="false">Small</button>
        <button type="button" class="a11y-size-btn" data-a11y-size="standard" aria-pressed="false">Standard</button>
        <button type="button" class="a11y-size-btn" data-a11y-size="large"    aria-pressed="false">Large</button>
      </div>
    </div>

    <!-- Contrast -->
    <div class="a11y-group">
      <h3 class="a11y-group__title">
        <svg class="a11y-group__title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 3v18"/>
          <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/>
        </svg>
        Contrast
      </h3>
      <label class="a11y-toggle-row">
        <span class="a11y-toggle-row__label">High Contrast (B/W)</span>
        <div class="a11y-toggle-track" id="a11y-contrast-track">
          <input
            type="checkbox"
            class="a11y-toggle-input"
            id="a11y-contrast"
            aria-label="High contrast mode"
          >
          <div class="a11y-toggle-knob" aria-hidden="true"></div>
        </div>
      </label>
    </div>

    <!-- Navigation / Links -->
    <div class="a11y-group">
      <h3 class="a11y-group__title">
        <svg class="a11y-group__title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        Navigation
      </h3>
      <label class="a11y-toggle-row">
        <span class="a11y-toggle-row__label">Highlight Links</span>
        <div class="a11y-toggle-track" id="a11y-links-track">
          <input
            type="checkbox"
            class="a11y-toggle-input"
            id="a11y-links"
            aria-label="Highlight all links"
          >
          <div class="a11y-toggle-knob" aria-hidden="true"></div>
        </div>
      </label>
    </div>

  </div>
</div>

<script>
(function () {
  'use strict';

  /* Guard: run only once even if snippet is rendered in multiple sections */
  if (window.lpA11yReady) return;
  window.lpA11yReady = true;

  var KEYS = {
    size:     'lp-a11y-size',
    contrast: 'lp-a11y-contrast',
    links:    'lp-a11y-links'
  };

  /* ── State helpers ───────────────────────────── */
  function load() {
    return {
      textSize:      localStorage.getItem(KEYS.size)     || 'standard',
      highContrast:  localStorage.getItem(KEYS.contrast) === 'true',
      highlightLinks:localStorage.getItem(KEYS.links)    === 'true'
    };
  }

  function applyTextSize(size) {
    document.documentElement.setAttribute('data-a11y-text', size);
    document.querySelectorAll('[data-a11y-size]').forEach(function (btn) {
      var active = btn.dataset.a11ySize === size;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  function applyContrast(on, track) {
    document.documentElement.classList.toggle('a11y-high-contrast', on);
    if (track) track.classList.toggle('is-on', on);  /* :has() fallback */
  }

  function applyLinks(on, track) {
    document.documentElement.classList.toggle('a11y-highlight-links', on);
    if (track) track.classList.toggle('is-on', on);
  }

  /* ── Panel open / close ──────────────────────── */
  function openPanel(panel, trigger, backdrop) {
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    if (backdrop) {
      backdrop.classList.add('is-visible');
      backdrop.removeAttribute('aria-hidden');
    }
    trigger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    var closeBtn = document.getElementById('a11y-close');
    if (closeBtn) {
      setTimeout(function () { closeBtn.focus(); }, 50);
    }
  }

  function closePanel(panel, trigger, backdrop) {
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    if (backdrop) {
      backdrop.classList.remove('is-visible');
      backdrop.setAttribute('aria-hidden', 'true');
    }
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    trigger.focus();
  }

  /* ── Focus trap ──────────────────────────────── */
  function trapFocus(panel, e) {
    if (e.key !== 'Tab') return;
    var focusable = Array.prototype.slice.call(
      panel.querySelectorAll('button:not([disabled]), input, [tabindex="0"]')
    );
    if (!focusable.length) return;
    var first = focusable[0];
    var last  = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  }

  /* ── Init ────────────────────────────────────── */
  function init() {
    /* Remove duplicate instances rendered by multiple sections */
    ['#open-accessibility', '#a11y-panel', '#a11y-backdrop'].forEach(function (sel) {
      var els = document.querySelectorAll(sel);
      for (var i = 1; i < els.length; i++) { els[i].remove(); }
    });

    var panel    = document.getElementById('a11y-panel');
    var trigger  = document.getElementById('open-accessibility');
    var closeBtn = document.getElementById('a11y-close');
    var backdrop = document.getElementById('a11y-backdrop');
    var contrastInput      = document.getElementById('a11y-contrast');
    var contrastTrack      = document.getElementById('a11y-contrast-track');
    var linksInput         = document.getElementById('a11y-links');
    var linksTrack         = document.getElementById('a11y-links-track');

    if (!panel || !trigger) return;

    /* Restore saved preferences immediately */
    var state = load();
    applyTextSize(state.textSize);
    applyContrast(state.highContrast, contrastTrack);
    applyLinks(state.highlightLinks, linksTrack);

    if (contrastInput) contrastInput.checked = state.highContrast;
    if (linksInput)    linksInput.checked    = state.highlightLinks;

    /* ── Trigger ── */
    trigger.addEventListener('click', function () {
      openPanel(panel, trigger, backdrop);
    });

    /* ── Close button ── */
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        closePanel(panel, trigger, backdrop);
      });
    }

    /* ── Backdrop ── */
    if (backdrop) {
      backdrop.addEventListener('click', function () {
        closePanel(panel, trigger, backdrop);
      });
    }

    /* ── Escape key ── */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        closePanel(panel, trigger, backdrop);
      }
    });

    /* ── Focus trap inside panel ── */
    panel.addEventListener('keydown', function (e) {
      if (panel.classList.contains('is-open')) trapFocus(panel, e);
    });

    /* ── Text size buttons ── */
    document.querySelectorAll('[data-a11y-size]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var size = btn.dataset.a11ySize;
        localStorage.setItem(KEYS.size, size);
        applyTextSize(size);
      });
    });

    /* ── Contrast toggle ── */
    if (contrastInput) {
      contrastInput.addEventListener('change', function () {
        var on = contrastInput.checked;
        localStorage.setItem(KEYS.contrast, on);
        applyContrast(on, contrastTrack);
      });
    }

    /* ── Links toggle ── */
    if (linksInput) {
      linksInput.addEventListener('change', function () {
        var on = linksInput.checked;
        localStorage.setItem(KEYS.links, on);
        applyLinks(on, linksTrack);
      });
    }
  }

  /* Run after DOM is ready */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
