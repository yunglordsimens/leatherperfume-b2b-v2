<style>
  /* ════════════════════════════════════════════════════════
     Password page — Leather Parfum B2B
     Self-contained. Renders via layout/password.liquid
     which provides CSS vars, fonts and Shopify scripts.
     ════════════════════════════════════════════════════════ */

  *, *::before, *::after { box-sizing: border-box; }

  body.password {
    margin: 0;
    padding: 0;
    background-color: #fafaf9;
    font-family: var(--font-body-family);
  }

  .pw {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Header ─────────────────────────────────────────────── */

  .pw-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    height: 5rem;
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 640px) {
    .pw-header { height: 6rem; padding: 0 2.5rem; }
  }

  html.a11y-high-contrast .pw-header {
    background-color: #ffffff;
    border-bottom: 4px solid #000000;
    position: fixed;
  }

  .pw-header__inner {
    width: 100%;
    max-width: 90rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pw-logo {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 1.5rem;
    color: #ffffff;
    text-decoration: none;
    mix-blend-mode: difference;
  }

  @media screen and (min-width: 640px) { .pw-logo { font-size: 1.875rem; } }

  html.a11y-high-contrast .pw-logo {
    color: #000000 !important;
    mix-blend-mode: normal !important;
  }

  .pw-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Language switcher */
  .pw-lang {
    display: none;
    position: relative;
  }

  @media screen and (min-width: 768px) { .pw-lang { display: block; } }

  .pw-lang__btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    mix-blend-mode: difference;
  }

  .pw-lang__btn svg { width: 1rem; height: 1rem; }

  html.a11y-high-contrast .pw-lang__btn {
    color: #000000 !important;
    mix-blend-mode: normal !important;
  }

  .pw-lang__menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 0.875rem;
    overflow: hidden;
    min-width: 9rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    z-index: 10;
  }

  .pw-lang:hover .pw-lang__menu { display: block; }

  html.a11y-high-contrast .pw-lang__menu {
    border: 2px solid #000000 !important;
  }

  .pw-lang__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #1c1917;
    background: none;
    border: none;
    width: 100%;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.1s;
  }

  .pw-lang__option:hover { background-color: #f5f5f4; }

  /* Accessibility button */
  .pw-a11y-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: rgba(255,255,255,0.1);
    border: none;
    cursor: pointer;
    color: #ffffff;
    mix-blend-mode: difference;
    transition: background-color 0.15s;
  }

  .pw-a11y-btn:hover { background: rgba(255,255,255,0.2); }
  .pw-a11y-btn svg { width: 1.5rem; height: 1.5rem; }

  html.a11y-high-contrast .pw-a11y-btn {
    color: #000000 !important;
    mix-blend-mode: normal !important;
    border: 2px solid #000000 !important;
    background: transparent !important;
  }

  /* ── Main split ─────────────────────────────────────────── */

  .pw-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 1024px) {
    .pw-main { flex-direction: row; min-height: 100vh; }
  }

  /* ── Left column — brand manifesto ─────────────────────── */

  .pw-left {
    width: 100%;
    padding: 8rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: #1c1917;
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 640px) { .pw-left { padding: 8rem 3rem 4rem; } }

  @media screen and (min-width: 1024px) {
    .pw-left { width: 50%; padding: 7rem 4rem 5rem; }
  }

  @media screen and (min-width: 1280px) { .pw-left { padding: 7rem 5rem 5rem; } }

  .pw-left::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -20%;
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(180,83,9,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  html.a11y-high-contrast .pw-left {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-right: 4px solid #000000;
  }

  html.a11y-high-contrast .pw-left::before { display: none; }

  .pw-left__inner {
    position: relative;
    z-index: 1;
    max-width: 36rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 1024px) { .pw-left__inner { margin: 0; } }

  /* Badge */
  .pw-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #f59e0b;
    background-color: #292524;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
  }

  .pw-badge svg { width: 0.875rem; height: 0.875rem; fill: currentColor; }

  html.a11y-high-contrast .pw-badge {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  /* Manifesto heading */
  .pw-left__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 1.75rem;
  }

  html.a11y-high-contrast .pw-left__heading { color: #000000 !important; }

  .pw-left__desc {
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #a8a29e;
    margin: 0 0 2.5rem;
  }

  html.a11y-high-contrast .pw-left__desc {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  /* Early access card */
  .pw-early {
    background-color: #292524;
    border: 1px solid #44403c;
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  html.a11y-high-contrast .pw-early {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
  }

  .pw-early__title {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e7e5e4;
    margin: 0 0 0.5rem;
  }

  html.a11y-high-contrast .pw-early__title { color: #000000 !important; }

  .pw-early__desc {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #a8a29e;
    margin: 0 0 1.25rem;
  }

  html.a11y-high-contrast .pw-early__desc { color: #000000 !important; }

  .pw-early__form {
    display: flex;
    gap: 0.5rem;
  }

  .pw-early__input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    background-color: #1c1917;
    border: 1px solid #57534e;
    border-radius: 0.75rem;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }

  .pw-early__input::placeholder { color: #78716c; }
  .pw-early__input:focus { border-color: #d97706; }

  html.a11y-high-contrast .pw-early__input {
    background-color: #ffffff !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  .pw-early__btn {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    background-color: #b45309;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }

  .pw-early__btn:hover { background-color: #92400e; }

  html.a11y-high-contrast .pw-early__btn {
    background-color: #000000 !important;
    border: 2px solid #000000 !important;
  }

  .pw-early__success {
    display: none;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    background-color: rgba(21,128,61,0.2);
    border: 1px solid #166534;
    border-radius: 0.75rem;
    color: #86efac;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .pw-early__success.is-visible { display: flex; }

  html.a11y-high-contrast .pw-early__success {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }

  /* ── Right column — password form ──────────────────────── */

  .pw-right {
    width: 100%;
    padding: 4rem 1.5rem 5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #fafaf9;
  }

  @media screen and (min-width: 640px) { .pw-right { padding: 4rem 3rem 5rem; } }

  @media screen and (min-width: 1024px) {
    .pw-right { width: 50%; padding: 5rem 4rem; min-height: 100vh; }
  }

  @media screen and (min-width: 1280px) { .pw-right { padding: 5rem; } }

  html.a11y-high-contrast .pw-right { background-color: #ffffff !important; }

  .pw-right__inner {
    width: 100%;
    max-width: 26rem;
  }

  /* Lock icon box */
  .pw-lock {
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    color: #78716c;
    transition: color 0.3s, background-color 0.3s, border-color 0.3s;
  }

  @media screen and (min-width: 1024px) { .pw-lock { margin-left: 0; } }
  .pw-lock svg { width: 2rem; height: 2rem; }

  html.a11y-high-contrast .pw-lock {
    border: 4px solid #000000 !important;
    box-shadow: none !important;
    color: #000000 !important;
  }

  /* Headings */
  .pw-right__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2rem, 5vw, 2.75rem);
    color: #1c1917;
    line-height: 1.15;
    margin: 0 0 0.875rem;
    text-align: center;
  }

  @media screen and (min-width: 1024px) { .pw-right__heading { text-align: left; } }

  html.a11y-high-contrast .pw-right__heading { color: #000000 !important; }

  .pw-right__sub {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.65;
    color: #78716c;
    margin: 0 0 2.5rem;
    text-align: center;
  }

  @media screen and (min-width: 1024px) { .pw-right__sub { text-align: left; } }

  html.a11y-high-contrast .pw-right__sub {
    color: #000000 !important;
    font-weight: 500 !important;
  }

  /* Error banner */
  .pw-error {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 0.875rem;
    color: #991b1b;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .pw-error svg { width: 1.25rem; height: 1.25rem; flex-shrink: 0; margin-top: 0.0625rem; }

  html.a11y-high-contrast .pw-error {
    background-color: #ffffff !important;
    border: 4px solid #000000 !important;
    color: #000000 !important;
  }

  /* Password field */
  .pw-field { margin-bottom: 1.5rem; }

  .pw-label {
    display: block;
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #44403c;
    margin-bottom: 0.75rem;
  }

  html.a11y-high-contrast .pw-label { color: #000000 !important; }

  .pw-input-wrap { position: relative; }

  .pw-input-icon {
    position: absolute;
    top: 0; bottom: 0; left: 1.125rem;
    display: flex;
    align-items: center;
    pointer-events: none;
    color: #a8a29e;
  }

  .pw-input-icon svg { width: 1.125rem; height: 1.125rem; }

  .pw-input {
    width: 100%;
    padding: 1rem 3.25rem;
    font-family: monospace;
    font-size: 1.375rem;
    letter-spacing: 0.2em;
    color: #1c1917;
    background-color: #ffffff;
    border: 1.5px solid #d6d3d1;
    border-radius: 0.875rem;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
    text-align: center;
  }

  .pw-input:focus {
    border-color: #b45309;
    box-shadow: 0 0 0 3px rgba(180,83,9,0.15);
  }

  html.a11y-high-contrast .pw-input {
    border: 2px solid #000000 !important;
    background-color: #ffffff !important;
    color: #000000 !important;
  }

  .pw-toggle {
    position: absolute;
    top: 0; bottom: 0; right: 1.125rem;
    display: flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    color: #a8a29e;
    padding: 0;
    transition: color 0.15s;
  }

  .pw-toggle:hover { color: #57534e; }
  .pw-toggle svg { width: 1.125rem; height: 1.125rem; }

  /* Submit button */
  .pw-submit {
    width: 100%;
    padding: 1.125rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ffffff;
    background-color: #1c1917;
    border: 2px solid #1c1917;
    border-radius: 0.875rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
    margin-top: 0.5rem;
  }

  .pw-submit:hover { background-color: #b45309; border-color: #b45309; }
  .pw-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .pw-submit svg { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }

  html.a11y-high-contrast .pw-submit {
    background-color: #000000 !important;
    border-color: #000000 !important;
    color: #ffffff !important;
  }

  .pw-spinner {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: pwSpin 0.7s linear infinite;
    flex-shrink: 0;
  }

  @keyframes pwSpin { to { transform: rotate(360deg); } }

  .pw-submit.is-loading .pw-spinner { display: block; }
  .pw-submit.is-loading .pw-submit-label,
  .pw-submit.is-loading .pw-submit-arrow { display: none; }

  /* Contact link */
  .pw-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a8a29e;
    text-decoration: none;
    transition: color 0.15s;
  }

  @media screen and (min-width: 1024px) { .pw-contact { justify-content: flex-start; } }

  .pw-contact:hover { color: #b45309; }
  .pw-contact svg { width: 1rem; height: 1rem; flex-shrink: 0; }
  html.a11y-high-contrast .pw-contact { color: #000000 !important; }
</style>

<div class="pw" id="MainContent">

  {%- comment -%} ── Header ── {%- endcomment -%}
  <header class="pw-header" role="banner">
    <div class="pw-header__inner">

      <a href="{{ routes.root_url }}" class="pw-logo">{{ shop.name }}</a>

      <div class="pw-header__actions">

        {%- comment -%} Language switcher (decorative) {%- endcomment -%}
        <div class="pw-lang">
          <button class="pw-lang__btn" type="button" aria-haspopup="listbox" aria-expanded="false">
            <span style="font-size:1.125rem;line-height:1" aria-hidden="true">🇬🇧</span>
            EN
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pw-lang__menu" role="listbox">
            <button class="pw-lang__option" type="button" role="option">English <span aria-hidden="true">🇬🇧</span></button>
            <button class="pw-lang__option" type="button" role="option">Čeština <span aria-hidden="true">🇨🇿</span></button>
            <button class="pw-lang__option" type="button" role="option">Tiếng Việt <span aria-hidden="true">🇻🇳</span></button>
          </div>
        </div>

        {%- comment -%} Accessibility button (panel not included per design) {%- endcomment -%}
        <button class="pw-a11y-btn" type="button" id="open-accessibility" aria-label="Accessibility options">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="16" cy="4" r="1"/>
            <path d="m18 19 1-7-6 1"/>
            <path d="m5 8 3-3 5.5 3-2.36 3.5"/>
            <path d="M4.24 14.5a5 5 0 0 0 6.88 6"/>
            <path d="M13.76 17.5a5 5 0 0 0-6.88-6"/>
          </svg>
        </button>

      </div>
    </div>
  </header>

  {%- comment -%} ── Main split screen ── {%- endcomment -%}
  <main class="pw-main">

    {%- comment -%} LEFT: Brand manifesto {%- endcomment -%}
    <div class="pw-left">
      <div class="pw-left__inner">

        <div class="pw-badge" aria-label="B2B Portal">
          <svg aria-hidden="true" viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>
          B2B Portal
        </div>

        <h2 class="pw-left__heading">Our wholesale portal is currently restricted.</h2>

        <p class="pw-left__desc">Leather Parfum is a private B2B platform tailored for premium boutiques and concept stores. We are preparing new collections and updating wholesale pricing.</p>

        <div class="pw-early">
          <h3 class="pw-early__title">Want early access?</h3>
          <p class="pw-early__desc">Leave your email to be notified when we accept new partnership applications.</p>

          <div class="pw-early__success" id="EarlySuccess" role="status" aria-live="polite">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:1.125rem;height:1.125rem;flex-shrink:0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Email received! We'll be in touch.
          </div>

          <form class="pw-early__form" id="EarlyForm" novalidate>
            <input
              class="pw-early__input"
              type="email"
              placeholder="boutique@email.com"
              autocomplete="email"
              required
              aria-label="Email address for early access"
            >
            <button class="pw-early__btn" type="submit">Notify</button>
          </form>
        </div>

      </div>
    </div>

    {%- comment -%} RIGHT: Password form {%- endcomment -%}
    <div class="pw-right">
      <div class="pw-right__inner">

        <div class="pw-lock" id="PwLockWrap" aria-hidden="true">
          <svg id="PwLockIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>

        <h1 class="pw-right__heading">Enter Password</h1>
        <p class="pw-right__sub">If you are an existing partner or have received an access code, enter it below.</p>

        {%- form 'storefront_password' -%}

          {%- if form.errors -%}
            <div class="pw-error" role="alert">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              Incorrect password. Please try again.
            </div>
          {%- endif -%}

          <div class="pw-field">
            <label class="pw-label" for="Password">Store Password</label>
            <div class="pw-input-wrap">
              <span class="pw-input-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <input
                class="pw-input"
                type="password"
                id="Password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
                autofocus
              >
              <button
                class="pw-toggle"
                type="button"
                id="PwToggle"
                aria-label="Show password"
                aria-controls="Password"
              >
                <svg id="PwEyeShow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg id="PwEyeHide" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <button class="pw-submit" type="submit" id="PwSubmit">
            <div class="pw-spinner" aria-hidden="true"></div>
            <span class="pw-submit-label">Enter Store</span>
            <svg class="pw-submit-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>

        {%- endform -%}

        <a href="mailto:b2b@leatherparfum.com" class="pw-contact">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Contact Administrator
        </a>

      </div>
    </div>

  </main>
</div>

<script>
(function () {
  if (window.lpPwReady) return;
  window.lpPwReady = true;

  /* ── Show / hide password ── */
  var pwInput  = document.getElementById('Password');
  var pwToggle = document.getElementById('PwToggle');
  var eyeShow  = document.getElementById('PwEyeShow');
  var eyeHide  = document.getElementById('PwEyeHide');

  if (pwToggle && pwInput) {
    pwToggle.addEventListener('click', function () {
      var hidden = pwInput.type === 'password';
      pwInput.type = hidden ? 'text' : 'password';
      pwToggle.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
      if (eyeShow) eyeShow.style.display = hidden ? 'none' : '';
      if (eyeHide) eyeHide.style.display = hidden ? ''     : 'none';
      pwInput.focus();
    });
  }

  /* ── Submit loading state ── */
  var pwForm   = document.querySelector('[action="/password"]');
  var pwSubmit = document.getElementById('PwSubmit');

  if (pwForm && pwSubmit) {
    pwForm.addEventListener('submit', function () {
      if (!pwInput || pwInput.value.trim() === '') return;
      pwSubmit.disabled = true;
      pwSubmit.classList.add('is-loading');
    });
  }

  /* ── Early access form (decorative) ── */
  var earlyForm    = document.getElementById('EarlyForm');
  var earlySuccess = document.getElementById('EarlySuccess');

  if (earlyForm && earlySuccess) {
    earlyForm.addEventListener('submit', function (e) {
      e.preventDefault();
      earlyForm.style.display = 'none';
      earlySuccess.classList.add('is-visible');
    });
  }
})();
</script>
